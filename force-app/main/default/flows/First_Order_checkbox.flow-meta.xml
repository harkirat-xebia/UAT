<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>64.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <constants>
        <name>Active</name>
        <dataType>String</dataType>
        <value>
            <stringValue>Active</stringValue>
        </value>
    </constants>
    <decisions>
        <name>Check_If_Time_Gap_13_Months</name>
        <label>Check If Time Gap &gt; 13 Months</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Set_Checkbox_FALSE</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Is_gap_13_months</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>IsGapOver13Months</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Previous_Active_Solutions</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>firstorderdateequalstofirstorderdatecompany</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Checkbox_TRUE</targetReference>
            </connector>
            <label>Is gap &gt; 13 months</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>firstorderdateequalstofirstorderdatecompany</name>
        <dataType>Boolean</dataType>
        <expression>$Record.First_Order_Date__c = $Record.First_Order_Date_Company__c</expression>
    </formulas>
    <formulas>
        <name>IsGapOver13Months</name>
        <dataType>Boolean</dataType>
        <expression>$Record.First_Order_Date__c &gt; ({!Get_Previous_Active_Solutions.Last_Order_Date__c} + 395)</expression>
    </formulas>
    <interviewLabel>First Order checkbox {!$Flow.CurrentDateTime}</interviewLabel>
    <label>First Order checkbox</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Previous_Active_Solutions</name>
        <label>Get Previous Active Solutions</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Check_If_Time_Gap_13_Months</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>ER_Account__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.ER_Account__r.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>ER_Solution__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.ER_Solution__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>ER_Global_Status__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <elementReference>Active</elementReference>
            </value>
        </filters>
        <filters>
            <field>Last_Order_Date__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>ER_Solution_Line_Item__c</object>
        <sortField>Last_Order_Date__c</sortField>
        <sortOrder>Desc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Set_Checkbox_FALSE</name>
        <label>Set Checkbox FALSE</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>First_Order_all_time__c</field>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>Set_Checkbox_TRUE</name>
        <label>Set Checkbox TRUE</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>First_Order_all_time__c</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Previous_Active_Solutions</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>ER_Global_Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Active</stringValue>
            </value>
        </filters>
        <filters>
            <field>First_Order_Date__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>ER_Solution_Line_Item__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
