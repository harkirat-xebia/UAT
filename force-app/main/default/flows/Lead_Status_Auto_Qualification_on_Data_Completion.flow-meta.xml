<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <environments>Default</environments>
    <interviewLabel>Lead: Auto-Qualify on Data Completion {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Lead Status: Auto-Qualification on Data Completion</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Set_Status_to_Qualification</name>
        <label>Set Status to Qualification²</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>Status</field>
            <value>
                <stringValue>Qualification</stringValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Set_Status_to_Qualification</targetReference>
        </connector>
        <filterFormula>AND(
  OR(
    ISPICKVAL({!$Record.Status}, &quot;New&quot;),
    ISPICKVAL({!$Record.Status}, &quot;Workable&quot;)
  ),
  NOT(ISBLANK({!$Record.ER_Registration_Number__c})),
  NOT(ISBLANK({!$Record.NumberOfEmployees})),
  NOT(ISBLANK({!$Record.ERBE_Initial_Product_Of_Interest__c})),
  OR(
    NOT(ISBLANK({!$Record.Email})),
    NOT(ISBLANK({!$Record.Phone}))
  ),
  OR(
    {!$Record.NumberOfEmployees} &lt;= 29,
    AND(
      {!$Record.NumberOfEmployees} &gt; 29,
      NOT(ISBLANK({!$Record.PostalCode}))
    )
  ),
  NOT(ISPICKVAL({!$Record.LeadSource}, &quot;Websales&quot;))
)</filterFormula>
        <object>Lead</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Obsolete</status>
    <triggerOrder>400</triggerOrder>
</Flow>
