    <formulas>
        <name>USER_DEACTIVATION_DATE</name>
        <dataType>Date</dataType>
        <expression>IF( ISBLANK({!$Record.LastLoginDate} ), {!$Record.CreatedDate} + VALUE({!USER_DEACTIVATION_NUMBER_OFFSET}), {!$Record.LastLoginDate} + VALUE({!USER_DEACTIVATION_NUMBER_OFFSET}))</expression>
