<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>52.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Fill_In_Subscription_Rate_Plan_Solution</name>
        <label>Fill In Subscription Rate Plan Solution</label>
        <locationX>1075</locationX>
        <locationY>117</locationY>
        <assignmentItems>
            <assignToReference>$Record.ER_Solution__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>selectedProdcutRatePlan.zqu__Product__c</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>User_Bypassing_Flows</name>
        <label>User Bypassing Flows</label>
        <locationX>522</locationX>
        <locationY>123</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>IsNotFlowBypassed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$User.ER_Bypass_Flows__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Product_Rate_Plan</targetReference>
            </connector>
            <label>IsNotFlowBypassed</label>
        </rules>
    </decisions>
    <description>This flow populate the solution field on the subscription rate plan from the related product rate plan</description>
    <interviewLabel>Zuora - Subscription Rate Plan Solution {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Zuora - Subscription Rate Plan Solution</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>FREE_FORM_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Product_Rate_Plan</name>
        <label>Get Product Rate Plan</label>
        <locationX>807</locationX>
        <locationY>117</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Fill_In_Subscription_Rate_Plan_Solution</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>zqu__ZuoraId__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Zuora__OriginalProductRatePlanId__c</elementReference>
            </value>
        </filters>
        <object>zqu__ProductRatePlan__c</object>
        <outputReference>selectedProdcutRatePlan</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>zqu__Product__c</queriedFields>
    </recordLookups>
    <start>
        <locationX>50</locationX>
        <locationY>50</locationY>
        <connector>
            <targetReference>User_Bypassing_Flows</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Zuora__OriginalProductRatePlanId__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>Zuora__SubscriptionRatePlan__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>selectedProdcutRatePlan</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>true</isOutput>
        <objectType>zqu__ProductRatePlan__c</objectType>
    </variables>
</Flow>
