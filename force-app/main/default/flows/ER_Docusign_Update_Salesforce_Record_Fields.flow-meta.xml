    <decisions>
        <name>Check_Docusign_Status</name>
        <label>Check Docusign Status</label>
        <locationX>1356</locationX>
        <locationY>323</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Is_Sent</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.dfsle__Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Sent</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Quote_Status_To_Presented</targetReference>
            </connector>
            <label>Is Sent</label>
        </rules>
        <rules>
            <name>Is_Declined_Or_Voided</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.dfsle__Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Declined</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.dfsle__Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Voided</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Quote_Status_To_Denied</targetReference>
            </connector>
            <label>Is Declined Or Voided</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Docusign_Status_for_Zuora_Quote</name>
        <label>Check Docusign Status for Zuora Quote</label>
        <locationX>790</locationX>
        <locationY>522</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Is_Sent_ZQuote</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.dfsle__Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Sent</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_ZQuote_Status_as_Presented</targetReference>
            </connector>
            <label>Is Sent ZQuote</label>
        </rules>
        <rules>
            <name>Is_Declined_ZQuote</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.dfsle__Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Declined</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.dfsle__Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Voided</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_ZQuote_Status_to_declined</targetReference>
            </connector>
            <label>Is Declined ZQuote</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Salesforce_Id_Prefix</name>
        <label>Check Salesforce Id Prefix</label>
        <locationX>1092</locationX>
        <locationY>134</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Is_Quote_0Q0</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.dfsle__SourceId__c</leftValueReference>
                <operator>StartsWith</operator>
                <rightValue>
                    <stringValue>0Q0</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.dfsle__Status__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Completed</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Quote</targetReference>
            </connector>
            <label>Is Quote 0Q0</label>
        </rules>
        <rules>
            <name>Is_Zuora_Quote</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.dfsle__SourceId__c</leftValueReference>
                <operator>StartsWith</operator>
                <rightValue>
                    <elementReference>ZuoraQuoteIdPrefix</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.dfsle__Status__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Completed</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Zuora_Quote</targetReference>
            </connector>
            <label>Is Zuora Quote</label>
        </rules>
    </decisions>
    <decisions>
        <name>User_Bypassing_Flows</name>
        <label>User Bypassing Flows ?</label>
        <locationX>587</locationX>
        <locationY>119</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>IsNotFlowBypassed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$User.ER_Bypass_Flows__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>GetZuoraQuotePrefix</targetReference>
            </connector>
            <label>IsNotFlowBypassed</label>
        </rules>
    </decisions>
