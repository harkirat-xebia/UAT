        <label>Insert/Update Decision</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>On_Insert</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record__Prior.ER_Face_Value_Editable__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.ER_Nb_Beneficiaries_Editable__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.ER_Days_Per_Month_Editable__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.ER_Load_Per_Year_Editable__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_New_Inserted_Record</targetReference>
            </connector>
            <label>On Insert</label>
        </rules>
        <rules>
            <name>On_Update</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.ER_Face_Value_Editable__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.ER_Days_Per_Month_Editable__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.ER_Load_Per_Year_Editable__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.ER_Nb_Beneficiaries_Editable__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Triggering_Record</targetReference>
            </connector>
            <label>On Update</label>
        </rules>
    </decisions>
    <description>Updates the Field - Estimated_Value__c and Total_Price__c if any field used in its formula is edited</description>
    <environments>Default</environments>
    <formulas>
        <name>daysPerMonthFormula</name>
        <dataType>Number</dataType>
        <expression>IF(
ISBLANK( {!$Record.Opportunity_Product__c}),
  {!$Record.ER_Product2__r.ER_Solution2__r.Days_per_Month__c},
{!$Record.Opportunity_Product__r.ER_Days_Per_Month__c}
)</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>faceValueFormula</name>
