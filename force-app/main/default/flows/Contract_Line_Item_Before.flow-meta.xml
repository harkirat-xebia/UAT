        <expression>IF(
ISBLANK( {!$Record.Opportunity_Product__c}),
  {!$Record.ER_Product2__r.ER_Solution2__r.Face_Value__c},
{!$Record.Opportunity_Product__r.ER_Face_Value__c}
)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>loadPerYearFormula</name>
