ISBLANK( {!$Record.Opportunity_Product__c}),
  {!$Record.ER_Product2__r.ER_Solution2__r.No_Of_Beneficiaries__c},
{!$Record.Opportunity_Product__r.ER_Nb_Beneficiaries__c}
)</expression>
