    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>New</targetReference>
        </connector>
        <filterFormula>AND(
  OR(
    ISPICKVAL({!$Record.Status}, &quot;New&quot;),
    ISPICKVAL({!$Record.Status}, &quot;Workable&quot;)
  ),
  NOT(ISBLANK({!$Record.ER_Registration_Number__c})),
  NOT(ISBLANK({!$Record.NumberOfEmployees})),
  NOT(ISBLANK({!$Record.ERBE_Initial_Product_Of_Interest__c})),

  OR(
    NOT(ISBLANK({!$Record.Email})),
    NOT(ISBLANK({!$Record.Phone}))
  ),
  OR(
    {!$Record.NumberOfEmployees} &lt;= 29,
    AND(
      {!$Record.NumberOfEmployees} &gt; 29,
      NOT(ISBLANK({!$Record.PostalCode}))
    )
  ),
  NOT(ISPICKVAL({!$Record.LeadSource}, &quot;Websales&quot;)),
  NOT(ISPICKVAL({!$Record.LeadSource}, &quot;Outbound call&quot;))
)</filterFormula>
        <object>Lead</object>
