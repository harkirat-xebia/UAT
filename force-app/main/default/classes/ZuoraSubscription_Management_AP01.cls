public class ZuoraSubscription_Management_AP01 {
  /**
   * @author AAZ
   * @date 28/07/2021
   * @description Clone master Subscription for child Billing Accounts having no sub
   * @param newSubPCs
   */
  public static void cloneMasterSub(List<Zuora__SubscriptionProductCharge__c> newSubPCs) {
    //if(UtilsBypass.canTrigger('createChildSubscription')) {
    Map<Id, Zuora__SubscriptionProductCharge__c> SubPCMap = new Map<Id, Zuora__SubscriptionProductCharge__c>(newSubPCs);
    Set<Id> setAccountIds = new Set<Id>();
    Set<Id> setSubIds = new Set<Id>();

    System.debug('>>>>> AAZ - ZuoraSubscription_Management_AP01 cloneMasterSub newSubPCs: ' + newSubPCs);

    for (Zuora__SubscriptionProductCharge__c subPC : [
      SELECT Id, Zuora__Account__c, Zuora__Subscription__c, Zuora__Subscription__r.Zuora__QuoteType__c
      FROM Zuora__SubscriptionProductCharge__c
      WHERE
        Id IN :SubPCMap.keySet()
        AND Zuora__Subscription__r.Zuora__Status__c = :Constants.ACTIVE
        AND Zuora__Subscription__r.Zuora__CustomerAccount__r.ER_Master__c = TRUE
    ]) {
      setAccountIds.add(subPC.Zuora__Account__c);
      setSubIds.add(subPC.Zuora__Subscription__c);
    }

    if (!setAccountIds.isEmpty() && !setSubIds.isEmpty()) {
      Map<Id, List<Zuora__CustomerAccount__c>> mapAccountIdBillingAccount = new Map<Id, List<Zuora__CustomerAccount__c>>();

      for (Zuora__CustomerAccount__c ba : [
        SELECT
          Id,
          Zuora__Account__c,
          ER_Master__c,
          ER_Financial_Center__r.ER_Type__c,
          Zuora__AccountNumber__c,
          ER_Financial_Center__r.ER_Business_Unit__c
        FROM Zuora__CustomerAccount__c
        WHERE Zuora__Account__c IN :setAccountIds AND ER_Master__c = FALSE
      ]) {
        if (!mapAccountIdBillingAccount.containsKey(ba.Zuora__Account__c))
          mapAccountIdBillingAccount.put(ba.Zuora__Account__c, new List<Zuora__CustomerAccount__c>());
        mapAccountIdBillingAccount.get(ba.Zuora__Account__c).add(ba);
      }

      System.debug(
        '>>>>> AAZ - ZuoraSubscription_Management_AP01 cloneMasterSub mapAccountIdBillingAccount: ' +
        mapAccountIdBillingAccount
      );

      if (!mapAccountIdBillingAccount.isEmpty())
        createChildSubsforBillingAccount(mapAccountIdBillingAccount, setSubIds);
    }
    //}
  }

  /**
   * @author AAZ
   * @date 28/07/2021
   * @description Create Child Subs for Billing Account
   * @param mapAccountIdBillingAccounts
   * @param setSubIds
   */
  public static void createChildSubsforBillingAccount(
    Map<Id, List<Zuora__CustomerAccount__c>> mapAccountIdBillingAccounts,
    Set<Id> setSubIds
  ) {
    System.debug(
      '>>>>> AAZ - ZuoraSubscription_Management_AP01 createChildSubforBillingAccount mapAccountIdBillingAccounts: ' +
      mapAccountIdBillingAccounts
    );

    Map<Id, List<Zuora__Subscription__c>> mapAccountIdMasterSubscriptions = new Map<Id, List<Zuora__Subscription__c>>();

    for (Zuora__Subscription__c sub : [
      SELECT
        Id,
        Name,
        Zuora__Account__c,
        Zuora__CustomerAccount__r.Zuora__Zuora_Id__c,
        Zuora__Status__c,
        Zuora__CustomerAccount__r.ER_Financial_Center__r.ER_Type__c,
        Zuora__TermSettingType__c,
        Zuora__SubscriptionEndDate__c,
        Zuora__InitialTermPeriodType__c,
        Zuora__SubscriptionStartDate__c,
        Zuora__QuoteType__c,
        Zuora__ContractEffectiveDate__c,
        Zuora__ContractAcceptanceDate__c,
        Zuora__ServiceActivationDate__c,
        (
          SELECT
            Zuora__External_Id__c,
            ER_Solution__c,
            ER_Solution__r.zqu__Category__c,
            Zuora__OriginalProductRatePlanId__c
          FROM Zuora__Subscription_Rate_Plans__r
          WHERE ER_Solution__r.zqu__Category__c = :Constants.SOLUTION_BASE_PRODUCTS
        )
      FROM Zuora__Subscription__c
      WHERE Id IN :setSubIds
    ]) {
      if (!mapAccountIdMasterSubscriptions.containsKey(sub.Zuora__Account__c))
        mapAccountIdMasterSubscriptions.put(sub.Zuora__Account__c, new List<Zuora__Subscription__c>());
      mapAccountIdMasterSubscriptions.get(sub.Zuora__Account__c).add(sub);
    }

    System.debug(
      '>>>>> AAZ - ZuoraSubscription_Management_AP01 createChildSubforBillingAccount mapAccountIdMasterSubscriptions: ' +
      mapAccountIdMasterSubscriptions
    );

    if (!mapAccountIdMasterSubscriptions.isEmpty()) {
      System.enqueueJob(
        new ER_CreateChildSubforBillingAccount(mapAccountIdBillingAccounts, mapAccountIdMasterSubscriptions)
      );
    }
  }

  /**
   * @author Noor
   * @date 16/09/2021
   * @description Each time a subscription is created, we loop on the Quote and linked the attached subscription to the contract
   *              We use Zuora__External_Id__c since it is unique even when contract is amended
   * @param oldItems
   * @param newItems
   */
  public static void updateContractSubscription(
    Map<Id, Zuora__Subscription__c> newItems,
    Map<Id, Zuora__Subscription__c> oldItems
  ) {
    Map<String, Id> subscriptionNameIdsMap = new Map<String, Id>();
    List<Contract> contracts = new List<Contract>();

    for (Zuora__Subscription__c subs : newItems.values())
      subscriptionNameIdsMap.put(subs.Name, subs.Id);
    System.debug('//NGO updateContractSubscription subscriptionNameIdsMap ' + subscriptionNameIdsMap);

    for (zqu__Quote__c q : [
      SELECT
        Id,
        zqu__Opportunity__r.ER_IsAmended__c,
        ER_Contract__r.ER_OpportunityId__r.ER_AmendedFromContract__r.ContractNumber,
        ER_Contract__c,
        ER_Contract__r.ContractNumber,
        zqu__Subscription_Name__c
      FROM zqu__Quote__c
      WHERE zqu__Subscription_Name__c IN :subscriptionNameIdsMap.keySet() AND ER_Contract__c != NULL
      ORDER BY ER_Contract__r.ContractNumber DESC
    ]) {
      System.debug('//NGO updateContractSubscription zquote ' + q);
      contracts.add(
        new Contract(Id = q.ER_Contract__c, Subscription__c = subscriptionNameIdsMap.get(q.zqu__Subscription_Name__c))
      );
    }

    System.debug('//NGO updateContractSubscription contracts ' + contracts);
    if (!contracts.isEmpty())
      update contracts;
  }

  /**
   * @author AAZ
   * @date 02/12/2021
   * @description Each time a Child Subscription is synced, the Lookup "ER_Contract__c" has to be populated with the contractId
   *              from the Parent Subscription.
   * @param newItems
   */
  public static void setContractIdOnChildSubscription(List<Zuora__Subscription__c> newItems) {
    Map<String, List<Id>> mapMasterChildSubs = new Map<String, List<Id>>();
    Map<Id, Zuora__Subscription__c> mapSubsToBeUpdated = new Map<Id, Zuora__Subscription__c>();

    for (Zuora__Subscription__c sub : newItems) {
      if (sub.ER_Master__c == Constants.YES) {
        if (!mapMasterChildSubs.containsKey(sub.Name))
          mapMasterChildSubs.put(sub.Name, new List<Id>());
      } else {
        if (!mapMasterChildSubs.containsKey(sub.ER_Parent_Subscription__c))
          mapMasterChildSubs.put(sub.ER_Parent_Subscription__c, new List<Id>());
        mapMasterChildSubs.get(sub.ER_Parent_Subscription__c).add(sub.Id);
      }
    }

    for (Zuora__Subscription__c sub : [
      SELECT Id, ER_Parent_Subscription__c
      FROM Zuora__Subscription__c
      WHERE ER_Parent_Subscription__c IN :mapMasterChildSubs.keySet() AND ER_Master__c = :Constants.NO
    ]) {
      mapMasterChildSubs.get(sub.ER_Parent_Subscription__c).add(sub.Id);
    }

    for (Zuora__Subscription__c sub : [
      SELECT Id, Name, (SELECT Id FROM Contracts__r)
      FROM Zuora__Subscription__c
      WHERE Name IN :mapMasterChildSubs.keySet()
    ]) {
      if (mapMasterChildSubs.get(sub.Name).size() == 0 && !sub.Contracts__r.isEmpty())
        mapSubsToBeUpdated.put(
          sub.Id,
          new Zuora__Subscription__c(Id = sub.Id, ER_Contract__c = sub.Contracts__r[0].Id)
        );
      else {
        for (Id subId : mapMasterChildSubs.get(sub.Name)) {
          //mapSubsToBeUpdated.put(sub.Id, new Zuora__Subscription__c(Id = sub.Id, ER_Contract__c = null));
          mapSubsToBeUpdated.put(
            subId,
            new Zuora__Subscription__c(Id = subId, ER_Contract__c = sub.Contracts__r[0].Id)
          );
        }
      }
    }

    if (!mapSubsToBeUpdated.isEmpty())
      update mapSubsToBeUpdated.values();
  }

