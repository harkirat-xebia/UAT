						<table align="center" border="0" cellpadding="0" cellspacing="0" width="100%">
							<tbody>
								<tr>
									<td class="fz-p ta-c pad-0-20-20-20" style="font-family: 'Ubuntu', Arial, sans-serif; line-height: 18px; color: #000000; font-size: 15px;font-weight: 400; text-align: left;padding:0 40px 20px 70px;">You will be <strong>welcome everywhere</strong>: the Edenred card is accepted in many (many!) more shops.</td>
								</tr>
							</tbody>
						</table>
						</th>
					</tr>
