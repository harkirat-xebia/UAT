						<table align="center" border="0" cellpadding="0" cellspacing="0" width="100%">
							<tbody>
								<tr>
									<td class="fz-p ta-c pad-0-20-20-20" style="font-family: 'Ubuntu', Arial, sans-serif; line-height: 18px; color: #000000; font-size: 15px;font-weight: 400; text-align: left;padding:0 40px 20px 70px;">You will have the best card on the market: the only one equipped with <strong>Mastercard technology</strong>, allowing you to pay contactlessly, via smartphone, online, etc.</td>
								</tr>
							</tbody>
						</table>
						</th>
					</tr>
				</tbody>
			</table>

