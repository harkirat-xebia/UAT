					<tr>
						<td style="padding: 30px 40px 0px; font-family: 'Ubuntu', Arial, sans-serif; font-size: 15px; line-height: 140%; color: #000000;">
						<p style="margin: 0;">As the manager of your file, I am at your entire disposal for any further information.<br />
						<br />
						Best regards,</p>
						</td>
					</tr>
				</tbody>
			</table>
