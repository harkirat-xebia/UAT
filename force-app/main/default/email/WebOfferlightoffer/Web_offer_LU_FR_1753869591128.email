							<tbody>
								<tr>
									<td align="center" class="pad-0-20-20-20" style="padding: 0 0 20px 40px;width:40px;"><img alt="." border="0" src="https://campaign.edenred.be/images/TEMPLATE/2023_MASTER_TEMPLATE/default-icoAdvice.png" style="display: block;width:40px;" width="40" /></td>
								</tr>
