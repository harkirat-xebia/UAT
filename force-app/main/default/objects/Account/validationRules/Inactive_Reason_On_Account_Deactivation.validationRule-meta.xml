<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Inactive_Reason_On_Account_Deactivation</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    ISPICKVAL(ER_Status__c , &quot;Inactive&quot;),
    ISBLANK(TEXT(ER_Inactive_Reason__c))
)</errorConditionFormula>
    <errorMessage>Inactive reason must be filled</errorMessage>
</ValidationRule>
