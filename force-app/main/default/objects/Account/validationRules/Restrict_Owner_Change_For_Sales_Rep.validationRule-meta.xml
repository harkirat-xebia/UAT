<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Restrict_Owner_Change_For_Sales_Rep</fullName>
    <active>false</active>
    <errorConditionFormula>AND(
  ISCHANGED(OwnerId),
  $Profile.Name = &quot;Sales Rep&quot;
)</errorConditionFormula>
    <errorMessage>You are not allowed to change the owner of this record.</errorMessage>
</ValidationRule>
