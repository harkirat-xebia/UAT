<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>VRER08_Check_Medallia_Day_Month_Format</fullName>
    <active>true</active>
    <description>This VR is used to check the format of medallia trigger day</description>
    <errorConditionFormula>NOT($User.ER_BypassVR__c)
                    &amp;&amp; RecordType.DeveloperName = &apos;ER_Individual_Account_RT&apos;
                    &amp;&amp; NOT(ISBLANK(ER_Medallia_Invitation_Trigger_Date__c))
                    &amp;&amp; NOT(REGEX(ER_Medallia_Invitation_Trigger_Date__c, &quot;[0-9]{2}/[0-9]{2}&quot;))</errorConditionFormula>
    <errorMessage>VRER08 - The Medallia Invitation Trigger Date field should have the following format &quot;dd/mm&quot; (Ex. 02/11)</errorMessage>
</ValidationRule>
