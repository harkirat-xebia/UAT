<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Order_Status__c</fullName>
    <externalId>false</externalId>
    <formula>IF(ISBLANK(Last_Order_Date__c), &quot;Inactive&quot;,
            IF(TODAY() - Last_Order_Date__c &gt;= 90, &quot;Inactive&quot;, &quot;Active&quot;)
         )</formula>
    <inlineHelpText>Marks the order status as Inactive if the Last Order Date is 90 days and beyond</inlineHelpText>
    <label>Order Status</label>
    <required>false</required>
    <trackHistory>false</trackHistory>
    <type>Text</type>
    <unique>false</unique>
</CustomField>
