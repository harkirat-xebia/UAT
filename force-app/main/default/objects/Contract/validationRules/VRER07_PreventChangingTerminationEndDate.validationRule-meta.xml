<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>VRER07_PreventChangingTerminationEndDate</fullName>
    <active>false</active>
    <description>Prevent changing the end date of a terminated contract</description>
    <errorConditionFormula>NOT($User.ER_BypassVR__c)
            &amp;&amp; (ISPICKVAL(Status, &apos;Pending Termination&apos;) || ISPICKVAL(Status, &apos;Terminated&apos;))
            &amp;&amp; ISCHANGED(EndDate)
            &amp;&amp; NOT(ISBLANK(PRIORVALUE(EndDate)))</errorConditionFormula>
    <errorMessage>You cannot change the End Date when the contract is Pending Termination or Terminated.</errorMessage>
</ValidationRule>
