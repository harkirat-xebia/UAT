<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>VRER04_TerminationReasonMandatory</fullName>
    <active>true</active>
    <description>Mandatory when Contract End Date is not empty</description>
    <errorConditionFormula>NOT($User.ER_BypassVR__c)
&amp;&amp; ISBLANK(TEXT(ER_TerminationReason__c))
&amp;&amp; NOT(ISBLANK(EndDate))
&amp;&amp; ER_Contract_Type__c != &apos;Framework agreement&apos;</errorConditionFormula>
    <errorMessage>Please Capture the Termination Reason</errorMessage>
</ValidationRule>
