<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>VRBE01_PreventChange</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
            NOT($User.ER_BypassVR__c),
            ISPICKVAL( $User.ER_Business_Unit__c, &apos;BENELUX&apos;),
            OR( $Profile.Name = &apos;Client Sales&apos;,
            $Profile.Name = &apos;Marketing&apos;
            )
            )</errorConditionFormula>
    <errorMessage>You are not able to modify</errorMessage>
</ValidationRule>
