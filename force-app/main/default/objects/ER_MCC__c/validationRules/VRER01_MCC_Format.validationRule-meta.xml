<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>VRER01_MCC_Format</fullName>
    <active>true</active>
    <description>MCC should be composed of 4 numbers</description>
    <errorConditionFormula>AND(
NOT($User.ER_BypassVR__c),
NOT(LEN(ER_MCC_Authorization__c)=4))</errorConditionFormula>
    <errorMessage>Please, correct MCC Authorization format</errorMessage>
</ValidationRule>
