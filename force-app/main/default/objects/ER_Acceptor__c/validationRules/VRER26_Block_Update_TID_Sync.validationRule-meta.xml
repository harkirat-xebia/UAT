<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>VRER26_Block_Update_TID_Sync</fullName>
    <active>true</active>
    <description>VRER26 - TID Authorization  cannot be modified when the financial center is synchronized</description>
    <errorConditionFormula>NOT($User.ER_BypassVR__c)
&amp;&amp; NOT(ISNEW())
&amp;&amp; ISCHANGED(ER_TID_Authorization__c)
&amp;&amp; NOT(ISBLANK(ER_Creation_date_in_OS__c))
&amp;&amp; (NOT(ER_Business_Unit__c =&apos;BENELUX&apos;)||
				NOT(ISPICKVAL(ER_Acceptor_Scheme__c, &apos;MasterCard&apos;)) )</errorConditionFormula>
    <errorDisplayField>ER_TID_Authorization__c</errorDisplayField>
    <errorMessage>VRER26 - The TID cannot be modified when the acceptor is synchronized</errorMessage>
</ValidationRule>
