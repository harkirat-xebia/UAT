<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>VRER03_Invoicing_Site_Company_Reg_Check</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
NOT($User.ER_BypassVR__c),
ER_Business_Unit__c == &apos;ES&apos;,
ER_Invoicing_Site__c,
ISBLANK( ER_Account_Name__r.ER_Registration_Number__c)
)</errorConditionFormula>
    <errorMessage>Enter a valid Company Registration Number on the Account before selecting “Invoicing Site&quot;</errorMessage>
</ValidationRule>
