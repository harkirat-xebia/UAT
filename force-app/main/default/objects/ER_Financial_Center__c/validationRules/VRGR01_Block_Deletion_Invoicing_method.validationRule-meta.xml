<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>VRGR01_Block_Deletion_Invoicing_method</fullName>
    <active>true</active>
    <description>Block the deletion of invoicing method for the sync account</description>
    <errorConditionFormula>NOT($User.ER_BypassVR__c)
&amp;&amp; NOT(ISNEW())
&amp;&amp; ISPICKVAL(ER_BUPicklist__c, &quot;GR&quot;)
&amp;&amp; ISCHANGED(ER_Preferred_Invoicing_Method__c)
&amp;&amp; ISPICKVAL(ER_Preferred_Invoicing_Method__c ,&apos;&apos;)
&amp;&amp; NOT(ISBLANK(ER_Account_Name__r.ER_Creation_date_in_OS__c))</errorConditionFormula>
    <errorDisplayField>ER_Preferred_Invoicing_Method__c</errorDisplayField>
    <errorMessage>VRGR01 - The Preferred invoice method is mandatory for the Greek synchronized Financial Center</errorMessage>
</ValidationRule>
