<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>VRPL02_Check_Preferred_Language</fullName>
    <active>false</active>
    <errorConditionFormula>NOT($User.ER_BypassVR__c)
            &amp;&amp; ISPICKVAL(ER_BUPicklist__c, &quot;PL&quot;)
            &amp;&amp; NOT(ISPICKVAL(ER_Language__c, &quot;PL&quot;))
            &amp;&amp; NOT(ISPICKVAL(ER_Language__c, &quot;EN&quot;))
            &amp;&amp; NOT(ISPICKVAL(ER_Language__c, &quot;&quot;))</errorConditionFormula>
    <errorMessage>VRPL02 - The Preferred language can be one of the following values : Empty or &quot;PL&quot;</errorMessage>
</ValidationRule>
