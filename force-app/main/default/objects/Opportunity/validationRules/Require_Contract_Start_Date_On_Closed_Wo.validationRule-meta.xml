<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Require_Contract_Start_Date_On_Closed_Wo</fullName>
    <active>true</active>
    <errorConditionFormula>AND( 
    NOT($User.ER_BypassVR__c), 
    ISPICKVAL(StageName, &quot;Proposal&quot;), 
    ISBLANK(ER_Contract_Expected_Start_Date__c) 
)</errorConditionFormula>
    <errorDisplayField>ER_Contract_Expected_Start_Date__c</errorDisplayField>
    <errorMessage>Contract Expected Start Date is required when the Opportunity is in Proposal Stage.</errorMessage>
</ValidationRule>
