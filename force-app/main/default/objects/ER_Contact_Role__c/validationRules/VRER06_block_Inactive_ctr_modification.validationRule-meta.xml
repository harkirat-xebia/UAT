<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>VRER06_block_Inactive_ctr_modification</fullName>
    <active>true</active>
    <description>Block the modification of an inactive contact role</description>
    <errorConditionFormula>NOT($User.ER_BypassVR__c)
&amp;&amp; ISPICKVAL(ER_Status__c, &quot;Inactive&quot;)
&amp;&amp; !ISCHANGED(ER_Status__c)
&amp;&amp; ER_Sync_Code__c != &apos;999&apos;</errorConditionFormula>
    <errorMessage>You cannot create or modify an inactive contact role</errorMessage>
</ValidationRule>
