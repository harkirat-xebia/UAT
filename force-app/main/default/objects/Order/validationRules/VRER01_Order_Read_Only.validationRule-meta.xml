<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>VRER01_Order_Read_Only</fullName>
    <active>true</active>
    <description>This VR is used to prevent editing read only orders (Orders loaded by integration user)</description>
    <errorConditionFormula>NOT($User.ER_BypassVR__c)
&amp;&amp; $Setup.ER_Validation_Rules_Settings__c.VRER01_Order_Read_Only__c = False
&amp;&amp; NOT(ISNEW())
&amp;&amp; CreatedBy.Profile.Name = &apos;ER Integration&apos;</errorConditionFormula>
    <errorMessage>VRER01 - This record is a read only record</errorMessage>
</ValidationRule>
