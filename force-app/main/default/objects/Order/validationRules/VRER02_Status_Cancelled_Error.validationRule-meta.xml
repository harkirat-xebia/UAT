<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>VRER02_Status_Cancelled_Error</fullName>
    <active>true</active>
    <errorConditionFormula>NOT($User.ER_BypassVR__c)
&amp;&amp; (ISPICKVAL(Status, &apos;Activated&apos;) &amp;&amp; (ISPICKVAL(PRIORVALUE(Status), &apos;Cancelled&apos;))
|| (ISPICKVAL(Status, &apos;Draft&apos;) &amp;&amp; (ISPICKVAL(PRIORVALUE(Status), &apos;Cancelled&apos;))))</errorConditionFormula>
    <errorMessage>VRER02 - The status cannot be changed once cancelled</errorMessage>
</ValidationRule>
