        $("html, body").animate(
          {
            scrollTop: $("#trRow" + element).offset().top
          },
          500,
          function () {
            $("#trRow" + element)
              .addClass("error")
              .delay(1000)
              .queue(function (next) {
                $(this).removeClass("error");
                next();
              });
          }
        );
