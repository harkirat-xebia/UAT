      function checkDependencies(setOfSelectedElements, setOfSelectedElements2, phase) {
        optionalProductMAP = new Map();

        for (let element of setOfSelectedElements) {
          if (phase == "phase2") {
            element = serviceMap.get(element).Product2.Id;
          }
          if (productDependenciesMap.has(element)) {
            for (let dependency of productDependenciesMap.get(element)) {
              //console.log('dependency : '+JSON.stringify(dependency));
              var dependentProduct = dependency.ER_Dependent_Product__c;
              var dependentProductSolution;
              dependentProductSolution = dependency.ER_Dependent_Product__r.ER_Solution__c;
              //console.log('dependentProductSolution : '+dependentProductSolution);
              var controllerProduct = dependency.ER_Controlling_Product__c;
              if (phase == "phase2") {
                //console.log('priceBookEntryMap.get(dependentProduct) : '+JSON.stringify(priceBookEntryMap.get(dependentProduct)));
                //console.log('dependentProduct : '+dependentProduct);
                //console.log('controllerProduct : '+controllerProduct);
                if (priceBookEntryMap.get(dependentProduct)) {
                  dependentProduct = priceBookEntryMap.get(dependentProduct).Id;
                }
                if (priceBookEntryMap.get(controllerProduct)) {
                  controllerProduct = priceBookEntryMap.get(controllerProduct).Id;
                }
                if (priceBookEntryMap.get(dependentProductSolution)) {
                  dependentProductSolution = priceBookEntryMap.get(dependentProductSolution).Id;
                }
                //console.log('dependentProduct : '+dependentProduct);
                //console.log('controllerProduct : '+controllerProduct);
                //console.log('dependentProductSolution : '+dependentProductSolution);
              }
              if (setOfSelectedElements.has(dependentProduct)) {
                if (dependency.ER_Configuration__c == "Incompatible") {
                  //console.log('Incompatible ');
                  hideSpinner();
                  showDependenciesError(
                    "{!$Label.LABS_SF_Opp_ProductNotCompatible}",
                    controllerProduct,
                    dependentProduct
                  );
                  $("#trRow" + dependentProduct)
                    .find("label")
                    .addClass("incompatibleProduct");
                  $("#trRow" + controllerProduct)
                    .find("label")
                    .addClass("incompatibleProduct");
                  return true;
                }
              }
              if (dependency.ER_Configuration__c == "Mandatory") {
                //console.log('Mandatory ');
                if (phase == "phase1") {
                  if (setOfSelectedElements.has(controllerProduct) && !setOfSelectedElements.has(dependentProduct)) {
                    hideSpinner();
                    showDependenciesError(
                      "{!$Label.LABS_SF_Opp_ProductMandatoryError}",
                      controllerProduct,
                      dependentProduct
                    );
                    $("#trRow" + dependentProduct)
                      .find("label")
                      .addClass("mandatoryProduct");
                    $("#trRow" + controllerProduct)
                      .find("label")
                      .addClass("mandatoryProduct");
                    return true;
                  }
                } else {
                  //console.log('check depndenceies MANDATORY PHASE 2 : ');
                  //console.log('setOfSelectedElements.has(dependentProductSolution) '+setOfSelectedElements2.has(dependentProductSolution));
                  if (
                    setOfSelectedElements.has(controllerProduct) &&
                    setOfSelectedElements2.has(dependentProductSolution) &&
                    !setOfSelectedElements.has(dependentProduct)
                  ) {
                    hideSpinner();
                    showDependenciesError(
                      "{!$Label.LABS_SF_Opp_ProductMandatoryError}",
                      controllerProduct,
                      dependentProduct
                    );
                    $("#trRow" + dependentProduct)
                      .find("label")
                      .addClass("mandatoryProduct");
                    $("#trRow" + controllerProduct)
                      .find("label")
                      .addClass("mandatoryProduct");
                    return true;
                  }
                }
              }
              if (dependency.ER_Configuration__c == "Optional") {
                if (optionalProductMAP.has(controllerProduct)) {
                  var tempOptionalProd = optionalProductMAP.get(controllerProduct);
                  tempOptionalProd.push(dependentProduct);
                  optionalProductMAP.set(controllerProduct, tempOptionalProd);
                } else {
                  var tempOptionalProd = [];
                  tempOptionalProd.push(dependentProduct);
                  optionalProductMAP.set(controllerProduct, tempOptionalProd);
                }
              }
            }
          }
        }

        if (optionalProductMAP) {
          var setOptionalWarning = new Set();

          for (const [key, values] of optionalProductMAP.entries()) {
            setOptionalWarning = new Set();
            for (const value of values) {
              if (setOfSelectedElements.has(value)) {
                setOptionalWarning = new Set();
                break;
              } else {
                setOptionalWarning.add(value);
              }
            }
            //console.log('end loop2 : '+setOptionalWarning.size);
            if (setOptionalWarning.size > 0) {
              hideSpinner();
              let optionalProduct = [];
              var optionalProductsText = "";

              var errorLink = "<b id=error{0} class='errorTextLink' onclick='showQuickError(\"{1}\")'>{2}</b>";
              for (const optionalValue of setOptionalWarning) {
                $("#trRow" + optionalValue)
                  .find("label")
                  .addClass("dependentProductOptional");
                if (optionalProductsText != "") {
                  optionalProductsText += " , ";
                }
                optionalProductsText += errorLink
                  .replace("{0}", optionalValue)
                  .replace("{1}", optionalValue)
                  .replace("{2}", $("#product" + optionalValue).html());
              }
              $("#messageTextId").css("display", "block");
              var productName = errorLink
                .replace("{0}", key)
                .replace("{1}", key)
