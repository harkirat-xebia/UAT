                  <div class="slds-resizable"></div>
                </th>
                <th class="slds-text-title_caps slds-is-resizable slds-is-sortable column3" style="width: 12%">
                  <div class="slds-grid slds-grid_vertical-align-center slds-has-flexi-truncate">
                    <span class="slds-truncate" title="{!$Label.LABS_SF_Opp_Price_DefaultValue}"
                      >{!$Label.LABS_SF_Opp_Price_DefaultValue}</span
                    >
                  </div>
                  <div class="slds-resizable"></div>
                </th>
                <th class="slds-text-title_caps slds-is-resizable slds-is-sortable column4" style="width: 12%">
                  <div class="slds-grid slds-grid_vertical-align-center slds-has-flexi-truncate">
                    <span class="slds-required requiredHeader">*</span>
                    <span class="slds-truncate" title="{!$Label.LABS_SF_Opp_Price_Value}"
                      >{!$Label.LABS_SF_Opp_Price_Value}</span
                    >
                  </div>
                  <div class="slds-resizable"></div>
                </th>
                <th
                  class="slds-text-title_caps slds-is-resizable slds-is-sortable column5 EKIVITA_voucher_hide EKIVITA_media_hide"
                  style="width: 15%"
                >
                  <div class="slds-grid slds-grid_vertical-align-center slds-has-flexi-truncate">
                    <span class="slds-truncate" title="{!$Label.LABS_SF_Opp_Price_MinimumFee}"
                      >{!$Label.LABS_SF_Opp_Price_MinimumFee}</span
                    >
                  </div>
                  <div class="slds-resizable"></div>
                </th>

                <th
                  class="slds-text-title_caps slds-is-resizable slds-is-sortable column6 EKIVITA_voucher_hide EKIVITA_media_hide"
                  style="width: 15%"
                >
                  <div class="slds-grid slds-grid_vertical-align-center slds-has-flexi-truncate">
                    <span class="slds-truncate" title="{!$Label.LABS_SF_Opp_Price_Discount}"
                      >{!$Label.LABS_SF_Opp_Price_Discount}</span
                    >
                  </div>
                  <div class="slds-resizable"></div>
                </th>

                <th
                  class="slds-text-title_caps slds-is-resizable slds-is-sortable column7 EKIVITA_voucher_show EKIVITA_media_hide"
                  style="width: 10%"
                >
                  <div class="slds-grid slds-grid_vertical-align-center slds-has-flexi-truncate">
                    <span class="slds-truncate" title="USER MARGIN">USER MARGIN</span>
                  </div>
                  <div class="slds-resizable"></div>
                </th>

                <th
                  class="slds-text-title_caps slds-is-resizable slds-is-sortable column7 EKIVITA_voucher_show EKIVITA_media_hide"
                  style="width: 10%"
                >
                  <div class="slds-grid slds-grid_vertical-align-center slds-has-flexi-truncate">
                    <span class="slds-truncate" title=">TUR MARGIN">TUR MARGIN</span>
                  </div>
                  <div class="slds-resizable"></div>
                </th>

                <th
                  class="slds-text-title_caps slds-is-resizable slds-is-sortable column8 EKIVITA_voucher_show EKIVITA_media_hide"
                  style="width: 10%"
                >
                  <div class="slds-grid slds-grid_vertical-align-center slds-has-flexi-truncate">
                    <span class="slds-hyphenate" title="FREE TO SET THE MARGIN">FREE TO SET THE MARGIN</span>
                  </div>
                  <div class="slds-resizable"></div>
                </th>

                <th
                  class="slds-text-title_caps slds-is-resizable slds-is-sortable column9 EKIVITA_voucher_show EKIVITA_oop_hide EKIVITA_media_hide"
                  style="width: 10%"
                >
                  <div class="slds-grid slds-grid_vertical-align-center slds-has-flexi-truncate">
                    <span class="slds-truncate" title="MPV">MPV</span>
                  </div>
                  <div class="slds-resizable"></div>
                </th>

                <th
                  class="slds-text-title_caps slds-is-resizable slds-is-sortable column10 EKIVITA_voucher_show EKIVITA_oop_hide EKIVITA_media_hide"
                  style="width: 10%"
                >
                  <div class="slds-grid slds-grid_vertical-align-center slds-has-flexi-truncate">
                    <span class="slds-hyphenate" title="CUMULATIVE WITH PROMOTIONS">CUMULATIVE WITH PROMOTIONS</span>
                  </div>
                  <div class="slds-resizable"></div>
                </th>

                <th
                  class="slds-text-title_caps slds-is-resizable slds-is-sortable column11 EKIVITA_oop_hide EKIVITA_media_show"
                  style="width: 20%"
                >
                  <div class="slds-grid slds-grid_vertical-align-center slds-has-flexi-truncate">
                    <span class="slds-hyphenate" title="CUMULATIVE WITH PROMOTIONS">START DATE</span>
                  </div>
                  <div class="slds-resizable"></div>
                </th>

                <th
                  class="slds-text-title_caps slds-is-resizable slds-is-sortable column12 EKIVITA_oop_hide EKIVITA_media_show"
                  style="width: 20%"
                >
                  <div class="slds-grid slds-grid_vertical-align-center slds-has-flexi-truncate">
                    <span class="slds-hyphenate" title="CUMULATIVE WITH PROMOTIONS">END DATE</span>
                  </div>
                  <div class="slds-resizable"></div>
                </th>

                <th
                  class="slds-text-title_caps slds-is-resizable slds-is-sortable column13 EKIVITA_voucher_hide EKIVITA_voucher_hide EKIVITA_media_hide"
                  style="width: 15%"
                ></th>

                <th
                  style="width: 15%"
                  class="slds-text-title_caps slds-is-resizable slds-is-sortable column14 EKIVITA_voucher_hide EKIVITA_voucher_hide EKIVITA_media_hide"
                ></th>
              </tr>
            </thead>
            <tbody id="ContentTable" width="100%">
              <!--JS CONTENT-->
            </tbody>
          </table>
        </div>
      </div>
      <div class="footer">
        <div class="footerContent">
          <apex:actionStatus id="previousButtonStatus">
            <apex:facet name="start">
              <apex:outputPanel >
                <apex:image value="{!URLFOR($Resource.SLDS272, 'images/spinners/slds_spinner_brand.gif')}"
                  height="25"
                  width="25"
                />
              </apex:outputPanel>
            </apex:facet>
            <apex:facet name="stop">
              <apex:outputPanel >
                <apex:commandButton id="previousButtonid"
                  styleClass="slds-button slds-button_neutral"
                  value="{!$Label.LABS_SF_Opp_Price_Previous}"
                  status="previousButtonStatus"
                  onclick="PreviousPhase();return false;"
                  style="float: left; display: none"
                  reRender="previousButtonid"
                />
              </apex:outputPanel>
            </apex:facet>
          </apex:actionStatus>
          <apex:actionStatus id="cancelButtonStatus">
            <apex:facet name="start">
              <apex:outputPanel >
                <apex:image value="{!URLFOR($Resource.SLDS272, 'images/spinners/slds_spinner_brand.gif')}"
                  height="25"
                  width="25"
                />
              </apex:outputPanel>
            </apex:facet>
            <apex:facet name="stop">
              <apex:outputPanel >
                <apex:commandButton id="cancelButtonid"
                  styleClass="slds-button slds-button_neutral"
                  value="{!$Label.LABS_SF_Opp_Price_Cancel}"
                  action="{!cancel}"
                  status="cancelButtonStatus"
                />
              </apex:outputPanel>
            </apex:facet>
          </apex:actionStatus>
          <apex:actionStatus id="nextButtonStatus">
            <apex:facet name="start">
              <apex:outputPanel >
                <apex:image value="{!URLFOR($Resource.SLDS272, 'images/spinners/slds_spinner_brand.gif')}"
                  height="25"
                  width="25"
                />
              </apex:outputPanel>
            </apex:facet>
            <apex:facet name="stop">
              <apex:outputPanel >
                <apex:commandButton id="nextButtonid"
                  styleClass="slds-button slds-button_brand"
                  status="nextButtonStatus"
                  onclick="NextPhase();return false;"
                />
              </apex:outputPanel>
            </apex:facet>
          </apex:actionStatus>
        </div>
      </div>
    </apex:form>

    <script type="text/javascript">
      var opportunityId = "{!opportunityRecord}";
      var opportunityPromoCode = "{!opportunityRecord.ER_Promo_Code2__c}";
      var pricebookId = "{!opportunityRecord.Pricebook2Id}";
      var accountId = "{!opportunityRecord.AccountId}";
      var isAmendedOpportunity = "{!opportunityRecord.ER_IsAmended__c}";
      var opportunityContractId = "{!opportunityRecord.ER_AmendedFromOpportunity__r.ContractId}";
      var contractId = "{!opportunityRecord.ER_AmendedFromContract__c}";
      var contractType = "{!opportunityRecord.Type}";
      var businessUnit = "{!opportunityRecord.ER_BUPicklist__c}";
      var pricebook2Name = "{!priceBookName}";
      var opportunityVat = "{!opportunityRecord.ER_Vat__c}";
      var additionalServicesLabelValue = '{!$Label.ADDITIONAL_SERVICES_LABEL}';
      var renderIssuedVolumeBUSet = "{!renderIssuedVolumeBUSet}";
      var solutionsByIdMap = {};
      var maxDiscount = "{!opportunityRecord.Max_Discount__c}";
      var minValue = "{!opportunityRecord.Min_Approval_Value__c}";

      if (opportunityContractId) {
        contractId = opportunityContractId;
      }
      var chevrondown = "{!URLFOR($Resource.SLDS272, 'icons/utility/chevrondown_60.png')}";
      var chevronright = "{!URLFOR($Resource.SLDS272, 'icons/utility/chevronright_60.png')}";
      var currentPhase = "Phase1";
      var incompatibleValue = "{!$Label.LABS_SF_Opp_Product_Incompatible}";
      var optionalValue = "{!$Label.LABS_SF_Opp_Product_Optional}";
      var mandatoryValue = "{!$Label.LABS_SF_Opp_Product_Mandatory}";
      var Phase1selectedProducts = [];
      var Phase2selectedProducts = [];
      var rangeSelected = [];
      var discountSelected = [];
      var allParentSelected = [];
      var Phase1selectedProductsCompare = [];
      let LinkedOpportunityProduct = new Map();
      var LinkedOpportunitySolution = new Set();
      let serviceMap = new Map();
      let solutionMap = new Map();
      let rangeMap = new Map();
      let discountMap = new Map();
      let allPhase2Products = new Map();
      let serviceByRangeMap = new Map();
      let parentRangeMap = new Map();
      let parentRangeMap2 = new Map();
      let parentDiscountMap = new Map();
      let parentRangeDiscountMap = new Map();
      let allParentRangeDiscountMap = new Map();
      let priceBookEntryMap = new Map();
      let productDependenciesMap = new Map();
      let productControllersMap = new Map();
      let dependentSolutions = new Map();
      let incompatibleSolutions = new Map();
      let optionalProductMAP = new Map();
      let discountMapforRangesNew = new Map();

      $(document).ready(function () {
        currentPhase = "Phase1";
        disableElement("nextButtonid");
        $("[id$=nextButtonid]").val("{!$Label.LABS_SF_Opp_Price_Next}");

        if (opportunityId) {
          //hide('previousButtonid');
          $(".Phase1 .solutionCheckbox").on("change", countPhase1Checked);
          //$( ".Phase1 .solutionCheckbox" ).on( "change", getdependentProduct);
          getBUDetailsFromMetadata(); /** Called By: Pranjal Tiwari on 05 Sep, 2024 */
          getAllProductDependencies();
          getLinkedOpportunityProduct(opportunityId);
          getDefaultProductSelection(opportunityId);
        } else {
          showError("{!$Label.LABS_SF_Opp_Price_NoOpportunity}");
        }
      });

      function getLinkedOpportunityProduct(oppId) {
        showSpinner();
        Visualforce.remoting.Manager.invokeAction(
          "{!$RemoteAction.VFCER05_Opportunity_EditPrice.getOpportunityProduct}",
          oppId,
          function (result, event) {
            hideSpinner();
            if (event.status) {
              for (var key in result) {
                LinkedOpportunityProduct.set(key, result[key]);
                $("#checkbox" + result[key].Product2.ER_Solution__c)
                  .prop("checked", "true")
                  .change();
                $("#trRow" + result[key].Product2.ER_Solution__c).css("background", "#4bca8124");

                if (result[key].ER_Line_Type__c != "Service") {
