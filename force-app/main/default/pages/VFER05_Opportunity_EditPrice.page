      function calculateEstimate(element, entryName) {
            var faceVal = document.getElementById('Face_Value_' + entryName).value;
            var beneficiaries = document.getElementById('No_Of_Beneficiaries_' + entryName).value;
            var loadYear = document.getElementById('Load_Per_Year_' + entryName).value;
            var dayPerMonth = document.getElementById('Days_per_Month_' + entryName).value;
        
            var result = faceVal * beneficiaries * loadYear * dayPerMonth;
            
            document.getElementById('Issued_Volume_' + entryName).textContent = result;
        }

      
