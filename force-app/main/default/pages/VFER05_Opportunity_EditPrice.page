      function getBUDetailsFromMetadata(){
          Visualforce.remoting.Manager.invokeAction(
                "{!$RemoteAction.VFCER05_Opportunity_EditPrice.fetchBUFromMetadata}",
                function (result, event) {
                  hideSpinner();
                  if (event.status){ 
                    console.log("Success" + event.status);
                    console.log("Result" + JSON.stringify(result));
                    renderIssuedVolumeBUSet = result;
                  } else if (event.type === "exception") {
                    console.log("error" + event.message);
                    showSolutionError(event.message);
                    disableElement("nextButtonid");
                  } else {
                    showSolutionError(event.message);
                    disableElement("nextButtonid");
                  }
                },
                { escape: true }
              );
       }
