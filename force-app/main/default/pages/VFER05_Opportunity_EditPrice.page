            opportunityLineItemObject.ER_Price_End_Date__c = Date.parse(
              $("#priceenddate" + discountMap.get(element).Id).val()
            );

          if (discountMap.get(element).ER_Offer_validity_end_date__c)
            opportunityLineItemObject.ER_Offer_validity_end_date__c = Date.parse(
              discountMap.get(element).ER_Offer_validity_end_date__c
            );

          if (
            !$("#duration" + discountMap.get(element).Id).val() ||
            ($("#duration" + discountMap.get(element).Id).val() &&
              !isNaN($("#duration" + discountMap.get(element).Id).val()))
          )
            opportunityLineItemObject.ER_Duration__c = parseInt($("#duration" + discountMap.get(element).Id).val());

          if (discountMap.get(element).Product2.ER_What__c)
            opportunityLineItemObject.ER_What__c = discountMap.get(element).Product2.ER_What__c;
          opportunityLineItems.push(opportunityLineItemObject);
        }

        for (let element of allParentSelected) {
          var error = false;
          if (
