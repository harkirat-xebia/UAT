      function CheckApprovalProcess(input, triggerValueMin, triggerValueMax) {
        if (
          $(input).val() &&
          !isNaN($(input).val()) &&
          ($(input).val() <= triggerValueMin || $(input).val() > triggerValueMax)
        ) {
          console.log("need approval" + $(input));
          $(input).removeClass("slds-error");
          if (!$(input).hasClass("slds-warning")) {
            $(input).before(
              '<p class="approval" style="color:#ffb75d">{!$Label.LABS_SF_Opp_Product_ApprovalNeeded}</p>'
            );
            $(input).addClass("slds-warning");
          }
        } else {
          $(input).prev("p").remove();
          $(input).removeClass("slds-warning");
          if (!($(input).val() && !isNaN($(input).val()))) {
            console.log("invalid input");
            $(input).addClass("slds-error");
          }
        }
      }

      function discountManagement(input, element, source) {
        if ($(input).val() && !isNaN($(input).val())) {
          var DefaultValueperc = parseFloat($("#listpercentage" + element.Id).html());
          var DefaultValueUnitPrice = element.UnitPrice;
          var DefaultValueprice = parseFloat($("#listprice" + element.Id).html());
          var value = $(input).val();
          if (source == "value") {
            if (DefaultValueperc && !isNaN(DefaultValueperc) && DefaultValueperc >= value) {
              $("#discountValue" + element.Id).val(((DefaultValueperc - value) * 100) / DefaultValueperc);
            } else if (DefaultValueprice && !isNaN(DefaultValueprice) && DefaultValueUnitPrice >= value) {
              $("#discountValue" + element.Id).val(((DefaultValueUnitPrice - value) * 100) / DefaultValueUnitPrice);
            } else {
              $("#discountValue" + element.Id).val(0);
            }
          } else if (source == "discount") {
            if (DefaultValueperc && !isNaN(DefaultValueperc)) {
              $("#percentage" + element.Id).val(DefaultValueperc - (value * DefaultValueperc) / 100);
              //checkapproval("#percentage"+element.Id, element.ER_Approval_Trigger_Value__c);
              //checkapprovalMax("#percentage"+element.Id, element.ER_Approval_Trigger_Value_Max__c);
              CheckApprovalProcess(
                "#percentage" + element.Id,
                element.ER_Approval_Trigger_Value__c,
                element.ER_Approval_Trigger_Value_Max__c
              );
            } else if (DefaultValueprice && !isNaN(DefaultValueprice)) {
              $("#salesprice" + element.Id).val(DefaultValueUnitPrice - (value * DefaultValueUnitPrice) / 100);
              //checkapproval("#salesprice"+element.Id, element.ER_Approval_Trigger_Value__c);
              //checkapprovalMax("#salesprice"+element.Id, element.ER_Approval_Trigger_Value_Max__c);
              CheckApprovalProcess(
                "#salesprice" + element.Id,
                element.ER_Approval_Trigger_Value__c,
                element.ER_Approval_Trigger_Value_Max__c
              );
            }
          }
          $(input).removeClass("slds-error");
        } else {
          $(input).addClass("slds-error");
        }
      }

