      }
      .size_1-of-1 {
      width:100%;
      display: inline-block;
      }
      .size_1-of-2 {
      width:49%;
      display: inline-block;
      }
      .size_1-of-3 {
      width:33%;
      display: inline-block;
      }
      .size_1-of-4 {
      width:24%;
      display: inline-block;
      }
      .title{
