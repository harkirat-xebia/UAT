      <!--  TRV - 0 - ALPHA             -->
      @page {                                      <!--  HC  - 1 - BRAVO             -->
      size: A4;                                    <!--  TR  - 2 - CHARLIE           -->
      margin: 10mm 15mm 0mm 15mm;                  <!--  TC  - 3 - DELTA             -->
      @top-center {                                <!--  TM  - 4 - ECHO              -->
      content: element(header);                    <!-- To move between docs quickly -->
      }
      @bottom-right {
      content: counter(page);
      }
      }
      label {
      }
      strong{
      }
      .header {
      font-family: Arial Unicode MS;
      margin-top:10px;
      position: running(header);
      }
      .content {
      font-family: Arial Unicode MS;
      margin-left:10px;
      margin-right: 10px;
      }
      .pagenumber:before {
      content: counter(page);
      }
      .pagecount:before {
      content: counter(pages);
      }
      .container {
      font-size: 7,5pt;
      }
      .topleft {
      float:left;
      width: 48%;
      }
      .left {
      position: absolute;
      left: 16px;
      width:46%;
      }
      .right {
      position: absolute;
      right: 16px;
      width:46%;
      }
      .topright {
      float:right;
      width: 48%;
      }
      ol.alphabetList {
      list-style-type: lower-alpha;
      }
      li{
      text-align:justify;
      font-size: 9px;
      }
      p{
      font-size: 10px;
      font-family: Arial Unicode MS;
      }
      hr {
      width: 60%;
      margin-left: 0px;
      }
      div{
      font-family: Arial Unicode MS;
      }
      table {
      border-collapse: collapse;
      border: 1px solid #FFFFFF;
      width: 80%;
      margin-left:10px;
      columnsWidth:200px;
      font-family: Arial Unicode MS;
      }
      th{
      padding: 1.5px;
      text-align: center;
      font-size: 8.8px;
      color: #000000;
      width: 50%;
      font-family: Arial Unicode MS;
      }
      td{
      text-align: center;
      border-bottom: 1px solid #ddd;
      padding: 2.5px;
      font-size: 8px;
      color: #616161;
      width: 50%;
      font-family: Arial Unicode MS;
      }
      .block{
      }
      .gdiv{
      padding-top : 5px;
      padding-bottom : 5px;
      color: #000000;
      background-color: #D3D3D3;
      padding-left: 5px;
      font-size: 11px;
      }
      .row{
