      font-weight: bold;
      }
      .outputField{
      font-weight: bold;
      }
      .footer{
      font-family: Arial Unicode MS;
      margin-left: 10px;
      color: #BDBDBD;
      font-size: 10px;
      text-align: left;
      position: fixed;
      margin-bottom: 1px;
