<?xml version="1.0" encoding="UTF-8"?>
<FlexiPage xmlns="http://soap.sforce.com/2006/04/metadata">
    <flexiPageRegions>
        <itemInstances>
            <componentInstance>
                <componentInstanceProperties>
                    <name>actionNames</name>
                    <valueList>
                        <valueListItems>
                            <value>Quote.Send_Web_Offer</value>
                            <visibilityRule>
                                <booleanFilter>1 AND 2 AND 3 AND 6 AND 7 AND (4 OR 5)</booleanFilter>
                                <criteria>
                                    <leftValue>{!Record.Opportunity.Account.NumberOfEmployees}</leftValue>
                                    <operator>LE</operator>
                                    <rightValue>29</rightValue>
                                </criteria>
                                <criteria>
                                    <leftValue>{!Record.Opportunity.BE_Email_Status__c}</leftValue>
                                    <operator>NE</operator>
                                    <rightValue>Pending</rightValue>
                                </criteria>
                                <criteria>
                                    <leftValue>{!Record.Opportunity.BE_Email_Status__c}</leftValue>
                                    <operator>NE</operator>
                                    <rightValue>Success</rightValue>
                                </criteria>
                                <criteria>
                                    <leftValue>{!Record.Content_Visibility_Flag__c}</leftValue>
                                    <operator>EQUAL</operator>
                                    <rightValue>true</rightValue>
                                </criteria>
                                <criteria>
                                    <leftValue>{!Record.Opportunity.Owner.Profile.Name}</leftValue>
                                    <operator>EQUAL</operator>
                                    <rightValue>System Administrator</rightValue>
                                </criteria>
                                <criteria>
                                    <leftValue>{!Record.Status}</leftValue>
                                    <operator>NE</operator>
                                    <rightValue>Denied</rightValue>
                                </criteria>
                                <criteria>
                                    <leftValue>{!Record.Status}</leftValue>
                                    <operator>NE</operator>
                                    <rightValue>Accepted</rightValue>
                                </criteria>
                            </visibilityRule>
                        </valueListItems>
                        <valueListItems>
                            <value>Quote.Create_Contract_Manually</value>
                            <visibilityRule>
                                <booleanFilter>1 AND 2 AND 3 AND 4</booleanFilter>
                                <criteria>
                                    <leftValue>{!Record.Contract.ContractNumber}</leftValue>
                                    <operator>EQUAL</operator>
                                </criteria>
                                <criteria>
                                    <leftValue>{!Record.Create_Contract__c}</leftValue>
                                    <operator>EQUAL</operator>
                                    <rightValue>false</rightValue>
                                </criteria>
                                <criteria>
                                    <leftValue>{!Record.Status}</leftValue>
                                    <operator>EQUAL</operator>
                                    <rightValue>Accepted</rightValue>
                                </criteria>
                                <criteria>
                                    <leftValue>{!Record.Content_Visibility_Flag__c}</leftValue>
                                    <operator>EQUAL</operator>
                                    <rightValue>true</rightValue>
                                </criteria>
                            </visibilityRule>
                        </valueListItems>
                        <valueListItems>
                            <value>Quote.Send_Quote2</value>
                            <visibilityRule>
                                <booleanFilter>1 AND 2</booleanFilter>
                                <criteria>
                                    <leftValue>{!Record.Status}</leftValue>
                                    <operator>EQUAL</operator>
                                    <rightValue>Draft</rightValue>
                                </criteria>
                                <criteria>
                                    <leftValue>{!Record.Account_Type__c}</leftValue>
                                    <operator>EQUAL</operator>
                                    <rightValue>MM</rightValue>
                                </criteria>
                            </visibilityRule>
                        </valueListItems>
                        <valueListItems>
                            <value>Quote.Send_Form</value>
                            <visibilityRule>
                                <criteria>
                                    <leftValue>{!Record.DS_Form_Sent__c}</leftValue>
                                    <operator>EQUAL</operator>
                                    <rightValue>false</rightValue>
                                </criteria>
                            </visibilityRule>
                        </valueListItems>
                    </valueList>
                </componentInstanceProperties>
                <componentInstanceProperties>
                    <name>collapsed</name>
                    <value>false</value>
                </componentInstanceProperties>
                <componentInstanceProperties>
                    <name>enableActionsConfiguration</name>
                    <value>true</value>
                </componentInstanceProperties>
                <componentInstanceProperties>
                    <name>enableActionsInNative</name>
                    <value>true</value>
                </componentInstanceProperties>
                <componentInstanceProperties>
