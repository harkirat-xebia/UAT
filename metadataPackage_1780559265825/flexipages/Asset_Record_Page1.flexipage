                                <criteria>
                                    <leftValue>{!Record.RecordType.DeveloperName}</leftValue>
                                    <operator>EQUAL</operator>
                                    <rightValue>ER_Anonymous_Card</rightValue>
                                </criteria>
                                <criteria>
                                    <leftValue>{!Record.RecordType.DeveloperName}</leftValue>
                                    <operator>CONTAINS</operator>
                                    <rightValue>ER_Asset_Record_Type</rightValue>
                                </criteria>
                            </visibilityRule>
                        </valueListItems>
                        <valueListItems>
                            <value>Asset.ER_Unblock_Card</value>
                            <visibilityRule>
                                <booleanFilter>1 OR 2</booleanFilter>
                                <criteria>
                                    <leftValue>{!Record.RecordType.DeveloperName}</leftValue>
                                    <operator>EQUAL</operator>
                                    <rightValue>ER_Asset_Record_Type</rightValue>
                                </criteria>
                                <criteria>
                                    <leftValue>{!Record.RecordType.DeveloperName}</leftValue>
                                    <operator>CONTAINS</operator>
                                    <rightValue>ER_Anonymous_Card</rightValue>
                                </criteria>
                            </visibilityRule>
                        </valueListItems>
                        <valueListItems>
                            <value>Asset.ER_Mobile_Activation</value>
                            <visibilityRule>
                                <booleanFilter>1 OR 2</booleanFilter>
                                <criteria>
                                    <leftValue>{!Record.RecordType.DeveloperName}</leftValue>
                                    <operator>EQUAL</operator>
                                    <rightValue>ER_Anonymous_Card</rightValue>
                                </criteria>
                                <criteria>
                                    <leftValue>{!Record.RecordType.DeveloperName}</leftValue>
                                    <operator>EQUAL</operator>
                                    <rightValue>ER_Asset_Record_Type</rightValue>
                                </criteria>
                            </visibilityRule>
                        </valueListItems>
                        <valueListItems>
                            <value>Asset.Temporary_Get_Balance</value>
                            <visibilityRule>
                                <criteria>
                                    <leftValue>{!Record.RecordType.DeveloperName}</leftValue>
                                    <operator>EQUAL</operator>
                                    <rightValue>Issuer_Account</rightValue>
                                </criteria>
                            </visibilityRule>
                        </valueListItems>
                        <valueListItems>
                            <value>Asset.Temporary_Get_Transactions</value>
                            <visibilityRule>
                                <criteria>
                                    <leftValue>{!Record.RecordType.DeveloperName}</leftValue>
                                    <operator>EQUAL</operator>
                                    <rightValue>Issuer_Account</rightValue>
                                </criteria>
                            </visibilityRule>
                        </valueListItems>
                        <valueListItems>
                            <value>Asset.Smarter_Block_Card</value>
                            <visibilityRule>
                                <booleanFilter>1 AND (2 OR 3)</booleanFilter>
                                <criteria>
                                    <leftValue>{!Record.RecordType.DeveloperName}</leftValue>
                                    <operator>EQUAL</operator>
                                    <rightValue>Edenred_plus</rightValue>
                                </criteria>
                                <criteria>
                                    <leftValue>{!Record.Status}</leftValue>
                                    <operator>EQUAL</operator>
                                    <rightValue>Active</rightValue>
                                </criteria>
                                <criteria>
                                    <leftValue>{!Record.Status}</leftValue>
                                    <operator>EQUAL</operator>
                                    <rightValue>ER_Issued</rightValue>
                                </criteria>
                            </visibilityRule>
                        </valueListItems>
                        <valueListItems>
                            <value>Asset.Smarter_UnBlock_Card</value>
                            <visibilityRule>
                                <booleanFilter>1 AND 2</booleanFilter>
                                <criteria>
                                    <leftValue>{!Record.Status}</leftValue>
                                    <operator>EQUAL</operator>
                                    <rightValue>Blocked</rightValue>
                                </criteria>
                                <criteria>
