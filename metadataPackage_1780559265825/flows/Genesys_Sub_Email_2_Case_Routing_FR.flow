<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>57.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Check_case_status</name>
        <label>Check record Type</label>
        <locationX>182</locationX>
        <locationY>158</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>isRecordTypeValid</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>AttributeGenesis</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_routing</targetReference>
            </connector>
            <label>isRecordTypeValid</label>
        </rules>
    </decisions>
    <description>Implements the logic for FR when receiving incoming email</description>
    <environments>Default</environments>
    <formulas>
        <name>AttributeGenesis</name>
        <dataType>String</dataType>
        <expression>CASE({!RecordEmailMessage.Parent.RecordType.DeveloperName},
&apos;ER_Client_Case_RT&apos;, &apos;SF_QUEUE=FR_EP_B2B_ContactFrom_retour&apos;,
&apos;ER_User_Case_RT&apos;, &apos;SF_QUEUE=FR_EP_B2C_ContactFrom_retour&apos;, &apos;&apos;)</expression>
    </formulas>
    <formulas>
        <name>QueueName</name>
        <dataType>String</dataType>
        <expression>CASE({!RecordEmailMessage.Parent.RecordType.DeveloperName},
&apos;ER_Client_Case_RT&apos;, &apos;FR_EP_B2B_Web2Case&apos;,
&apos;ER_User_Case_RT&apos;, &apos;FR_EP_B2C_Web2Case&apos;, &apos;&apos;)</expression>
    </formulas>
    <interviewLabel>Genesys - Sub Email 2 Case Routing FR {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Genesys - Sub Email 2 Case Routing FR</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Create_routing</name>
        <label>Create routing</label>
        <locationX>50</locationX>
        <locationY>278</locationY>
        <inputAssignments>
            <field>purecloud__Attributes__c</field>
            <value>
                <elementReference>AttributeGenesis</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>purecloud__Inbound_Email_Flow__c</field>
            <value>
                <elementReference>QueueName</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>purecloud__Remote_Name__c</field>
            <value>
                <elementReference>RecordEmailMessage.Parent.CaseNumber</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>purecloud__Salesforce_Object_ID__c</field>
            <value>
                <elementReference>RecordEmailMessage.ParentId</elementReference>
            </value>
        </inputAssignments>
        <object>purecloud__PureCloud_Routing_Request__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <start>
        <locationX>56</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Check_case_status</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <variables>
        <name>RecordEmailMessage</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
        <objectType>EmailMessage</objectType>
    </variables>
</Flow>
