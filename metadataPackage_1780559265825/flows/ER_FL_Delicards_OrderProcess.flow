    <decisions>
        <name>CLISelectionCheck</name>
        <label>CLISelectionCheck</label>
        <locationX>396</locationX>
        <locationY>1118</locationY>
        <defaultConnector>
            <targetReference>LoopThroughCLI</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>CLI_is_selected</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Select_an_item_to_add_to_the_order</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <elementReference>LoopThroughCLI.Id</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>AssignVariableCLI</targetReference>
            </connector>
            <label>CLI is selected?</label>
        </rules>
    </decisions>
