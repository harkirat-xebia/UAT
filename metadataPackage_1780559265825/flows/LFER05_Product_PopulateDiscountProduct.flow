    <decisions>
        <name>isRecordDiscountOrRange</name>
        <label>isRecordDiscountOrRange</label>
        <locationX>369</locationX>
        <locationY>310</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Record_is_Range_or_Discount</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Discount</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Range</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>getParentRecord</targetReference>
            </connector>
            <label>Record is Range or Discount</label>
        </rules>
