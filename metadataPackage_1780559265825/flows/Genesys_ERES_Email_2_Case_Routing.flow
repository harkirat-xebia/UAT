<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>52.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>CheckBU</name>
        <label>Check BU</label>
        <locationX>314</locationX>
        <locationY>335</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>ES</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Parent.ER_BUPicklist__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>ES</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Genesys_Cloud_Routing_Request</targetReference>
            </connector>
            <label>ES</label>
        </rules>
        <rules>
            <name>FR</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Parent.ER_BUPicklist__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>FR</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Genesys_Sub_Email_2_Case_Routing_FR</targetReference>
            </connector>
            <label>FR</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <interviewLabel>Genesys - ERES Email 2 Case Routing {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Genesys - Email 2 Case Routing</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Genesys_Cloud_Routing_Request</name>
        <label>Genesys Cloud Routing Request</label>
        <locationX>50</locationX>
        <locationY>455</locationY>
        <inputAssignments>
            <field>purecloud__Queue__c</field>
            <value>
                <stringValue>ES_PRUEBAS_EMAIL</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>purecloud__Salesforce_Object_ID__c</field>
            <value>
                <elementReference>$Record.ParentId</elementReference>
            </value>
        </inputAssignments>
        <object>purecloud__PureCloud_Routing_Request__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <start>
        <locationX>188</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>CheckBU</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Incoming</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>ParentId</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>EmailMessage</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <subflows>
        <name>Genesys_Sub_Email_2_Case_Routing_FR</name>
        <label>Genesys - Sub Email 2 Case Routing FR</label>
        <locationX>314</locationX>
        <locationY>455</locationY>
        <flowName>Genesys_Sub_Email_2_Case_Routing_FR</flowName>
        <inputAssignments>
            <name>RecordEmailMessage</name>
            <value>
                <elementReference>$Record</elementReference>
            </value>
        </inputAssignments>
    </subflows>
</Flow>
