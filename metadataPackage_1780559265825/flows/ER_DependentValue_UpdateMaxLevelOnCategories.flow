<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>49.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>UpdateMaxLevelOnDependentValues</name>
        <label>UpdateMaxLevelOnDependentValues</label>
        <locationX>611</locationX>
        <locationY>353</locationY>
        <assignmentItems>
            <assignToReference>$Record.ER_TECH_MaxLevelByBU__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>getMaxLevelFromCustomMetadata.Value__c</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>checkByPassFlow</name>
        <label>checkByPassFlow</label>
        <locationX>132</locationX>
        <locationY>362</locationY>
        <defaultConnector>
            <targetReference>getCategoryRecordtypeId</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>FlowIsByPass</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$User.ER_Bypass_Flows__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <label>FlowIsByPass</label>
        </rules>
    </decisions>
    <decisions>
        <name>checkIfBUContainsMaxLevel</name>
        <label>checkIfBUContainsMaxLevel</label>
        <locationX>539</locationX>
        <locationY>540</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>BUHasMaxLevel</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>getMaxLevelFromCustomMetadata</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>UpdateMaxLevelOnDependentValues</targetReference>
            </connector>
            <label>BUHasMaxLevel</label>
        </rules>
    </decisions>
    <decisions>
        <name>checkRecordTypeId</name>
        <label>checkRecordTypeId</label>
        <locationX>58</locationX>
        <locationY>490</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>RecordtypeIsCategory</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.RecordTypeId</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>getCategoryRecordtypeId.Id</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>getMaxLevelFromCustomMetadata</targetReference>
            </connector>
            <label>RecordtypeIsCategory</label>
        </rules>
    </decisions>
    <formulas>
        <name>MAX_LEVEL_DEPT_KEY</name>
        <dataType>String</dataType>
        <expression>TEXT({!$Record.ER_Business_Unit__c}) + &apos;_CATEGORY_MAX_DEPT&apos;</expression>
    </formulas>
    <interviewLabel>ER_DependentValue_UpdateMaxLevelOnCategories {!$Flow.CurrentDateTime}</interviewLabel>
    <label>ER_DependentValue_UpdateMaxLevelOnCategories</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>FREE_FORM_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>getCategoryRecordtypeId</name>
        <label>getCategoryRecordtypeId</label>
        <locationX>368</locationX>
        <locationY>433</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>checkRecordTypeId</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Name</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Category</stringValue>
            </value>
        </filters>
        <filters>
            <field>SobjectType</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>ER_DependentValue__c</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>RecordType</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>getMaxLevelFromCustomMetadata</name>
        <label>getMaxLevelFromCustomMetadata</label>
        <locationX>324</locationX>
        <locationY>621</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>checkIfBUContainsMaxLevel</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Business_Unit__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.ER_Business_Unit__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>MasterLabel</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>MAX_LEVEL_DEPT_KEY</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Global_Settings__mdt</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>49</locationX>
        <locationY>50</locationY>
        <connector>
            <targetReference>checkByPassFlow</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>ER_Business_Unit__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>ER_DependentValue__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Draft</status>
</Flow>
