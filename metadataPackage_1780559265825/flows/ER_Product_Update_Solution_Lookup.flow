    <decisions>
        <name>is_Service_Step</name>
        <label>is Service Step</label>
        <locationX>446</locationX>
        <locationY>431</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Is_Service</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.ER_Solution__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.ER_Solution__r.ER_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Solution</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Populate_Service_Solution_Lookup</targetReference>
            </connector>
            <label>Is Service</label>
        </rules>
        <rules>
            <name>Is_Range</name>
            <conditionLogic>(1 OR 4) AND 2 AND 3 AND 5</conditionLogic>
            <conditions>
                <leftValueReference>$Record.ER_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Range</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.ER_Solution__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.ER_Solution__r.ER_Solution__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.ER_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Discount</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.ER_Solution__r.ER_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Service</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Populate_Range_Discount_Under_Service_Solution_Lookup</targetReference>
            </connector>
            <label>Is Range or Discount Under Service</label>
        </rules>
        <rules>
            <name>Is_Discount_Under_Range</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.ER_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Discount</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.ER_Solution__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.ER_Solution__r.ER_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Range</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Populate_Discount_Under_Range_Solution_Lookup</targetReference>
            </connector>
            <label>Is Discount Under Range</label>
        </rules>
    </decisions>
    <decisions>
        <name>User_Bypassing_Flows</name>
        <label>User Bypassing Flows ?</label>
        <locationX>776</locationX>
