        <name>ProgramName</name>
        <dataType>String</dataType>
        <expression>&quot;My &quot; + LOWER(SUBSTITUTE({!$Record.Account.Name}, &quot; &quot;, &quot;&quot;))  + &quot; Engagement&quot;</expression>
    </formulas>
    <formulas>
        <name>ProgramNameValue</name>
        <dataType>String</dataType>
        <expression>&quot;My&quot;&amp; &quot; &quot;&amp;{!ProgramName3} &amp; &quot; &quot; &amp; &quot;Engagement&quot;</expression>
    </formulas>
