    <environments>Default</environments>
    <formulas>
        <name>CustomerDomain</name>
        <dataType>String</dataType>
        <expression>LOWER(SUBSTITUTE({!$Record.Account.Name}, &quot; &quot;, &quot;&quot;))</expression>
    </formulas>
    <formulas>
        <name>CustomerDomainValue</name>
        <dataType>String</dataType>
        <expression>{!$Record.Customer_Domain__c} &amp; Right({!Copy_1_of_Get_customer_Domain_from_Active_Contract.Id},8)</expression>
    </formulas>
