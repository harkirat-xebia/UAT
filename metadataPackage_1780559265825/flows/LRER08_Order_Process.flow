or: rgb(255, 2, 2); font-family: &amp;quot;Segoe UI VSS (Regular)&amp;quot;, &amp;quot;Segoe UI&amp;quot;, -apple-system, BlinkMacSystemFont, Roboto, &amp;quot;Helvetica Neue&amp;quot;, Helvetica, Ubuntu, Arial, sans-serif, &amp;quot;Apple Color Emoji&amp;quot;, &amp;quot;Segoe UI Emoji&amp;quot;, &amp;quot;Segoe UI Symbol&amp;quot;; font-size: 14px; background-color: rgb(255, 255, 255);&quot;&gt;{!Get_Contract_Information.EndDate}&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;color: rgb(255, 2, 2); font-family: &amp;quot;Segoe UI VSS (Regular)&amp;quot;, &amp;quot;Segoe UI&amp;quot;, -apple-system, BlinkMacSystemFont, Roboto, &amp;quot;Helvetica Neue&amp;quot;, Helvetica, Ubuntu, Arial, sans-serif, &amp;quot;Apple Color Emoji&amp;quot;, &amp;quot;Segoe UI Emoji&amp;quot;, &amp;quot;Segoe UI Symbol&amp;quot;; font-size: 14px; background-color: rgb(255, 255, 255);&quot;&gt;3. The Start Date cannot be before the Order Start Date &lt;/span&gt;&lt;strong style=&quot;color: rgb(255, 2, 2); font-family: &amp;quot;Segoe UI VSS (Regular)&amp;quot;, &amp;quot;Segoe UI&amp;quot;, -apple-system, BlinkMacSystemFont, Roboto, &amp;quot;Helvetica Neue&amp;quot;, Helvetica, Ubuntu, Arial, sans-serif, &amp;quot;Apple Color Emoji&amp;quot;, &amp;quot;Segoe UI Emoji&amp;quot;, &amp;quot;Segoe UI Symbol&amp;quot;; font-size: 14px; background-color: rgb(255, 255, 255);&quot;&gt;{!TODAYDATE}&lt;/strong&gt;&lt;/p&gt;</errorMessage>
                <formulaExpression>{!From_0} &gt;={!Get_Contract_Information.StartDate} 
&amp;&amp; IF(ISBLANK({!Get_Contract_Information.EndDate}), TRUE, {!From_0} &lt;= {!Get_Contract_Information.EndDate})
&amp;&amp; IF(ISBLANK({!ExistingOrderStartDate}), {!From_0} &gt;= {!TODAYDATE}, {!From_0} &gt;= {!ExistingOrderStartDate})</formulaExpression>
            </validationRule>
