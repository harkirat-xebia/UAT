    <formulas>
        <name>TableRow</name>
        <dataType>String</dataType>
        <expression>&apos;&lt;tr&gt;&lt;td&gt;&apos; + {!LoopThroughOrderItems.Product2.Name} +
&apos;&lt;/th&gt;&lt;td&gt;&apos; + TEXT({!LoopThroughOrderItems.UnitPrice}) + 
&apos;&lt;/th&gt;&lt;td&gt;&apos; + TEXT({!LoopThroughOrderItems.Quantity}) + 
&apos;&lt;/th&gt;&lt;/tr&gt;&apos;</expression>
    </formulas>
