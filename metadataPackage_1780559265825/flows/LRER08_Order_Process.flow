oe UI Emoji&amp;quot;, &amp;quot;Segoe UI Symbol&amp;quot;; font-size: 14px; background-color: rgb(255, 255, 255);&quot;&gt;{!ExistingOrder.EndDate}&lt;/b&gt;&lt;/p&gt;</errorMessage>
                <formulaExpression>{!From_0} &lt;= {!To_0} &amp;&amp;
IF(ISBLANK({!Get_Contract_Information.EndDate}), TRUE, {!To_0} &lt;= {!Get_Contract_Information.EndDate}) &amp;&amp; 
IF(ISBLANK({!OrderEndDate}), TRUE, {!To_0} &lt;= {!OrderEndDate})</formulaExpression>
