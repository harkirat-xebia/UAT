    <decisions>
        <name>Is_Created_or_Updated</name>
        <label>Is Created or Updated</label>
        <locationX>176</locationX>
        <locationY>323</locationY>
        <defaultConnector>
            <targetReference>Is_Role_or_Manager_Updated</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Updated</defaultConnectorLabel>
        <rules>
            <name>Created</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>IsNew</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <label>Created</label>
        </rules>
    </decisions>
    <decisions>
        <name>Is_Role_or_Manager_Updated</name>
        <label>Is Role or Manager Updated</label>
        <locationX>440</locationX>
        <locationY>431</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Is_Role_Updated</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.UserRoleId</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>$Record__Prior.UserRoleId</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>fetchOpportunities</targetReference>
            </connector>
            <label>Is Role Updated?</label>
        </rules>
        <rules>
            <name>Is_Manager_Updated</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.ManagerId</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>$Record__Prior.ManagerId</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Copy_1_of_fetchOpportunities</targetReference>
            </connector>
            <label>Is Manager Updated?</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>IsNew</name>
        <dataType>Boolean</dataType>
        <expression>IsNew()</expression>
    </formulas>
