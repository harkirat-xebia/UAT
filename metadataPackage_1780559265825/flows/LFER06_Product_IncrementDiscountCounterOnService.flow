            </value>
        </assignmentItems>
        <connector>
            <targetReference>Update_Service_Counter</targetReference>
        </connector>
    </assignments>
    <decisions>
        <description>Check if flow is bypassed</description>
        <name>CheckUserByPass</name>
        <label>CheckUserByPass</label>
        <locationX>94</locationX>
        <locationY>316</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Flow_is_not_bypassed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$User.ER_Bypass_Flows__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>getDiscountRecordTypeId</targetReference>
            </connector>
            <label>Flow is not bypassed</label>
        </rules>
    </decisions>
    <decisions>
        <description>Check if record that has been created or edited is discount</description>
        <name>IsRecordDiscountType</name>
        <label>IsRecordDiscountType</label>
        <locationX>420</locationX>
        <locationY>313</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Record_is_discount</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.RecordTypeId</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>getDiscountRecordTypeId.Id</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>getServiceRangeProductFromDiscount</targetReference>
            </connector>
            <label>Record is discount</label>
        </rules>
    </decisions>
    <interviewLabel>LFER06_Product_IncrementDiscountCounterOnService {!$Flow.CurrentDateTime}</interviewLabel>
    <label>LFER06_Product_IncrementDiscountCounterOnService</label>
    <loops>
