<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>50.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <description>Increment no of range product field counter on service product</description>
        <name>Increment_Counter</name>
        <label>Increment Counter</label>
        <locationX>1035</locationX>
        <locationY>107</locationY>
        <assignmentItems>
            <assignToReference>NoOfDiscountProducts</assignToReference>
            <operator>Add</operator>
            <value>
                <numberValue>1.0</numberValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>countNoOfDiscounts</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>setNoOfDiscount</name>
        <label>setNoOfDiscount</label>
        <locationX>1080</locationX>
        <locationY>431</locationY>
