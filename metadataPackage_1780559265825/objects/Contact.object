    <validationRules>
        <fullName>VRBE06_Valid_Email</fullName>
        <active>true</active>
        <description>valid email</description>
        <errorConditionFormula>AND( 
    NOT($User.ER_BypassVR__c),
    ER_Business_Unit__c =&apos;BENELUX&apos;,
    NOT(REGEX( Email ,&quot;(^$)|^([a-zA-Z0-9#_\\-\\.\\+\\&apos;]+)@((\\[[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}\\.)|(([a-zA-Z0-9\\-]+\\.)+))([a-zA-Z]{2,63}|[0-9]{1,3}|[a-zA-Z]{2,63}[0-9])(\\]?)$&quot;)), 
    NOT( $Profile.Name = &quot;Integration Profile&quot;), 
    NOT(ISBLANK( Email )))</errorConditionFormula>
        <errorMessage>Please fill in a valid Email address.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRBE07_Valid_Mobile</fullName>
        <active>false</active>
        <description>This rule makes sure the Mobile Number field follows a prescribed format.</description>
        <errorConditionFormula>AND( 
    NOT($User.ER_BypassVR__c),
    ER_Business_Unit__c =&apos;BENELUX&apos;,
    NOT(REGEX( MobilePhone,&quot;(^$)|^[+]?([0-9]*[/\\.\\s\\-\\(\\)]|[0-9]+){3,24}$&quot;)), 
    NOT( $Profile.Name = &quot;Integration Profile&quot;), 
    NOT(ISBLANK(MobilePhone)) 
    )</errorConditionFormula>
        <errorMessage>Please fill in a valid Mobile Phone number.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRBE08_Valid_Phone</fullName>
        <active>false</active>
        <description>This rule makes sure the Phone Number field follows a prescribed format.</description>
        <errorConditionFormula>AND(
    NOT($User.ER_BypassVR__c),
    ER_Business_Unit__c =&apos;BENELUX&apos;,
    NOT(REGEX( Phone ,&quot;(^$)|^[+]?([0-9]*[/\\.\\s\\-\\(\\)]|[0-9]+){3,24}$&quot;)), 
    NOT( $Profile.Name = &quot;Integration Profile&quot;), 
    NOT(ISBLANK(Phone)) 
    )</errorConditionFormula>
        <errorMessage>Pease fill in a valid phone number.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRBE09_PreferedLanguageMandatory</fullName>
        <active>true</active>
        <description>Prefered language should be mandatory for BENELUX</description>
        <errorConditionFormula>AND(
            NOT($User.ER_BypassVR__c),
            ER_Business_Unit__c =&apos;BENELUX&apos;,
            ISPICKVAL(ER_Language__c, &apos;&apos;)
            )</errorConditionFormula>
        <errorDisplayField>ER_Language__c</errorDisplayField>
        <errorMessage>Prefered Language is mandatory</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRBE10_Block_Update_Account_Sync</fullName>
        <active>true</active>
        <errorConditionFormula>NOT($User.ER_BypassVR__c)
            &amp;&amp; NOT(ISNEW())
            &amp;&amp; ISCHANGED(AccountId)
            &amp;&amp; NOT(ISBLANK( ER_Creation_date_in_OS__c ))</errorConditionFormula>
        <errorDisplayField>AccountId</errorDisplayField>
        <errorMessage>VRBE10 - The account name cannot be modified when the contact is synchronized</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRBE11_EmailMandatory</fullName>
        <active>true</active>
        <description>Email field should be mandatory for BENELUX</description>
        <errorConditionFormula>NOT($User.ER_BypassVR__c)
            &amp;&amp; ISPICKVAL(ER_BUPicklist__c, &apos;BENELUX&apos;)
            &amp;&amp; ISBLANK(Email)</errorConditionFormula>
        <errorDisplayField>Email</errorDisplayField>
        <errorMessage>VRBE11 - The email address is mandatory</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRBE12_Salutation_Mandatory</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
            ISPICKVAL(Salutation, &quot;&quot;),
            NOT($User.ER_BypassVR__c)
        )</errorConditionFormula>
        <errorDisplayField>Salutation</errorDisplayField>
        <errorMessage>Salutaion is mandatory</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRER01_Email_OR_PhoneNumber_required</fullName>
        <active>true</active>
        <description>Suggestion: E-mail or Phone/Mobilephone number must be a required field.</description>
        <errorConditionFormula>AND( 
NOT($User.ER_BypassVR__c), 
AND( 
Email == null, 
AND (Phone == null, MobilePhone == null) 
))</errorConditionFormula>
        <errorMessage>E-mail or Phone/Mobile phone number are required.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRER03_Contact_Mandatory_Fields</fullName>
        <active>true</active>
        <description>The field FirstName is mandatory.</description>
        <errorConditionFormula>AND(
NOT($User.ER_BypassVR__c),
OR(
ISBLANK (FirstName)))</errorConditionFormula>
        <errorDisplayField>FirstName</errorDisplayField>
        <errorMessage>The first name information is mandatory to create a contact</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRER04_Inactivation_Reason_Mandatory</fullName>
        <active>true</active>
        <description>When the Contact becomes inactive, the inactive reason becomes mandatory.</description>
        <errorConditionFormula>AND(
NOT($User.ER_BypassVR__c),
ISPICKVAL( ER_Status__c ,&apos;Inactive&apos; ),
ISBLANK( TEXT(ER_Inactive_Reason__c) ) 
)</errorConditionFormula>
        <errorMessage>The Inactivation Reason should be filled when the contact is Inactive</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRHU04_Mobile_Number_Hungarian_Format</fullName>
        <active>true</active>
        <description>This validation rule will control the phone number format to ensure it fit Hungarian format, as following : +36-11-111-1111 (mobile phones)</description>
        <errorConditionFormula>AND( 
NOT($User.ER_BypassVR__c),
ER_Business_Unit__c =&apos;HU&apos;,  
NOT( 
OR( 
LEN( MobilePhone ) = 0, 
REGEX( MobilePhone , &quot;[+36]{3}-[0-9]{2}-[0-9]{3}-[0-9]{4}&quot;) 
)))</errorConditionFormula>
        <errorDisplayField>MobilePhone</errorDisplayField>
        <errorMessage>The format of the Mobile Phone Number must be equal to Hungarian format, as following : 
+36-11-111-1111 (mobile phones)</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRHU05_Phone_Number_Hungarian_Format</fullName>
        <active>true</active>
        <description>This validation rule will control the phone number format to ensure it fit Hungarian format, as following : 
+36-1-111-1111 (capital city)
+36-11-111-111 (countryside)</description>
        <errorConditionFormula>AND( 
NOT($User.ER_BypassVR__c),
ER_Business_Unit__c =&apos;HU&apos;,  
NOT( 
OR( 
LEN(  Phone ) = 0, 
REGEX(  Phone , &quot;[+36]{3}-[0-9]{1}-[0-9]{3}-[0-9]{4}&quot;),
REGEX( Phone , &quot;[+36]{3}-[0-9]{2}-[0-9]{3}-[0-9]{3}&quot;) 
)))</errorConditionFormula>
        <errorDisplayField>Phone</errorDisplayField>
        <errorMessage>The format of the Phone Number must be equal to Hungarian format, as following : 
+36-1-111-1111 (capital city)
+36-11-111-111 (countryside)</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRHU10_Email_OR_PhoneNumber_required</fullName>
        <active>false</active>
        <description>Suggestion: E-mail or Phone/Mobilephone number must be a required field.</description>
        <errorConditionFormula>AND( 
NOT($User.ER_BypassVR__c), 
ER_Business_Unit__c =&apos;HU&apos;,   
AND(
Email == null,
AND (Phone == null, MobilePhone == null)  
))</errorConditionFormula>
        <errorMessage>E-mail or Phone/Mobile phone number are required.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRPL01_Email_Or_PhoneNumber_Required</fullName>
        <active>false</active>
        <description>E-mail or Phone/Mobilephone number must be filled in.</description>
        <errorConditionFormula>AND( 
NOT($User.ER_BypassVR__c),
ER_Business_Unit__c =&apos;PL&apos;, 
Email == null,
Phone == null,
MobilePhone == null 
)</errorConditionFormula>
        <errorMessage>E-mail or Phone/Mobile phone number are required.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRPL02_Check_Preferred_Language</fullName>
        <active>false</active>
        <errorConditionFormula>NOT($User.ER_BypassVR__c)
            &amp;&amp; ISPICKVAL(ER_BUPicklist__c, &quot;PL&quot;)
            &amp;&amp; NOT(ISPICKVAL(ER_Language__c, &quot;PL&quot;))
            &amp;&amp; NOT(ISPICKVAL(ER_Language__c, &quot;EN&quot;))
            &amp;&amp; NOT(ISPICKVAL(ER_Language__c, &quot;&quot;))</errorConditionFormula>
        <errorMessage>VRPL02 - The Preferred language can be one of the following values : Empty or &quot;PL&quot;</errorMessage>
    </validationRules>
    <webLinks>
        <fullName>GoogleMaps</fullName>
        <availability>online</availability>
        <displayType>link</displayType>
        <encodingKey>UTF-8</encodingKey>
        <hasMenubar>false</hasMenubar>
        <hasScrollbars>true</hasScrollbars>
        <hasToolbar>false</hasToolbar>
        <height>600</height>
        <isResizable>true</isResizable>
        <linkType>url</linkType>
        <masterLabel>Google Maps</masterLabel>
        <openType>newWindow</openType>
        <position>none</position>
        <protected>false</protected>
        <showsLocation>false</showsLocation>
        <showsStatus>false</showsStatus>
        <url>http://maps.google.com/maps?f=q&amp;hl=en&amp;q={!Contact_MailingStreet}+{!Contact_MailingCity}+{!Contact_MailingState}&amp;om=1</url>
    </webLinks>
    <webLinks>
        <fullName>GoogleSearch</fullName>
        <availability>online</availability>
        <displayType>link</displayType>
        <encodingKey>UTF-8</encodingKey>
        <hasMenubar>false</hasMenubar>
        <hasScrollbars>true</hasScrollbars>
        <hasToolbar>false</hasToolbar>
        <height>600</height>
        <isResizable>true</isResizable>
        <linkType>url</linkType>
        <masterLabel>Google Search</masterLabel>
        <openType>newWindow</openType>
        <position>none</position>
        <protected>false</protected>
        <showsLocation>false</showsLocation>
        <showsStatus>false</showsStatus>
        <url>http://www.google.com/search?q={!Contact_FirstName} {!Contact_LastName}</url>
    </webLinks>
</CustomObject>
