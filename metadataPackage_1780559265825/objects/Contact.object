    <fields>
        <fullName>Data_Quality_Description__c</fullName>
        <externalId>false</externalId>
        <formula>/* Initial formula
    IF( Data_Quality_Score__c =100,&quot;All Contact Details Captured&quot;, &quot;Missing: &quot;&amp;IF( LEN( Phone ) = 0, &quot;Phone, &quot;,&quot;&quot;)&amp;&quot;&quot;&amp;IF(LEN( Email) = 0, &quot;Email, &quot;,&quot;&quot;)&amp;&quot;&quot;&amp;IF( LEN( MailingStreet ) = 0, &quot;Complete Address, &quot;,&quot;&quot;)&amp;&quot;&quot;&amp;IF( LEN(Title) = 0, &quot;Job Title, &quot;,&quot;&quot;)&amp;&quot;&quot;&amp;IF( ISPICKVAL( Salutation,&quot;&quot;), &quot;Salutation&quot;,&quot;&quot;))
    */

    IF( Data_Quality_Score__c&gt;98,&quot;All Contact Details Captured&quot;, &quot;Missing: &quot;
    &amp;IF(OR(LEN(AccountId)=0,NOT(ISPICKVAL(Account.ER_Status__c,&quot;Active&quot;))),&quot;active Account, &quot;,&quot;&quot;)
    &amp;IF(LEN(Email)=0,&quot;Email, &quot;,&quot;&quot;)
    &amp;IF(ISPICKVAL(ER_Role__c,&quot;&quot;),&quot;Role, &quot;,&quot;&quot;)
    &amp;IF(LEN(FirstName)=0,&quot;FirstName, &quot;,&quot;&quot;)
    &amp;IF(LEN(LastName)=0,&quot;LastName, &quot;,&quot;&quot;)
    &amp;IF(LEN(Phone&amp;MobilePhone)=0,&quot;Phone, &quot;,&quot;&quot;)
    &amp;IF(ISPICKVAL(Salutation,&quot;&quot;),&quot;Salutation, &quot;,&quot;&quot;))</formula>
        <label>Data Quality Description</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Data_Quality_Score__c</fullName>
        <externalId>false</externalId>
        <formula>/* Initial formula
    IF( LEN( Phone) = 0, 0,20) + IF( LEN( Email) = 0, 0,20) + IF( LEN(MailingStreet) = 0, 0,20) + IF( LEN(Title) = 0, 0,20) + IF( ISPICKVAL(Salutation,&quot;&quot;), 0,20)
    */

    IF(OR(LEN(AccountId)=0,NOT(ISPICKVAL(Account.ER_Status__c,&quot;Active&quot;))),0,13.6363636363636) + IF(LEN(Email)=0,0,18.1818181818182) + IF(ISPICKVAL(ER_Role__c,&quot;&quot;),0,13.6363636363636) + IF(LEN(FirstName)&lt;=3,0,9.09090909090909) + IF(LEN(LastName)&lt;=3,0,9.09090909090909) + IF(LEN(Phone&amp;MobilePhone)=0,0,18.1818181818182) + IF(ISPICKVAL(Salutation,&quot;&quot;),0,9.09090909090909) + IF(LEN(Title)=0,0,9.09090909090909)</formula>
        <label>Data Quality Score</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <type>Number</type>
        <unique>false</unique>
    </fields>
