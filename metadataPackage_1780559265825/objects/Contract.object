    </recordTypes>
    <validationRules>
        <fullName>Blocking_Engagement_Fields</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
    ISPICKVAL(Status, &quot;Activated&quot;),
    NOT($User.ER_BypassVR__c),
    CONTAINS(Pricebook2.Name , &quot;Engagement&quot;),
    OR(
        ISCHANGED( ER_Customer_Domain__c ),
        ISCHANGED( ER_Onboarding_Method__c ),
        ISCHANGED( ER_Program_Name__c ),
        ISCHANGED(  ER_InvoicingFrequency2__c ),
        ISCHANGED(  Legacy_Catalogue__c ),
        ISCHANGED(   ER_Impacted_Beneficiaries__c ),
        ISCHANGED(    ER_Start_Date__c )
    )
)</errorConditionFormula>
        <errorMessage>You are not allowed to change this field as the Contract is Activated</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Customer_Domain</fullName>
        <active>true</active>
        <description>it must contain letters and/or digits only
its length must be between 3 and 100 characters</description>
        <errorConditionFormula>AND(

Not(Isnew()),
NOT($User.ER_BypassVR__c),
CONTAINS(Pricebook2.Name, &apos;Engagement&apos;),	
	NOT(ISBLANK(ER_Customer_Domain__c)),
NOT(
  AND(
    
    LEN(ER_Customer_Domain__c) &gt;= 3,
    LEN(ER_Customer_Domain__c) &lt;= 100,
    NOT(
      REGEX(
        ER_Customer_Domain__c,
        &quot;.*([/&apos;().: _$&amp;#@! é§èç{}à%ùäëüï]|\\[|\\]).*&quot;
      )
    )
  )
))</errorConditionFormula>
        <errorDisplayField>ER_Customer_Domain__c</errorDisplayField>
        <errorMessage>&quot;Customer Domain contains invalid characters. The following characters are not allowed: / &apos; . ( ) [ ] : _ $ &amp; # @ ! (space) é § è ç { } à % ù ä ë ü ï. The value must be between 3 and 100 characters.&quot;</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>CustomerDomainRequiredforEngagement</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
 NOT(isnew()),
  NOT($User.ER_BypassVR__c),
  CONTAINS( Pricebook2.Name , &apos;Engagement&apos;),
  NOT(ISPICKVAL(Status, &quot;Draft&quot;)),
  NOT(ISPICKVAL(Status, &quot;Terminated&quot;)),
  OR(
    ISBLANK(ER_Customer_Domain__c),
    ISBLANK(ER_Program_Name__c)
  )
)</errorConditionFormula>
        <errorMessage>Customer Domain and/or Program Name is required when the opportunity is for Engagement. Please select a value before proceeding.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>ImpactedBeneficiaries_Req_OSS_H_Contract</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
    NOT($User.ER_BypassVR__c),
				CONTAINS(Pricebook2.Name , &apos;Engagement&apos;), 

    OR(
        ISPICKVAL(ER_Onboarding_Method__c, &quot;OSS&quot;),
        ISPICKVAL(ER_Onboarding_Method__c, &quot;Hybrid&quot;)
    ),

    ISBLANK(TEXT(ER_Impacted_Beneficiaries__c))
)</errorConditionFormula>
        <errorMessage>Impacted Beneficiaries is required when Onboarding Method is OSS or Hybrid.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>OnboardingMethodReqEngagementContract</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
    NOT($User.ER_BypassVR__c),

    ISBLANK(TEXT(ER_Onboarding_Method__c)),

    CONTAINS(ER_OpportunityId__r.Pricebook2.Name, &quot;Engagement&quot;),

    NOT(
        ISPICKVAL(ER_OpportunityId__r.StageName, &quot;Qualification&quot;) ||
        ISPICKVAL(ER_OpportunityId__r.StageName, &quot;Need Analysis&quot;)
    )
)</errorConditionFormula>
        <errorMessage>Please select an Onboarding Method before saving this Contract.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Prevent_Invalid_Beneficiary_Selection</fullName>
        <active>true</active>
        <errorConditionFormula>And (
			NOT($User.ER_BypassVR__c),
				CONTAINS(Pricebook2.Name , &apos;Engagement&apos;),
AND(
				
    ISPICKVAL( ER_Onboarding_Method__c , &quot;Explicit Only&quot;),
    OR(
       ISPICKVAL( ER_Impacted_Beneficiaries__c  , &quot;All&quot;),
        ISPICKVAL( ER_Impacted_Beneficiaries__c  , &quot;TRE Only&quot;)
    )
))</errorConditionFormula>
        <errorDisplayField>ER_Impacted_Beneficiaries__c</errorDisplayField>
        <errorMessage>You cannot select &apos;All&apos; or &apos;TRE Only&apos; for Impacted Beneficiaries when the Onboarding Method is set to &apos;Explicit Only.&apos; Please choose a different option.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRBE01_PreventChange</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
            NOT($User.ER_BypassVR__c),
            ISPICKVAL( $User.ER_Business_Unit__c, &apos;BENELUX&apos;),
            OR( $Profile.Name = &apos;Client Sales&apos;,
            $Profile.Name = &apos;Marketing&apos;
            )
            )</errorConditionFormula>
        <errorMessage>You are not able to modify</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRER01_ActiveContractStartDate</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
            NOT($User.ER_BypassVR__c),
            ISPICKVAL(Status,&apos;Activated&apos;),
            ISCHANGED(StartDate)
            )</errorConditionFormula>
        <errorMessage>You cannot change the Start Date when the contract is Activated.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRER02_ContractStatus</fullName>
        <active>true</active>
        <errorConditionFormula>NOT($User.ER_BypassVR__c)
            &amp;&amp; ISCHANGED(Status)
            &amp;&amp; ((ISPICKVAL(Status, &apos;Terminated&apos;) &amp;&amp; (ISBLANK(ER_Terminated_Date__c)))
            || (ISPICKVAL(Status, &apos;Activated&apos;) &amp;&amp; NOT(ISPICKVAL(PRIORVALUE(Status), &apos;Draft&apos;)))
            || (ISPICKVAL(Status, &apos;Pending Termination&apos;) &amp;&amp; (NOT(ISPICKVAL(PRIORVALUE(Status), &apos;Activated&apos;))))
            )</errorConditionFormula>
        <errorMessage>You cannot perform this Action</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRER03_ContractEndDate</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
            NOT($User.ER_BypassVR__c),
            ISCHANGED(EndDate),
            NOT(ISBLANK(EndDate)),
            EndDate &lt;  StartDate
            )</errorConditionFormula>
        <errorMessage>The end date cannot be before the start date.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRER04_TerminationReasonMandatory</fullName>
        <active>true</active>
        <description>Mandatory when Contract End Date is not empty</description>
        <errorConditionFormula>NOT($User.ER_BypassVR__c)
&amp;&amp; ISBLANK(TEXT(ER_TerminationReason__c))
&amp;&amp; NOT(ISBLANK(EndDate))
&amp;&amp; ER_Contract_Type__c != &apos;Framework agreement&apos;</errorConditionFormula>
        <errorMessage>Please Capture the Termination Reason</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRER05_Credit_Limit_Mandatory</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
            NOT($User.ER_BypassVR__c),
            $RecordType.Name = &apos;Client Opportunity&apos;,
            ISBLANK(TEXT( ER_Credit_Limit2__c )),
            AND(NOT(ISBLANK( TEXT(ER_PaymentTerms2__c) )),
            NOT(TEXT(ER_PaymentTerms2__c)=&apos;Pre-paid&apos;))
            )</errorConditionFormula>
        <errorMessage>The field Credit Limit must be filled.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRER06_Prevent_Changing_Contract_Name</fullName>
        <active>false</active>
        <description>Prevent changing the Contract Name</description>
        <errorConditionFormula>NOT($User.ER_BypassVR__c)
            &amp;&amp;  ISCHANGED( Name )</errorConditionFormula>
        <errorMessage>You cannot change the Contract Name</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRER07_PreventChangingTerminationEndDate</fullName>
        <active>false</active>
        <description>Prevent changing the end date of a terminated contract</description>
        <errorConditionFormula>NOT($User.ER_BypassVR__c)
            &amp;&amp; (ISPICKVAL(Status, &apos;Pending Termination&apos;) || ISPICKVAL(Status, &apos;Terminated&apos;))
            &amp;&amp; ISCHANGED(EndDate)
            &amp;&amp; NOT(ISBLANK(PRIORVALUE(EndDate)))</errorConditionFormula>
        <errorMessage>You cannot change the End Date when the contract is Pending Termination or Terminated.</errorMessage>
    </validationRules>
    <webLinks>
        <fullName>Bulk_Contract_Activation</fullName>
        <availability>online</availability>
        <displayType>massActionButton</displayType>
        <encodingKey>UTF-8</encodingKey>
        <height>600</height>
        <linkType>url</linkType>
        <masterLabel>Bulk Contract Activation</masterLabel>
        <openType>sidebar</openType>
        <protected>false</protected>
        <requireRowSelection>true</requireRowSelection>
        <url>/flow/Bulk_Contract_Activation?retURL=/lightning/o/Contract/list</url>
    </webLinks>
</CustomObject>
