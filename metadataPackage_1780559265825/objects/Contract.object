    <fields>
        <fullName>Content_Visibility_Flag__c</fullName>
        <formula>IF( ER_OpportunityId__r.Content_Visibility_Flag__c = true
 || OwnerId = $User.Id || $Profile.Name = &apos;System Administrator&apos; || $Profile.Name  = &apos;Sales Operations&apos; , true, false)</formula>
        <label>Content Visibility Flag</label>
        <trackHistory>false</trackHistory>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Contract_Category__c</fullName>
        <externalId>false</externalId>
        <formula>IF(AND( Number_of_Benefit_Lines__c &gt;=1,  Number_of_Savings_Line__c =0), &quot;Benefits&quot;,  IF(AND (Number_of_Benefit_Lines__c =0,  Number_of_Savings_Line__c &gt;= 1), &quot;Engagement&quot;,  IF(AND (Number_of_Benefit_Lines__c &gt;=1,  Number_of_Savings_Line__c &gt;= 1), &quot;Benefits and Engagement&quot;, &quot;Services Only&quot;) ) )</formula>
        <label>Contract Category</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
