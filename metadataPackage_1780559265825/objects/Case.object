    </recordTypes>
    <validationRules>
        <fullName>VRBE07_Asset_Case_Spam</fullName>
        <active>true</active>
        <description>Asset information is obligatory if the case status doesn&apos;t equal &quot;Spam&quot;</description>
        <errorConditionFormula>AND( 
NOT($User.ER_BypassVR__c),
ER_Business_Unit__c =&apos;BENELUX&apos;,
RecordType.DeveloperName = &quot;ER_User_Case_RT&quot;, 
ISCHANGED( Status ),
ISBLANK ( AssetId ), 
NOT( 
ISPICKVAL( Status ,&quot;Spam&quot;)))</errorConditionFormula>
        <errorMessage>Information about Asset is obligatory in order to register the Case</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRER01_Case_CheckCaseReasonOnClose</fullName>
        <active>true</active>
        <description>When closing check if the fields &quot;Case Reason&quot; and &quot;Case Detailed Reason&quot; are not empty.</description>
        <errorConditionFormula>AND(
            NOT($User.ER_BypassVR__c),
            ISCHANGED(Status),
            OR(
            ISPICKVAL(Status, &quot;Resolved&quot; )
            ),
            ISPICKVAL(ER_Reason__c, &quot;&quot; ),
            ISPICKVAL(ER_CaseReason2__c, &quot;&quot; )
            )</errorConditionFormula>
        <errorMessage>These required fields must be completed: Case Reason, Case Detailed Reason</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRER02_Case_BusinessUnit</fullName>
        <active>false</active>
        <errorConditionFormula>AND(
            NOT($User.ER_BypassVR__c),
            TEXT(ER_BUPicklist__c) != TEXT($User.ER_Business_Unit__c),
            NOT(ISBLANK(ER_Business_Unit__c ))
            )</errorConditionFormula>
        <errorDisplayField>ER_BUPicklist__c</errorDisplayField>
        <errorMessage>You cannot use this Business Unit</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRER03_Asset_Case</fullName>
        <active>false</active>
        <description>Asset information is obligatory if the case reason equals &quot;Card&quot;</description>
        <errorConditionFormula>AND(RecordType.DeveloperName = &quot;ER_User_Case_RT&quot;,
            ISPICKVAL(ER_Reason__c ,&quot;ER_Card&quot;),
            ISBLANK (AssetId ),
            (NOT($User.ER_BypassVR__c)))</errorConditionFormula>
        <errorMessage>Information about Asset is obligatory in order to register the Case</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRER04_Case_Reopening</fullName>
        <active>false</active>
        <description>Case can be reopen only with the status &quot;Reopen&quot;.
            Case cannot be changed to &quot;New&quot; value.</description>
        <errorConditionFormula>AND(
                NOT($User.ER_BypassVR__c),
                OR(
                AND(
                ISCHANGED(Status),
                IsClosed,
                NOT(ISPICKVAL( Status ,&quot;Reopen&quot;))
                ),
                AND(
                ISCHANGED(Status),
                ISPICKVAL( Status ,&quot;New&quot;)
                ),
                AND(
                ISNEW(),
                ISPICKVAL( Status ,&quot;Reopen&quot;)
                )
                )
                )</errorConditionFormula>
        <errorDisplayField>Status</errorDisplayField>
        <errorMessage>Case status is not valid.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRER05_Case_Queue_BusinessUnit</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
NOT($User.ER_BypassVR__c),
            $Setup.ER_Validation_Rules_Settings__c.VRER05_Case_Queue_BusinessUnit__c = false,
            !ISNEW(),
            BEGINS(OwnerId, &quot;00G&quot;),
            ISCHANGED(OwnerId),
            AND(
            MID(Owner:Queue.Name, 3, 2) != $User.ER_BUText__c ,
            LEFT(Owner:Queue.Name, 2) != $User.ER_BUText__c
            )
            )</errorConditionFormula>
        <errorMessage>Cannot assign to a Queue that is not belonging to your BU</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRER06_Case_ContactAccountNotMatch</fullName>
        <active>true</active>
        <errorConditionFormula>AND(NOT($User.ER_BypassVR__c),NOT(ISBLANK(AccountId)),NOT(AccountId==Contact.AccountId))</errorConditionFormula>
        <errorDisplayField>ContactId</errorDisplayField>
        <errorMessage>Contact is not related to Account case</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRER07_Case_SpamStatus</fullName>
        <active>true</active>
        <description>Allow to change status to spam without mandatory fields</description>
        <errorConditionFormula>IF(
ISCHANGED(OwnerId),
false,
AND(
NOT($User.ER_BypassVR__c),
NOT(CONTAINS(RecordType.Name, &apos;User&apos;)),
NOT(ISPICKVAL(Status, &apos;Spam&apos;)),
ISBLANK(AccountId),
ISBLANK(ContactId),
NOT(ISBLANK(CreatedById)),
NOT(CONTAINS($User.Alias, &apos;ssyst&apos;)),
NOT(ISPICKVAL($User.ER_Business_Unit__c, &apos;ES&apos;)),
NOT(ISPICKVAL($User.ER_Business_Unit__c, &apos;FI&apos;)),
NOT(ISPICKVAL($User.ER_Business_Unit__c, &apos;SE&apos;))
)
)</errorConditionFormula>
        <errorMessage>Please fill the mandatory fields. &quot;Account Name&quot;, &quot;Contact Name&quot;.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRER08_AccountContactMandatory</fullName>
        <active>true</active>
        <description>Validation rule to make the fields Account and Contact mandatory to some BUs</description>
        <errorConditionFormula>AND(
 NOT($User.ER_BypassVR__c),
 NOT(CONTAINS($User.Alias, &apos;ssyst&apos;)), 
 NOT(CONTAINS(RecordType.Name, &apos;User&apos;)), 
 ISBLANK(AccountId), 
 ISBLANK(ContactId),  
 ISBLANK(CreatedById ), 
 NOT(ISPICKVAL(Owner:User.ER_Business_Unit__c,&apos;FI&apos;)),
 NOT(ISPICKVAL(Owner:User.ER_Business_Unit__c,&apos;SE&apos;)),
 NOT(ISPICKVAL(Owner:User.ER_Business_Unit__c,&apos;ES&apos;))
)</errorConditionFormula>
        <errorMessage>You have to fill the &quot;Account Name&quot; and &quot;Contact Name&quot; fields</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRER09_Smarter_UserCase_Reason_Mandatory</fullName>
        <active>true</active>
        <description>The Case reason should be mandatory on Smarter User Cases</description>
        <errorConditionFormula>NOT($User.ER_BypassVR__c)
&amp;&amp; ISPICKVAL(ER_BUPicklist__c, &apos;FR&apos;)
&amp;&amp; RecordType.DeveloperName = &apos;ER_User_Case_RT&apos;
&amp;&amp; ISPICKVAL(ER_Reason__c, &apos;&apos;)</errorConditionFormula>
        <errorMessage>VRER09 - The case reason is mandatory</errorMessage>
    </validationRules>
    <webLinks>
        <fullName>ER_Case_Accept</fullName>
        <availability>online</availability>
        <displayType>massActionButton</displayType>
        <height>600</height>
        <linkType>page</linkType>
        <masterLabel>Accept</masterLabel>
        <openType>sidebar</openType>
        <page>VFER02_Case_Accept</page>
        <protected>false</protected>
        <requireRowSelection>true</requireRowSelection>
    </webLinks>
</CustomObject>
