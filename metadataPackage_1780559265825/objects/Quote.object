    <fields>
        <fullName>ER_Is_Docusign_Deployed_BU__c</fullName>
        <formula>CONTAINS($CustomMetadata.Global_Settings__mdt.Docusign_Deployed_BUs.Valueforformula__c, &quot;;&quot; &amp; TEXT(ER_BUPicklist__c) &amp; &quot;;&quot;)
            || $CustomMetadata.Global_Settings__mdt.Docusign_Deployed_BUs.Valueforformula__c = &quot;ALL&quot;</formula>
        <label>Is Docusign Deployed BU</label>
        <trackHistory>false</trackHistory>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>ER_is_quote_expired__c</fullName>
        <formula>TODAY() &gt; ExpirationDate</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
