    <validationRules>
        <fullName>VRER01_Quote_CheckChangeStatus</fullName>
        <active>true</active>
        <description>Quote status management.
If denied ==&gt; cannot be changed
if accepted ==&gt; cannot change to Presented pr Draft</description>
        <errorConditionFormula>AND(
 NOT($User.ER_BypassVR__c),
 OR(
  AND(
   ISPICKVAL(PRIORVALUE( Status ) , &quot;Accepted&quot;),
   OR(
    ISPICKVAL( Status , &quot;Presented&quot;),
    ISPICKVAL( Status , &quot;Draft&quot;)
   )
  ),
  AND(
   ISPICKVAL(PRIORVALUE( Status ) , &quot;Denied&quot;),
   ISCHANGED(Status)
 )
 )
)</errorConditionFormula>
        <errorDisplayField>Status</errorDisplayField>
        <errorMessage>This status cannot be used !</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRER02_Quote_ClosedWonBlockEdit</fullName>
        <active>false</active>
        <description>When stage is set to “Closed won”, the opportunity record and related quotes cannot be edited.</description>
        <errorConditionFormula>AND( 
NOT($User.ER_BypassVR__c), 
TEXT(Opportunity.StageName)=&apos;Closed won&apos;, 
NOT( ISCHANGED( ContractId ) ) ,
NOT(ISCHANGED( LastModifiedDate )) 
)</errorConditionFormula>
        <errorMessage>When stage is set to “Closed won”, the opportunity record and related quotes cannot be edited.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRER03_Framework_Quote_Decision</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
NOT($User.ER_BypassVR__c),
   Opportunity.Account.ER_Decision_maker__c = false,
   ER_Quote_Type__c  = &apos;Framework agreement&apos;,
AND(ISCHANGED(Status), ISPICKVAL(Status, &apos;Accepted&apos;))
)</errorConditionFormula>
        <errorMessage>Framework agreements can only be created on “Decision maker” accounts</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRER04_Prevent_Changing_Quote_Name</fullName>
        <active>false</active>
        <description>Prevent changing the Quote Name</description>
        <errorConditionFormula>NOT($User.ER_BypassVR__c)
&amp;&amp;  ISCHANGED( Name )</errorConditionFormula>
        <errorMessage>You cannot change the Quote Name</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRER05_UseContactFromSameAccount</fullName>
        <active>false</active>
        <description>Validation rule to block the quote from having a contact different from account to which the quote belongs</description>
        <errorConditionFormula>AND(
				!$User.ER_BypassVR__c,
            Contact.AccountId != Null,
    NOT(
								OR(
				        Contact.AccountId = Opportunity.AccountId,
            Contact.AccountId = Opportunity.Account.ParentId,
            Contact.AccountId = Opportunity.Account.Parent.ParentId
								)
    )
)</errorConditionFormula>
        <errorDisplayField>ContactId</errorDisplayField>
        <errorMessage>Please choose a  Contact that belongs to the same Account or Account hierarchy</errorMessage>
    </validationRules>
