        <fullName>VRER01_CR_RecordTypeCompatibility</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
NOT( $User.ER_BypassVR__c ),
OR(
AND(
NOT(ISBLANK( ER_Financial_Center__c )),
OR(
AND(
ISPICKVAL(ER_Financial_Center__r.ER_Type__c,&apos;Merchant&apos;),
RecordType.DeveloperName  != &apos;ER_CR_Financial_Center_Merchant&apos;
),
AND(
ISPICKVAL(ER_Financial_Center__r.ER_Type__c,&apos;Client&apos;),
RecordType.DeveloperName  != &apos;ER_CR_Financial_Center_Client&apos;
)
)
),
AND(
NOT(ISBLANK( ER_Store__c )),
RecordType.DeveloperName  != &apos;ER_CR_Store&apos;
),
AND(
NOT(ISBLANK( ER_Delivery_Site__c)),
RecordType.DeveloperName  != &apos;ER_CR_Delivery_Site&apos;
),
AND(
NOT(ISBLANK( ER_Distribution_Point__c)),
RecordType.DeveloperName  != &apos;ER_CR_Distribution_Point&apos;
)
)
)</errorConditionFormula>
        <errorMessage>The selected RecordType is not compatible with parent record.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRER02_CR_ContactCompatibility</fullName>
        <active>true</active>
        <description>Check if the selected contact is available for the selected Parent.</description>
        <errorConditionFormula>AND(
NOT( $User.ER_BypassVR__c ),
OR(
AND(
NOT(ISBLANK(ER_Financial_Center__c )),
ER_Contact__r.AccountId != ER_Financial_Center__r.ER_Account_Name__c
),
AND(
NOT(ISBLANK(ER_Store__c)),
ER_Contact__r.AccountId != ER_Store__r.ER_Financial_Center__r.ER_Account_Name__c
),
AND(
NOT(ISBLANK(ER_Delivery_Site__c)),
ER_Contact__r.AccountId != ER_Delivery_Site__r.ER_Financial_Center__r.ER_Account_Name__c
),
AND(
NOT(ISBLANK(ER_Distribution_Point__c)),
ER_Contact__r.AccountId != ER_Distribution_Point__r.ER_Delivery_Site__r.ER_Financial_Center__r.ER_Account_Name__c
)
)
)</errorConditionFormula>
        <errorDisplayField>ER_Contact__c</errorDisplayField>
        <errorMessage>The selected contact not found at Account level.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRER03_CR_PreventChangeParentReference</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
Not( $User.ER_BypassVR__c ),
OR(
 ISCHANGED( ER_Distribution_Point__c  ),
 ISCHANGED( ER_Store__c ),
 ISCHANGED( ER_Financial_Center__c ), 
 ISCHANGED( ER_Delivery_Site__c ) 
)
)</errorConditionFormula>
        <errorMessage>You cannot Change parent reference.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRER04_CR_PrimaryContactEmail</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
NOT( $User.ER_BypassVR__c ),
ER_Primary__c,
ISBLANK(ER_Contact__r.Email)
)</errorConditionFormula>
        <errorDisplayField>ER_Contact__c</errorDisplayField>
        <errorMessage>The Primary contact must have an email address.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRER05_Status_Change_Undefined</fullName>
        <active>true</active>
        <description>Validation Rule to prevent users to empty the status</description>
        <errorConditionFormula>NOT($User.ER_BypassVR__c)
&amp;&amp; ISPICKVAL(ER_Status__c, &quot;&quot;)</errorConditionFormula>
        <errorMessage>Please choose either Active or Inactive for the contact role status.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRER06_block_Inactive_ctr_modification</fullName>
        <active>true</active>
        <description>Block the modification of an inactive contact role</description>
        <errorConditionFormula>NOT($User.ER_BypassVR__c)
&amp;&amp; ISPICKVAL(ER_Status__c, &quot;Inactive&quot;)
&amp;&amp; !ISCHANGED(ER_Status__c)
&amp;&amp; ER_Sync_Code__c != &apos;999&apos;</errorConditionFormula>
        <errorMessage>You cannot create or modify an inactive contact role</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRER07_Block_Primary_ctr_deactivation</fullName>
        <active>true</active>
        <description>Block the deactivation of a primary contact role</description>
        <errorConditionFormula>NOT($User.ER_BypassVR__c)
&amp;&amp; ISPICKVAL(ER_Status__c, &quot;Inactive&quot;)
&amp;&amp; ER_Primary__c = true</errorConditionFormula>
        <errorMessage>You cannot deactivate a primary contact role</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRER08_Block_Update_Contact_Sync</fullName>
        <active>true</active>
        <errorConditionFormula>NOT($User.ER_BypassVR__c)
&amp;&amp; NOT(ISNEW())
&amp;&amp; ISCHANGED(ER_Contact__c)
&amp;&amp; NOT(ISBLANK(ER_Creation_date_in_OS__c))</errorConditionFormula>
        <errorDisplayField>ER_Contact__c</errorDisplayField>
        <errorMessage>VRER08 - The contact cannot be modified when the contact role is synchronized</errorMessage>
    </validationRules>
</CustomObject>
