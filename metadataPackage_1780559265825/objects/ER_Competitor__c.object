    <validationRules>
        <fullName>ER01_Competitor_Lead_Or_Account</fullName>
        <active>true</active>
        <errorConditionFormula>NOT($User.ER_BypassVR__c) &amp;&amp; (ISNULL(ER_Lead__c )   ||  ISNULL(ER_Company__c))</errorConditionFormula>
        <errorMessage>Lead or Company should be populated.</errorMessage>
    </validationRules>
