    <label>Competitor</label>
    <nameField>
        <displayFormat>C-{0000}</displayFormat>
        <label>Competitor Name</label>
        <trackHistory>false</trackHistory>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Competitors</pluralLabel>
    <searchLayouts>
        <searchResultsAdditionalFields>ER_Company__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>ER_Competitor__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>ER_Description__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>ER_Opportunity__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>ER_Winner__c</searchResultsAdditionalFields>
