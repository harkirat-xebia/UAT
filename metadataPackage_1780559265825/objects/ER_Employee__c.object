    <listViews>
        <fullName>All</fullName>
        <columns>NAME</columns>
        <columns>ER_Client__c</columns>
        <columns>ER_ClientText__c</columns>
        <filterScope>Everything</filterScope>
        <label>All</label>
        <language>en_US</language>
    </listViews>
    <validationRules>
        <fullName>VRER001_Employee_FullName</fullName>
        <active>true</active>
        <description>Employee Full Name can&apos;t be modify</description>
        <errorConditionFormula>NOT($User.ER_BypassVR__c)
            &amp;&amp; $Setup.ER_Validation_Rules_Settings__c.VRER001_Employee_FullName__c = false
            &amp;&amp; ISCHANGED(Name)</errorConditionFormula>
        <errorMessage>You are not able to modify this value</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRER002_Employee_ScheduledDayForBlocking</fullName>
        <active>true</active>
        <description>&quot;Scheduled day for blocking&quot; is filled when Employee Status = &quot;to be deactivated&quot;</description>
        <errorConditionFormula>AND(
                NOT($User.ER_BypassVR__c), 
				ISPICKVAL(ER_Employee_Status__c,&apos;To be deactivated&apos;),
				ISBLANK( ERFI_Scheduled_day_for_blocking__c)
				)</errorConditionFormula>
        <errorMessage>You need to inform the Scheduled day for blocking</errorMessage>
    </validationRules>
</CustomObject>
