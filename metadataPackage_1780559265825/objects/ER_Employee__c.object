                </value>
                <value>
                    <fullName>Temporary employed</fullName>
                    <default>false</default>
                    <label>Temporary employed</label>
                </value>
            </valueSetDefinition>
            <valueSettings>
                <controllingFieldValue>Active</controllingFieldValue>
                <valueName>Full time</valueName>
            </valueSettings>
            <valueSettings>
                <controllingFieldValue>Active</controllingFieldValue>
                <valueName>On hold</valueName>
            </valueSettings>
            <valueSettings>
