        <fullName>User_EdenredPlus__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <label>User Edenred+</label>
        <lookupFilter>
            <active>true</active>
            <filterItems>
                <field>Account.IsPersonAccount</field>
                <operation>equals</operation>
                <value>True</value>
            </filterItems>
            <filterItems>
                <field>Account.RecordTypeId</field>
                <operation>equals</operation>
                <value>User Edenred+</value>
            </filterItems>
            <isOptional>false</isOptional>
        </lookupFilter>
        <referenceTo>Account</referenceTo>
        <relationshipLabel>Employees (Edenred+)</relationshipLabel>
        <relationshipName>UserEdenredPlusEmployees</relationshipName>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
