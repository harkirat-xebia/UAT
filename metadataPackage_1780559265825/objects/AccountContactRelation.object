<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionOverrides>
        <actionName>CancelEdit</actionName>
        <type>Default</type>
    </actionOverrides>
    <actionOverrides>
        <actionName>CancelEdit</actionName>
        <formFactor>Large</formFactor>
        <type>Default</type>
    </actionOverrides>
    <actionOverrides>
        <actionName>CancelEdit</actionName>
        <formFactor>Small</formFactor>
        <type>Default</type>
    </actionOverrides>
    <actionOverrides>
        <actionName>SaveEdit</actionName>
        <type>Default</type>
    </actionOverrides>
    <actionOverrides>
        <actionName>SaveEdit</actionName>
        <formFactor>Large</formFactor>
        <type>Default</type>
    </actionOverrides>
    <actionOverrides>
        <actionName>SaveEdit</actionName>
        <formFactor>Small</formFactor>
        <type>Default</type>
    </actionOverrides>
    <compactLayoutAssignment>SYSTEM</compactLayoutAssignment>
    <enableFeeds>false</enableFeeds>
    <fields>
        <fullName>AccountId</fullName>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>ContactId</fullName>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>EndDate</fullName>
    </fields>
    <fields>
        <fullName>ER_Card_Operational_System_ID__c</fullName>
        <caseSensitive>false</caseSensitive>
        <externalId>true</externalId>
        <label>Card Operational System ID</label>
        <length>255</length>
        <required>false</required>
        <type>Text</type>
        <unique>true</unique>
    </fields>
    <fields>
        <fullName>ER_First_Login_Date__c</fullName>
        <label>First Login Date</label>
        <required>false</required>
        <type>DateTime</type>
    </fields>
    <fields>
        <fullName>ER_Last_Login_Date__c</fullName>
        <label>Last Login Date</label>
        <required>false</required>
        <type>DateTime</type>
    </fields>
    <fields>
        <fullName>ER_Smarter_1st_Sync_Date__c</fullName>
        <label>Smarter 1st Sync Date</label>
        <required>false</required>
        <type>DateTime</type>
    </fields>
    <fields>
        <fullName>ER_Smarter_Last_Sync_Date__c</fullName>
        <label>Smarter Last Sync Date</label>
        <required>false</required>
        <type>DateTime</type>
    </fields>
    <fields>
        <fullName>ER_Smarter_Sync_Error__c</fullName>
        <label>Smarter Sync Error</label>
        <required>false</required>
        <type>TextArea</type>
    </fields>
    <fields>
        <fullName>ER_Smarter_Sync_Status__c</fullName>
        <label>Smarter Sync Status</label>
        <required>false</required>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetName>ER_Sync_result</valueSetName>
        </valueSet>
    </fields>
    <fields>
        <fullName>IsActive</fullName>
    </fields>
    <fields>
        <fullName>IsDirect</fullName>
    </fields>
    <fields>
        <fullName>OCR_Link_Key__c</fullName>
        <label>OCR Link Key</label>
        <required>false</required>
        <type>TextArea</type>
    </fields>
    <fields>
        <fullName>Relationship_Strength__c</fullName>
        <label>Relationship Strength</label>
        <required>false</required>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Strong</fullName>
                    <default>false</default>
                    <label>Strong</label>
                </value>
                <value>
                    <fullName>Neutral</fullName>
                    <default>false</default>
                    <label>Neutral</label>
                </value>
                <value>
                    <fullName>Weak</fullName>
                    <default>false</default>
                    <label>Weak</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Roles</fullName>
        <type>Picklist</type>
    </fields>
    <fields>
        <fullName>StartDate</fullName>
    </fields>
    <validationRules>
        <fullName>VRER01_BLOCK_NON_SMARTER</fullName>
        <active>false</active>
        <errorConditionFormula>NOT($User.ER_BypassVR__c)
&amp;&amp; NOT(Account.ER_SmartER_Context__c) 
&amp;&amp; NOT(Contact.ER_SmartER_Context__c)
&amp;&amp; NOT(IsDirect)</errorConditionFormula>
        <errorMessage>VRER01 - This feature is available only for smarter context.</errorMessage>
    </validationRules>
</CustomObject>
