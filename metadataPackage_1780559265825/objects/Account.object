        <complianceGroup>GDPR</complianceGroup>
        <externalId>false</externalId>
        <formula>IF(ER_VIP__c=true,IMAGE(&apos;/resource/VIPFlag&apos;,&apos;VIPLogo&apos;,30,30),&quot;&quot;)</formula>
        <label>VIPLogo</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>ER_WS_result__c</fullName>
        <externalId>false</externalId>
        <formula>CASE(ER_Sync_result__c, 
                &quot;1&quot;, IMAGE(&quot;/resource/SRER01_WebServiceHandler/Success_Img.png&quot;, &quot;Success&quot;,40,40), 
                &quot;2&quot;, IMAGE(&quot;/resource/SRER01_WebServiceHandler/Error_Img.png&quot;, &quot;Error&quot;,40,40),
                &quot;&quot;)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Sync Status</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
