    <fields>
        <fullName>Data_Quality_Description__c</fullName>
        <externalId>false</externalId>
        <formula>/* initial formula
IF( Data_Quality_Score__c =100,&quot;All Account Details Captured&quot;, &quot;Missing: &quot;&amp;IF( ISPICKVAL( Industry,&quot;&quot;),&quot;Industry, &quot;,&quot;&quot;)&amp;&quot;&quot;&amp;IF(ISPICKVAL(Rating,&quot;&quot;), &quot;Rating, &quot;,&quot;&quot;)&amp;&quot;&quot;&amp;IF( LEN(BillingCity) = 0, &quot;Complete Address, &quot;,&quot;&quot;)&amp;&quot;&quot;&amp;IF( LEN(Phone) = 0, &quot;Phone, &quot;,&quot;&quot;)&amp;&quot;&quot;&amp;IF( ISPICKVAL(Type,&quot;&quot;), &quot;Type&quot;,&quot;&quot;)) */


IF( Data_Quality_Score__c&gt;98

,&quot;All Account Details Captured&quot;

, &quot;Missing: &quot;&amp;
IF(LEN(BillingCity)=0,&quot;Legal Address, &quot;,&quot;&quot;)
&amp; IF(AND(NOT(ISPICKVAL(ER_Local_Merchant_Segmentation__c,&quot;&quot;)),ISPICKVAL(ER_Global_Segmentation__c,&quot;&quot;)),&quot;Global Segmentation, &quot;,&quot;&quot;)
&amp; IF(AND(ISPICKVAL(ER_Local_Merchant_Segmentation__c,&quot;&quot;),ISPICKVAL(ER_Segment__c,&quot;&quot;)),&quot;Local Client or Merchant Segmentation, &quot;,&quot;&quot;)
&amp; IF(LEN(ER_NaceList__c)=0,&quot;Code NACE, &quot;,&quot;&quot;)
&amp; IF(LEN(ER_Registration_Number__c&amp;ER_VAT_Number__c&amp;ER_Other_Fiscal_ID__c)=0,&quot;CRN and VAT, &quot;,&quot;&quot;)
)</formula>
        <label>Data Quality Description</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Data_Quality_Score__c</fullName>
        <externalId>false</externalId>
        <formula>/* initial formula
IF( ISPICKVAL(Industry,&quot;&quot;), 0,20) + IF( ISPICKVAL(Rating,&quot;&quot;), 0,20) + IF( LEN(BillingCity) = 0, 0,20) + IF(LEN(Phone) = 0, 0,20) + IF( ISPICKVAL(Type,&quot;&quot;), 0,20) */

IF(LEN(BillingCity)=0,0,27.2727272727273) + IF(AND(NOT(ISPICKVAL(ER_Local_Merchant_Segmentation__c,&quot;&quot;)),ISPICKVAL(ER_Global_Segmentation__c,&quot;&quot;)),0,9.09090909090909) + IF(AND(ISPICKVAL(ER_Local_Merchant_Segmentation__c,&quot;&quot;),ISPICKVAL(ER_Segment__c,&quot;&quot;)),0,27.2727272727273) + IF(LEN(ER_NaceList__c)=0,0,9.09090909090909) + IF(LEN(ER_Registration_Number__c&amp;ER_VAT_Number__c&amp;ER_Other_Fiscal_ID__c)=0,0,27.2727272727273)</formula>
        <label>Data Quality Score</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Description</fullName>
        <complianceGroup>GDPR</complianceGroup>
        <inlineHelpText>VISIBLE BY RECIPIENT :VISIBLE BY RECIPIENT :Make sure your comments are objective, adequate, and limited to what is strictly necessary. They must not contain sensitive data (e.g., in relation to health/medical, religion, political opinions, racial or ethnic origins, etc.) or data related to the commission of criminal offences. Appropriate and respectful language is expected</inlineHelpText>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
    </fields>
