    <fields>
        <fullName>ER_Insolvency_Executed_Account__c</fullName>
        <defaultValue>false</defaultValue>
        <label>Insolvency/Executed Account</label>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>ER_Is_Credit_Score_Deployed_BU__c</fullName>
        <formula>CONTAINS($CustomMetadata.Global_Settings__mdt.CreditScoring_Deployed_BUs.Valueforformula__c, &quot;;&quot; &amp; TEXT(ER_BUPicklist__c) &amp; &quot;;&quot;)
            || $CustomMetadata.Global_Settings__mdt.CreditScoring_Deployed_BUs.Valueforformula__c = &quot;ALL&quot;</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>is Credit Score Deployed BU</label>
        <trackHistory>false</trackHistory>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>ER_Is_Public_Register_Deployed_BU__c</fullName>
        <formula>CONTAINS($CustomMetadata.Global_Settings__mdt.Public_Register_Deployed_BUs.Valueforformula__c, &quot;;&quot; &amp; TEXT(ER_BUPicklist__c) &amp; &quot;;&quot;)
|| $CustomMetadata.Global_Settings__mdt.Public_Register_Deployed_BUs.Valueforformula__c = &quot;ALL&quot;</formula>
        <label>Is Public Register Deployed BU</label>
        <trackHistory>false</trackHistory>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>ER_Language__c</fullName>
        <complianceGroup>PII;GDPR</complianceGroup>
        <label>Language</label>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>true</trackHistory>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetName>ER_Language</valueSetName>
        </valueSet>
    </fields>
    <fields>
        <fullName>ER_Last_Credit_Scoring_Update__c</fullName>
        <label>Last Credit Scoring Update</label>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>ER_Last_date_of_Sync__c</fullName>
        <description>which hold the latest date/time when info was sent to the OS</description>
        <label>Last date of Sync</label>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>DateTime</type>
    </fields>
    <fields>
        <fullName>ER_Last_Modified_By_Functional_user__c</fullName>
        <complianceGroup>PII;GDPR</complianceGroup>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>Last Modified by a functional user</description>
        <label>Last Modified By Functional user</label>
        <referenceTo>User</referenceTo>
        <relationshipName>Accounts</relationshipName>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>ER_Last_Modified_Date_Functional_User__c</fullName>
        <complianceGroup>PII;GDPR</complianceGroup>
        <label>Last Modified Date Functional User</label>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>DateTime</type>
    </fields>
    <fields>
        <fullName>ER_Last_Transaction_date__c</fullName>
        <label>Last Transaction date</label>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>ER_Last_Visit_Date__c</fullName>
        <description>Related to the event visit</description>
        <label>Last Visit Date</label>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>DateTime</type>
    </fields>
    <fields>
        <fullName>ER_LastModifiedBy__c</fullName>
        <complianceGroup>PII;GDPR</complianceGroup>
        <externalId>false</externalId>
        <formula>IF ( DATEVALUE(LastModifiedDate) &gt;= DATE ( YEAR (DATEVALUE(LastModifiedDate)),3,1)
            +
            ( 14 - CASE( MOD(DATE ( YEAR (DATEVALUE(LastModifiedDate)),3,1) - DATE (1900,1,7),7) ,
            0,7,MOD(DATE ( YEAR (DATEVALUE(LastModifiedDate)),3,1) - DATE (1900,1,7),7))
            )

            &amp;&amp;

            DATEVALUE(LastModifiedDate) &lt; DATE ( YEAR (DATEVALUE(LastModifiedDate)),11,1) +
            (
            7-
            CASE( MOD(DATE ( YEAR (DATEVALUE(LastModifiedDate)),11,1) - DATE (1900,1,7),7) ,
            0,7,MOD(DATE ( YEAR (DATEVALUE(LastModifiedDate)),11,1) - DATE (1900,1,7),7))
            ),

            /*check if the last modified by is filled */
            IF(ER_Last_Modified_By_Functional_user__c != null, 

            /* if true */

            HYPERLINK(LEFT($Api.Partner_Server_URL_420, FIND( &apos;/services&apos;, $Api.Partner_Server_URL_420)) + 
            &apos;/lightning/r/User/&apos; + ER_Last_Modified_By_Functional_user__c + &apos;/view&apos;,ER_Last_Modified_By_Functional_user__r.FirstName  + &apos; &apos; + ER_Last_Modified_By_Functional_user__r.LastName) +  &apos;, &apos; + 
            TEXT(DAY(DATEVALUE(ER_Last_Modified_Date_Functional_User__c + 2/24))) + &apos;/&apos; +  
            TEXT(MONTH(DATEVALUE(ER_Last_Modified_Date_Functional_User__c + 2/24))) + &apos;/&apos; + 
            TEXT(YEAR(DATEVALUE(ER_Last_Modified_Date_Functional_User__c + 2/24))) + &apos; &apos; +  
            TEXT(HOUR(TIMEVALUE(ER_Last_Modified_Date_Functional_User__c + 2/24))) + &apos;:&apos; +  
            TEXT(MINUTE(TIMEVALUE(ER_Last_Modified_Date_Functional_User__c + 2/24))), 

            /* else */
            &apos;&apos;) 

            ,


            /*check if the last modified by is filled */
            IF(ER_Last_Modified_By_Functional_user__c != null, 

            /* if true */

            HYPERLINK(LEFT($Api.Partner_Server_URL_420, FIND( &apos;/services&apos;, $Api.Partner_Server_URL_420)) + 
            &apos;/lightning/r/User/&apos; + ER_Last_Modified_By_Functional_user__c + &apos;/view&apos;,ER_Last_Modified_By_Functional_user__r.FirstName + &apos; &apos; + ER_Last_Modified_By_Functional_user__r.LastName) +  &apos;, &apos; + 
            TEXT(DAY(DATEVALUE(ER_Last_Modified_Date_Functional_User__c+ 1/24))) + &apos;/&apos; +  
            TEXT(MONTH(DATEVALUE(ER_Last_Modified_Date_Functional_User__c+ 1/24))) + &apos;/&apos; + 
            TEXT(YEAR(DATEVALUE(ER_Last_Modified_Date_Functional_User__c+ 1/24))) + &apos; &apos; +  
            TEXT(HOUR(TIMEVALUE(ER_Last_Modified_Date_Functional_User__c+ 1/24))) + &apos;:&apos; +  
            TEXT(MINUTE(TIMEVALUE(ER_Last_Modified_Date_Functional_User__c+ 1/24))), 

            /* else */
            &apos;&apos;)

            )</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Last Modified By Functional User</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
