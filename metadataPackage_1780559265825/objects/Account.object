    </recordTypes>
    <validationRules>
        <fullName>ERRO01_Prevent_Person_Account_Changing</fullName>
        <active>true</active>
        <description>Prevent Ro users to modify or create any person account.</description>
        <errorConditionFormula>NOT(ISCHANGED( ER_VIP__pc ) ) &amp;&amp; NOT($User.ER_BypassVR__c)
                    &amp;&amp; $Setup.ER_Validation_Rules_Settings__c.ERRO01_Prevent_Person_Account_Changing__c = false
                    &amp;&amp; IsPersonAccount
                    &amp;&amp; ISPICKVAL($User.ER_Business_Unit__c, &quot;RO&quot;)</errorConditionFormula>
        <errorMessage>You are not able to modify</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Inactive_Reason_On_Account_Deactivation</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
    ISPICKVAL(ER_Status__c , &quot;Inactive&quot;),
    ISBLANK(TEXT(ER_Inactive_Reason__c))
)</errorConditionFormula>
        <errorMessage>Inactive reason must be filled</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Restrict_BusinessUnit_Value</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
NOT($User.ER_BypassVR__c),
ISCHANGED(ER_BUPicklist__c),
NOT(
OR(
ISPICKVAL(ER_BUPicklist__c, &quot;BE&quot;),
ISPICKVAL(ER_BUPicklist__c, &quot;LU&quot;)
)
)
)</errorConditionFormula>
        <errorDisplayField>ER_BUPicklist__c</errorDisplayField>
        <errorMessage>Please select either &apos;Belgium&apos; or &apos;Luxemburg&apos; as the Business Unit. Other values are not allowed.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Restrict_Owner_Change_For_Sales_Rep</fullName>
        <active>false</active>
        <errorConditionFormula>AND(
  ISCHANGED(OwnerId),
  $Profile.Name = &quot;Sales Rep&quot;
)</errorConditionFormula>
        <errorMessage>You are not allowed to change the owner of this record.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Validate_VAT_Number_Format</fullName>
        <active>false</active>
        <errorConditionFormula>IF($User.ER_BypassVR__c  = false &amp;&amp; NOT(ISBLANK(ER_VAT_Number__c)) &amp;&amp; NOT( REGEX(ER_VAT_Number__c, &quot;^BE[0-1]{1}[0-9]{9}$&quot;) || REGEX(ER_VAT_Number__c, &quot;^LU[0-9]{8}$&quot;) ), true, false)</errorConditionFormula>
        <errorMessage>Please enter a valid VAT Number.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VAT_Number_Format_By_Country</fullName>
        <active>false</active>
        <errorConditionFormula>IF(
    AND(
        NOT($User.ER_BypassVR__c),
        NOT(ISBLANK(ER_VAT_Number__c)),
        NOT(
            REGEX(ER_VAT_Number__c, &quot;^DE[0-9]{9}$&quot;) ||  
            REGEX(ER_VAT_Number__c, &quot;^ATU[0-9]{8}$&quot;) ||  
            REGEX(ER_VAT_Number__c, &quot;^BE[0-9]{10}$&quot;) ||  
            REGEX(ER_VAT_Number__c, &quot;^BG[0-9]{9,10}$&quot;) ||  
            REGEX(ER_VAT_Number__c, &quot;^CY[0-9]{8}[A-Z]$&quot;) ||  
            REGEX(ER_VAT_Number__c, &quot;^HR[0-9]{11}$&quot;) ||  
            REGEX(ER_VAT_Number__c, &quot;^DK[0-9]{8}$&quot;) ||  
            REGEX(ER_VAT_Number__c, &quot;^ES[0-9A-Z][0-9]{7}[0-9A-Z]$&quot;) ||  
            REGEX(ER_VAT_Number__c, &quot;^EE[0-9]{9}$&quot;) ||  
            REGEX(ER_VAT_Number__c, &quot;^FI[0-9]{8}$&quot;) ||  
            REGEX(ER_VAT_Number__c, &quot;^FR[0-9A-Z]{2}[0-9]{9}$&quot;) ||  
            REGEX(ER_VAT_Number__c, &quot;^EL[0-9]{9}$&quot;) ||  
            REGEX(ER_VAT_Number__c, &quot;^HU[0-9]{8}$&quot;) ||  
            REGEX(ER_VAT_Number__c, &quot;^IE[0-9]{7}[A-Z]{1}[0-9]{1}$&quot;) ||  
            REGEX(ER_VAT_Number__c, &quot;^IT[0-9]{11}$&quot;) ||  
            REGEX(ER_VAT_Number__c, &quot;^LV[0-9]{11}$&quot;) ||  
            REGEX(ER_VAT_Number__c, &quot;^LT[0-9]{9,12}$&quot;) ||  
            REGEX(ER_VAT_Number__c, &quot;^LU[0-9]{8}$&quot;) ||  
            REGEX(ER_VAT_Number__c, &quot;^MT[0-9]{8}$&quot;) ||  
            REGEX(ER_VAT_Number__c, &quot;^NL[0-9]{9}B[0-9]{2}$&quot;) ||  
            REGEX(ER_VAT_Number__c, &quot;^PL[0-9]{10}$&quot;) ||  
            REGEX(ER_VAT_Number__c, &quot;^PT[0-9]{9}$&quot;) ||  
            REGEX(ER_VAT_Number__c, &quot;^CZ[0-9]{8,10}$&quot;) ||  
            REGEX(ER_VAT_Number__c, &quot;^RO[0-9]{2,10}$&quot;) ||  
            REGEX(ER_VAT_Number__c, &quot;^SK[0-9]{10}$&quot;) ||  
            REGEX(ER_VAT_Number__c, &quot;^SI[0-9]{8}$&quot;) ||  
            REGEX(ER_VAT_Number__c, &quot;^SE[0-9]{12}$&quot;) ||  
            REGEX(ER_VAT_Number__c, &quot;^GB[0-9]{9}$&quot;) ||  
            REGEX(ER_VAT_Number__c, &quot;^GB[0-9]{12}$&quot;) ||  
            REGEX(ER_VAT_Number__c, &quot;^GBGD[0-9]{3}$&quot;) ||  
            REGEX(ER_VAT_Number__c, &quot;^GBHA[0-9]{3}$&quot;) ||
            REGEX(ER_VAT_Number__c, &quot;^BE[0-1]{1}[0-9]{9}$&quot;) ||
            REGEX(ER_VAT_Number__c, &quot;^LU[0-9]{8}$&quot;) 
        )
    ),
    true,
    false
)</errorConditionFormula>
        <errorMessage>Invalid VAT Number format. Please enter a valid VAT Number based on the country-specific format.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VR_LegalName_HeadOfficeContact_Mandatory</fullName>
        <active>true</active>
        <description>The Legal Name and Head Office Contact fields are mandatory for account sync
                    This Validation rule is used for the following BUs:
                    - BENELUX</description>
        <errorConditionFormula>NOT($User.ER_BypassVR__c)
                    &amp;&amp; ISPICKVAL(ER_BUPicklist__c, &apos;BENELUX&apos;)
                    &amp;&amp; NOT(ISBLANK(ER_Creation_date_in_OS__c))
                    &amp;&amp; (ISBLANK(ER_Legal_Name__c) || ISBLANK(HU_HQ_Contact__c))</errorConditionFormula>
        <errorMessage>Legal Name and Head Office Contact are mandatory for synced accounts</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRBE01_Limit_Chars_of_Name</fullName>
        <active>true</active>
        <description>This rule limit the number of char in the standard field Name.</description>
        <errorConditionFormula>AND(
								NOT($User.ER_BypassVR__c),
								ISPICKVAL(ER_BUPicklist__c, &apos;BENELUX&apos;),
                                NOT(Recordtype_Name__c = &apos;Aggregator_Merchant&apos;),
								LEN(Name) &gt; 50)</errorConditionFormula>
        <errorMessage>The number of character of the name must be less or equal to 50.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRBE02_Valid_Phone</fullName>
        <active>false</active>
        <description>This rule makes sure the Phone Number field follows a prescribed format.</description>
        <errorConditionFormula>NOT($User.ER_BypassVR__c)
		&amp;&amp; $Setup.ER_Validation_Rules_Settings__c.VRBE02_Valid_Phone__c = false
		&amp;&amp; ISPICKVAL(ER_Country_Code__c, &apos;BE&apos;)
		&amp;&amp; NOT(ISBLANK(Phone))
		&amp;&amp; NOT(REGEX( Phone ,&quot;(^$)|^[+]?([0-9]*[/\\.\\s\\-\\(\\)]|[0-9]+){3,24}$&quot;))</errorConditionFormula>
        <errorMessage>Please fill in a valid phone number</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRBE03_Valid_VATnr</fullName>
        <active>true</active>
        <description>Enter the VAT number in the correct format.</description>
        <errorConditionFormula>NOT($User.ER_BypassVR__c)
                    &amp;&amp; $Setup.ER_Validation_Rules_Settings__c.VRBE03_Valid_VATnr__c = false
                    &amp;&amp; ISPICKVAL(ER_BUPicklist__c, &apos;BENELUX&apos;)
                    &amp;&amp; RecordType.DeveloperName != &apos;ER_Competitor&apos;
                    &amp;&amp; NOT(ISBLANK(ER_VAT_Number__c))
                    &amp;&amp; ( (IF( LEFT(ER_VAT_Number__c, 2) = &apos;BE&apos;, NOT(REGEX(ER_VAT_Number__c, &quot;BE[0-1]{1}[0-9]{9}&quot;)), FALSE))
                    || (IF(LEFT(ER_VAT_Number__c, 2) = &apos;LU&apos;,
                    NOT(REGEX(ER_VAT_Number__c, &quot;LU[0-9]{8}&quot;)) || MOD(VALUE(LEFT(RIGHT(ER_VAT_Number__c, 8), 6)), 89) != VALUE(RIGHT(ER_VAT_Number__c ,2)), FALSE))
                    )</errorConditionFormula>
        <errorMessage>VRBE03 - Please enter the VAT number in the correct format.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRBE05_VAT_Not_Blank</fullName>
        <active>true</active>
        <description>If Subject to VAT, VAT must be filled.</description>
        <errorConditionFormula>NOT($User.ER_BypassVR__c)
		&amp;&amp; $Setup.ER_Validation_Rules_Settings__c.VRBE05_VAT_Not_Blank__c = False
		&amp;&amp; ISPICKVAL(ER_BUPicklist__c, &apos;BENELUX&apos;)
		&amp;&amp; RecordType.DeveloperName != &apos;ER_Competitor&apos;
		&amp;&amp; NOT(ER_Not_subject_to_VAT__c)
		&amp;&amp; ISBLANK(ER_VAT_Number__c)</errorConditionFormula>
        <errorMessage>VRBE05 - The VAT Number must be filled if the Company is subject to VAT.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRBE06_Valid_Company_Reg_Nb</fullName>
        <active>true</active>
        <description>Enter the Company Registration Number in the correct format.</description>
        <errorConditionFormula>NOT($User.ER_BypassVR__c)
		&amp;&amp; ISPICKVAL(ER_BUPicklist__c, &apos;BENELUX&apos;)
		&amp;&amp;  CONTAINS(ER_Registration_Number__c , &quot;.&quot;)</errorConditionFormula>
        <errorMessage>VRBE06 - Please enter the Company Registration Number in the correct format.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRBENELUX02_Block_Update_Legal_Add_Sync</fullName>
        <active>true</active>
        <description>The Legal address for Benelux countries cannot be empty when the account is synchronized</description>
        <errorConditionFormula>NOT($User.ER_BypassVR__c)
                    &amp;&amp; NOT(ISNEW())
                    &amp;&amp; ISPICKVAL(ER_BUPicklist__c, &apos;BENELUX&apos;)
                    &amp;&amp; NOT(ISBLANK(ER_Creation_date_in_OS__c))
                    &amp;&amp; (
                    ISBLANK(BillingStreet) ||
                    ISBLANK(BillingCity) ||
                    ISBLANK(BillingCountry) ||
                    ISBLANK(BillingPostalCode)
                    )</errorConditionFormula>
        <errorMessage>VRBENELUX02 - The Legal address cannot be empty when the account is synchronized</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRCZ01_CRN_FORMAT_VALIDATION</fullName>
        <active>true</active>
        <description>If BU = CZ

        Country code = CZ the CRN , if not empty, must be with 8 characters long with only numbers</description>
        <errorConditionFormula>NOT($User.ER_BypassVR__c)
        &amp;&amp; ISPICKVAL(ER_BUPicklist__c, &apos;CZ&apos;)
        &amp;&amp; NOT(ISBLANK(ER_Registration_Number__c))
        &amp;&amp; NOT(REGEX(ER_Registration_Number__c, &quot;^[0-9]{8}$&quot;))</errorConditionFormula>
        <errorMessage>VRCZ01 - CRN must be 8 characters long with only numbers</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRER01_CompanyRegistrationNumber_or_Vat</fullName>
        <active>true</active>
        <description>VAT Number or Company Registration Number or Other Fiscal ID are obligatory on the account</description>
        <errorConditionFormula>AND(
                    NOT($User.ER_BypassVR__c),
                    NOT(IsPersonAccount),
                    ISBLANK(ER_VAT_Number__c),
                    ISBLANK( ER_Registration_Number__c),
                    ISBLANK( ER_Other_Fiscal_ID__c),
                    RecordType.Name = &apos;Company&apos;
                    )</errorConditionFormula>
        <errorMessage>Filling VAT Number or Company Registration Number or Other Fiscal ID is mandatory.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRER02_Prevent_Person_Account_Changing</fullName>
        <active>true</active>
        <description>Prevent changes on Individual for Customer Services, execpts for Finland if they try to modify certain fields.</description>
        <errorConditionFormula>NOT(ISCHANGED( ER_VIP__pc ) ) &amp;&amp;  AND(
NOT($User.ER_BypassVR__c),
$Profile.Name = &apos;Customer Service&apos;,
IsPersonAccount,
IF(
AND(
$User.ER_BUText__c = &apos;FI&apos;,
OR(
ISCHANGED(PersonEmail),
ISCHANGED(PersonMailingAddress),
ISCHANGED(PersonMailingPostalCode),
ISCHANGED(PersonMailingCountry),
ISCHANGED(Phone))
),
false,
true
)
)</errorConditionFormula>
        <errorMessage>You are not able to modify</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRER07_Block_Update_CRN_Sync</fullName>
        <active>true</active>
        <description>VRER07 - Company Registration Number cannot be modified when the account is synchronized</description>
        <errorConditionFormula>NOT($User.ER_BypassVR__c)
                    &amp;&amp; NOT(ISNEW())
                    &amp;&amp; NOT(ISPICKVAL(ER_BUPicklist__c, &quot;ES&quot;))
                    &amp;&amp; ISCHANGED(ER_Registration_Number__c)
                    &amp;&amp; NOT(ISBLANK(ER_Creation_date_in_OS__c))</errorConditionFormula>
        <errorDisplayField>ER_Registration_Number__c</errorDisplayField>
        <errorMessage>VRER07 - The company registration number cannot be modified when the account is synchronized</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRER08_Check_Medallia_Day_Month_Format</fullName>
        <active>true</active>
        <description>This VR is used to check the format of medallia trigger day</description>
        <errorConditionFormula>NOT($User.ER_BypassVR__c)
                    &amp;&amp; RecordType.DeveloperName = &apos;ER_Individual_Account_RT&apos;
                    &amp;&amp; NOT(ISBLANK(ER_Medallia_Invitation_Trigger_Date__c))
                    &amp;&amp; NOT(REGEX(ER_Medallia_Invitation_Trigger_Date__c, &quot;[0-9]{2}/[0-9]{2}&quot;))</errorConditionFormula>
        <errorMessage>VRER08 - The Medallia Invitation Trigger Date field should have the following format &quot;dd/mm&quot; (Ex. 02/11)</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRES01_Validate_Company_Reg</fullName>
        <active>false</active>
        <errorConditionFormula>NOT($User.ER_BypassVR__c)
		&amp;&amp; ISPICKVAL(ER_BUPicklist__c, &quot;ES&quot;)
		&amp;&amp; NOT(ISBLANK(ER_Registration_Number__c))
		&amp;&amp; NOT(REGEX(ER_Registration_Number__c, &quot;[0-9A-Z][0-9]{7}[0-9A-Z]&quot;))
		&amp;&amp; NOT(REGEX(ER_Registration_Number__c, &quot;[XYZ]{7,8}[A-Z]&quot;))
		&amp;&amp; NOT(REGEX(ER_Registration_Number__c, &quot;([a-z]|[A-Z]|[0-9])[0-9]{7}([a-z]|[A-Z]|[0-9])&quot;))</errorConditionFormula>
        <errorDisplayField>ER_Registration_Number__c</errorDisplayField>
        <errorMessage>VRES01 - Please enter a valid Registration Number</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRFI01_CRN_Format</fullName>
        <active>true</active>
        <description>This validation rule ensure that the format of the CRN is correctly captured by User, and follow the finnish format. This rule can be bypassed by a User by checking the field &apos;BypassVR&apos; on its account.</description>
        <errorConditionFormula>NOT($User.ER_BypassVR__c) &amp;&amp;
            RecordType.DeveloperName = &apos;ER_Company_Account_RT&apos; &amp;&amp;
            ISPICKVAL( ER_BUPicklist__c, &apos;FI&apos;) &amp;&amp;
            NOT(REGEX( ER_Registration_Number__c , &quot;[0-9]{7}-[0-9]{1}&quot;))</errorConditionFormula>
        <errorDisplayField>ER_Registration_Number__c</errorDisplayField>
        <errorMessage>The Company Registration Number must be 9 alphanumeric characters long with the following format: 0000000-0 (7 digits then &quot;-&quot; then 1 digit)</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRFR01_Valid_CompanyRegistrationNumber</fullName>
        <active>true</active>
        <description>Validation rule created for respecting the required format for the field ER_Registration_Number__c.</description>
        <errorConditionFormula>NOT($User.ER_BypassVR__c) 
        &amp;&amp; RecordType.DeveloperName = &apos;ER_Company_Account_RT&apos;
        &amp;&amp; ER_SmartER_Context__c = True 
        &amp;&amp; ISPICKVAL(  ER_Country_Code__c , &apos;FR&apos;) 
        &amp;&amp; NOT(REGEX( ER_Registration_Number__c, &quot;[0-9]{14}&quot;))</errorConditionFormula>
        <errorDisplayField>ER_Registration_Number__c</errorDisplayField>
        <errorMessage>The Registration Number field must be 14 digits long without space.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRFR02_Valid_VATNumber</fullName>
        <active>true</active>
        <description>Validation rule created for respecting the required format for the field ER_VAT_Number__c.</description>
        <errorConditionFormula>NOT($User.ER_BypassVR__c)
            &amp;&amp; ER_SmartER_Context__c= True 
            &amp;&amp; NOT(ISBLANK(ER_VAT_Number__c))
            &amp;&amp; ISPICKVAL( ER_Country_Code__c , &apos;FR&apos;) 
            &amp;&amp; NOT(
            REGEX( ER_VAT_Number__c, &quot;[0-9]{11}&quot;) ||
            REGEX( ER_VAT_Number__c, &quot;[^IO]{1}[0-9]{10}&quot;) ||
            REGEX( ER_VAT_Number__c, &quot;[^IO]{2}[0-9]{9}&quot;) ||
            REGEX( ER_VAT_Number__c, &quot;FR[0-9A-Z]{2}[0-9]{9}&quot;) ||
            REGEX( ER_VAT_Number__c, &quot;[0-9]{1}[^IO]{1}[0-9]{9}&quot;)
            )</errorConditionFormula>
        <errorDisplayField>ER_VAT_Number__c</errorDisplayField>
        <errorMessage>The VAT field must have the following structure “FR + 2 check digits + 9 digits”</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRGR01_Block_Update_Client_FC_Sync_Acc</fullName>
        <active>true</active>
        <description>A Master Financial Center with a Preferred invoice method is mandatory for a Greek synchronized account</description>
        <errorConditionFormula>NOT($User.ER_BypassVR__c)
                    &amp;&amp; NOT(ISNEW())
                    &amp;&amp; ISPICKVAL(ER_BUPicklist__c, &quot;GR&quot;)
                    &amp;&amp; ISCHANGED(ER_Client_Master_FinancialCenter__c)
                    &amp;&amp; ISPICKVAL(ER_Client_Master_FinancialCenter__r.ER_Preferred_Invoicing_Method__c ,&apos;&apos;)
                    &amp;&amp; NOT(ISBLANK(ER_Creation_date_in_OS__c))</errorConditionFormula>
        <errorDisplayField>ER_Client_Master_FinancialCenter__c</errorDisplayField>
        <errorMessage>VRGR01 - A Master Financial Center with a Preferred invoice method is mandatory for a Greek synchronized account</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRGR02_Block_Update_Merchant_FC_Sync_Acc</fullName>
        <active>true</active>
        <description>A Master Financial Center with a Preferred invoice method is mandatory for a Greek synchronized account</description>
        <errorConditionFormula>NOT($User.ER_BypassVR__c)
                    &amp;&amp; NOT(ISNEW())
                    &amp;&amp; ISPICKVAL(ER_BUPicklist__c, &quot;GR&quot;)
                    &amp;&amp; ISCHANGED(ER_Merchant_Master_FinancialCenter__c)
                    &amp;&amp; ISPICKVAL(ER_Merchant_Master_FinancialCenter__r.ER_Preferred_Invoicing_Method__c ,&apos;&apos;)
                    &amp;&amp; NOT(ISBLANK(ER_Creation_date_in_OS__c))</errorConditionFormula>
        <errorDisplayField>ER_Merchant_Master_FinancialCenter__c</errorDisplayField>
        <errorMessage>VRGR02 - A Master Financial Center with a Preferred invoice method is mandatory for a Greek synchronized account</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRGR03_CRN_VAT_Format</fullName>
        <active>true</active>
        <description>CRN and VAT Number must be 9 characters long with ONLY Numbers.</description>
        <errorConditionFormula>NOT($User.ER_BypassVR__c) &amp;&amp;
            RecordType.DeveloperName = &quot;ER_Company_Account_RT&quot; &amp;&amp;
            ISPICKVAL(ER_BUPicklist__c, &quot;GR&quot;) &amp;&amp;
            ISPICKVAL(ER_Country_Code__c, &quot;GR&quot;) &amp;&amp;
            (NOT(ISBLANK(ER_Registration_Number__c)) &amp;&amp;
            ((NOT(REGEX(ER_Registration_Number__c, &quot;^[0-9]*$&quot;)) ||
            LEN(ER_Registration_Number__c) &lt;&gt; 9)
            ) ||
            (NOT(ISBLANK(ER_VAT_Number__c)) &amp;&amp;
            (NOT(REGEX(ER_VAT_Number__c, &quot;^[0-9]*$&quot;)) ||
            LEN(ER_VAT_Number__c) &lt;&gt; 9)
            ))</errorConditionFormula>
        <errorMessage>VRGR03 - CRN and VAT Number must be 9 characters long with only numbers.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRHU01_Phone_Number_Hungarian_Format</fullName>
        <active>true</active>
        <description>This validation rule will control the phone number format to ensure it fit Hungarian format, as following:
                    +36-1-111-1111(capital city)
                    +36-11-111-111(countryside)
                    +36-11-111-1111(mobile phones)</description>
        <errorConditionFormula>AND(
                        NOT($User.ER_BypassVR__c),
                        ER_Business_Unit__c = &apos;HU&apos;,
                        NOT(
                        OR(
                        LEN(Phone) = 0,
                        REGEX(Phone, &quot;[+36]{3}-[0-9]{1}-[0-9]{3}-[0-9]{4}&quot;),
                        REGEX(Phone, &quot;[+36]{3}-[0-9]{2}-[0-9]{3}-[0-9]{3}&quot;),
                        REGEX(Phone, &quot;[+36]{3}-[0-9]{2}-[0-9]{3}-[0-9]{4}&quot;)
                        )))</errorConditionFormula>
        <errorDisplayField>Phone</errorDisplayField>
        <errorMessage>The format of the Phone Number must be equal to Hungarian format, as following :
                        +36-1-111-1111 (capital city)
                        +36-11-111-111 (countryside)
                        +36-11-111-1111 (mobile phones)</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRHU02_VAT_Number_Hungarian_Format</fullName>
        <active>true</active>
        <description>This validation rule ensure that the format of the VAT Number is correctly captured by User, and follow the hungarian format. This rule can be bypassed by a User by checking the field &apos;BypassVR&apos; on its account.</description>
        <errorConditionFormula>AND( 
                    NOT($User.ER_BypassVR__c),
                    ER_Business_Unit__c = &apos;HU&apos;, 
                    NOT( 
                    OR( 
                    LEN( ER_VAT_Number__c ) = 0, 
                    REGEX(ER_VAT_Number__c , &quot;[0-9]{8}-[0-9]{1}-[0-9]{2}&quot;)
                    )))</errorConditionFormula>
        <errorDisplayField>ER_VAT_Number__c</errorDisplayField>
        <errorMessage>The format of the VAT Number must match Hungarian format : 11 digits xxxxxxxx-x-xx</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRPL01_Check_Country_Code</fullName>
        <active>false</active>
        <description>The country code is a mandatory data for sync with SAXO and Zuora</description>
        <errorConditionFormula>NOT($User.ER_BypassVR__c)
		&amp;&amp; ER_Business_Unit__c = &apos;PL&apos;
		&amp;&amp; ISPICKVAL(ER_Country_Code__c, &apos;&apos;)</errorConditionFormula>
        <errorDisplayField>ER_Country_Code__c</errorDisplayField>
        <errorMessage>VRPL01 - Please select a Country Code</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRPL02_VAT_Number_size</fullName>
        <active>true</active>
        <description>For PL the VAT_Number should not be more than 20 characters.</description>
        <errorConditionFormula>NOT($User.ER_BypassVR__c)
					&amp;&amp; ER_Business_Unit__c = &apos;PL&apos;
					&amp;&amp; LEN(ER_VAT_Number__c) &gt; 20</errorConditionFormula>
        <errorDisplayField>ER_VAT_Number__c</errorDisplayField>
        <errorMessage>VRPL02 - You cannot input a VAT Number of more than 20 characters.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRRO01_Prevent_Person_Account_Changing</fullName>
        <active>true</active>
        <description>Prevent Ro users to modify or create any person account.</description>
        <errorConditionFormula>NOT(ISCHANGED( ER_VIP__pc ) ) &amp;&amp;  NOT($User.ER_BypassVR__c)
                    &amp;&amp; $Setup.ER_Validation_Rules_Settings__c.VRRO01_Prevent_Person_Account_Changing__c = false
                    &amp;&amp; IsPersonAccount
                    &amp;&amp; ISPICKVAL($User.ER_Business_Unit__c, &quot;RO&quot;)</errorConditionFormula>
        <errorMessage>You are not able to modify</errorMessage>
    </validationRules>
