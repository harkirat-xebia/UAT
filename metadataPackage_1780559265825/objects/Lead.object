    <recordTypes>
        <fullName>ER_Client_Lead_RT</fullName>
        <active>true</active>
        <businessProcess>Client Lead Process</businessProcess>
        <label>Client Lead</label>
        <picklistValues>
            <picklist>ABC_Client_Segmentation__c</picklist>
            <values>
                <fullName>Develop BB</fullName>
                <default>false</default>
            </values>
            <values>
                <fullName>Develop CA</fullName>
                <default>false</default>
            </values>
            <values>
                <fullName>Economical CB</fullName>
                <default>false</default>
            </values>
            <values>
                <fullName>Economical CC</fullName>
                <default>false</default>
            </values>
            <values>
                <fullName>Intensive AA</fullName>
                <default>false</default>
            </values>
            <values>
                <fullName>Intensive AB</fullName>
                <default>false</default>
            </values>
            <values>
                <fullName>Intensive BA</fullName>
