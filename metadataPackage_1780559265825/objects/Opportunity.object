    <fields>
        <fullName>Role_Type__c</fullName>
        <externalId>false</externalId>
        <formula>IF(
            OR(
                CONTAINS(UPPER($UserRole.Name), &apos;CEO&apos;),
                CONTAINS(UPPER($UserRole.Name), &apos;SALES OPERATIONS&apos;)
            ),
            $UserRole.Name,
            IF(
                CONTAINS(UPPER($UserRole.Name), &apos;SME&apos;),
                &apos;SME&apos;,
                IF(
                    CONTAINS(UPPER($UserRole.Name), &apos;FIELD SALES&apos;),
                    &apos;Field Sales&apos;,
                    IF(
                        CONTAINS(UPPER($UserRole.Name), &apos;LPF&apos;),
                        &apos;LPF&apos;,
                        &apos;&apos;
                    )
                )
            )
        )</formula>
        <label>Role Type</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
