    <fields>
        <fullName>product_family_based_on_solution__c</fullName>
        <externalId>false</externalId>
        <formula>IF(
    CONTAINS(UPPER(Pricebook2.Name), &quot;BENEFIT&quot;),
    &quot;Benefits&quot;,
    IF(
        CONTAINS(UPPER(Pricebook2.Name), &quot;ENGAGEMENT&quot;),
        &quot;Engagement&quot;,
        IF(
            OR(
                CONTAINS(UPPER(ER_Solutions__c), &quot;TRE&quot;),
                CONTAINS(UPPER(ER_Solutions__c), &quot;TCE&quot;),
                CONTAINS(UPPER(ER_Solutions__c), &quot;ECE&quot;),
                CONTAINS(UPPER(ER_Solutions__c), &quot;SCE&quot;),
																CONTAINS(UPPER(ER_Solutions__c), &quot;TRL&quot;),
																CONTAINS(UPPER(ER_Solutions__c), &quot;TCL&quot;),
                CONTAINS(UPPER(ER_Solutions__c), &quot;TRC&quot;)
            ),
            &quot;Benefits&quot;,
            IF(
																OR(
                CONTAINS(UPPER(ER_Solutions__c), &quot;ENG&quot;),
																CONTAINS(UPPER(ER_Solutions__c), &quot;EKIVITA&quot;)
																),
																
                &quot;Engagement&quot;,
                &quot;&quot;
            )
        )
    )
)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Product Family</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
