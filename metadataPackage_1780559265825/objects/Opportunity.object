    <validationRules>
        <fullName>Contacts_before_proposal</fullName>
        <active>false</active>
        <description>Primary and Invoicing contacts must be selected before moving the stage to proposal</description>
        <errorConditionFormula>AND( NOT($User.ER_BypassVR__c), ISPICKVAL(StageName, &apos;Proposal&apos;), ISCHANGED(StageName) , OR(ISBLANK( Invoicing_Contact__c ), ISBLANK( Primary_Contact__c )  ) )</errorConditionFormula>
        <errorMessage>You must identify and enter Primary and Invoicing contacts prior to proposal</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Customer_domain</fullName>
        <active>true</active>
        <description>it must contain letters and/or digits only
its length must be between 3 and 100 characters</description>
        <errorConditionFormula>AND(
				
    NOT($User.ER_BypassVR__c),
				CONTAINS(Pricebook2.Name , &apos;Engagement&apos;),
    NOT(ISBLANK(Customer_Domain__c)),
    OR( 
        LEN(Customer_Domain__c) &lt; 3,      
        LEN(Customer_Domain__c) &gt; 100,  
        REGEX(Customer_Domain__c, &quot;.*([/&apos;().: _$&amp;#@! é§èç{}à%ùäëüï]|\\[|\\]).*&quot;)  
    )
)</errorConditionFormula>
        <errorDisplayField>Customer_Domain__c</errorDisplayField>
        <errorMessage>Customer Domain contains invalid characters. The following characters are not allowed: / &apos; . ( ) [ ] : _ $ &amp; # @ ! (space) é § è ç { } à % ù ä ë ü ï. The value must be between 3 and 100 characters.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Customer_Domain_unicity</fullName>
        <active>true</active>
        <errorConditionFormula>If ( Customer_Domain_Unicity__c = true, true,False)</errorConditionFormula>
        <errorMessage>Customer domain duplicate found</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>CustomerDomainRequiredforEngagement</fullName>
        <active>false</active>
        <description>Customer Domain is required for Engagement opportunity</description>
        <errorConditionFormula>AND(
NOT($User.ER_BypassVR__c),
ISBLANK((Customer_Domain__c)),
CONTAINS(Pricebook2.Name, &apos;Engagement&apos;),
OR(
NOT( ISPICKVAL(StageName, &quot;Qualification&quot;) || ISPICKVAL(StageName, &quot;Need Analysis&quot;) ),
AND(
ISPICKVAL(PRIORVALUE(StageName), &quot;Qualification&quot;) || ISPICKVAL(PRIORVALUE(StageName), &quot;Need Analysis&quot;),
ISPICKVAL(StageName, &quot;Proposal&quot;)
)
)
)</errorConditionFormula>
        <errorDisplayField>Customer_Domain__c</errorDisplayField>
        <errorMessage>Customer Domain is required when the opportunity is for Engagement. Please select a value before proceeding.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Ensure_Contract_End_Date_For_Framework</fullName>
        <active>false</active>
        <description>Ensures that the Contract End Date is filled in if the Contract Type is &apos;Framework Contract</description>
        <errorConditionFormula>AND(
    ISPICKVAL(Type, &quot;Framework agreement&quot;),
    ISBLANK(Contract_End_Date__c)
)</errorConditionFormula>
        <errorDisplayField>Contract_End_Date__c</errorDisplayField>
        <errorMessage>Contract End Date must be filled in if the Type is &apos;Framework Agreement&apos;</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Invalid_Stage_Selection_for_New_OPP</fullName>
        <active>true</active>
        <errorConditionFormula>NOT($User.ER_BypassVR__c) &amp;&amp;

ISNEW() &amp;&amp;
NOT(ISPICKVAL(StageName, &quot;Qualification&quot;)) &amp;&amp;
OR(
    $Profile.Name =&quot;Sales Rep&quot;,
    $Profile.Name =&quot;Sales Operations&quot;,
				$Profile.Name =&quot;Sales Head&quot;
)</errorConditionFormula>
        <errorDisplayField>StageName</errorDisplayField>
        <errorMessage>Stage Must be Set to Qualification</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>OnboardingDateRequiredforEngagement</fullName>
        <active>false</active>
        <description>Onboarding Date is required for Engagement opportunity</description>
        <errorConditionFormula>AND(
NOT($User.ER_BypassVR__c),
ISBLANK((Start_Date__c)),
CONTAINS(Pricebook2.Name, &apos;Engagement&apos;),
OR(
NOT( ISPICKVAL(StageName, &quot;Qualification&quot;) || ISPICKVAL(StageName, &quot;Need Analysis&quot;) ),
AND(
ISPICKVAL(PRIORVALUE(StageName), &quot;Qualification&quot;) || ISPICKVAL(PRIORVALUE(StageName), &quot;Need Analysis&quot;),
ISPICKVAL(StageName, &quot;Proposal&quot;)
)
)
)</errorConditionFormula>
        <errorDisplayField>Start_Date__c</errorDisplayField>
        <errorMessage>Onboarding Date is required when the opportunity is for Engagement. Please select a value before proceeding.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>OnboardingMethodRequiredforEngagement</fullName>
        <active>true</active>
        <description>Onoarding Method is required for Engagement opportunity</description>
        <errorConditionFormula>AND(
    NOT($User.ER_BypassVR__c),
    ISBLANK(TEXT(Onboarding_Method__c)),
    CONTAINS(Pricebook2.Name, &apos;Engagement&apos;),
    OR(
    NOT( ISPICKVAL(StageName, &quot;Qualification&quot;) || ISPICKVAL(StageName, &quot;Need Analysis&quot;) ),
    AND(
    ISPICKVAL(PRIORVALUE(StageName), &quot;Qualification&quot;) || ISPICKVAL(PRIORVALUE(StageName), &quot;Need Analysis&quot;),
    ISPICKVAL(StageName, &quot;Proposal&quot;)
    )
    )
)</errorConditionFormula>
        <errorDisplayField>Onboarding_Method__c</errorDisplayField>
        <errorMessage>Onboarding Method is required when the opportunity is for Engagement. Please select a value before proceeding.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Opportunity_Owner_Change_Access_Control</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
    ISCHANGED(OwnerId),
    NOT(
        OR(
            $Profile.Name = &quot;Sales Operations&quot;,
            $Profile.Name = &quot;System Administrator&quot;,
            $Profile.Name = &quot;Sales Head&quot;,

            AND(
                $Profile.Name = &quot;Sales Rep&quot;,
                $User.Id = PRIORVALUE(OwnerId)
            ),

            AND(
                $Profile.Name = &quot;Sales Rep&quot;,
                $UserRole.Name = &quot;SME L2W/Partners channel Sales Rep&quot;,
                Owner.UserRole.Name = &quot;SME L2W/Partners channel Sales Rep&quot;
            )
        )
    )
)</errorConditionFormula>
        <errorMessage>You cannot change the Owner of this Record.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Prevent_Invalid_Beneficiary_Selection</fullName>
        <active>true</active>
        <errorConditionFormula>And (
				CONTAINS(Pricebook2.Name , &apos;Engagement&apos;),
			NOT($User.ER_BypassVR__c),
AND(
    ISPICKVAL(Onboarding_Method__c, &quot;Explicit Only&quot;),
    OR(
        ISPICKVAL(Impacted_Beneficiaries__c, &quot;All&quot;),
        ISPICKVAL(Impacted_Beneficiaries__c, &quot;TRE Only&quot;)
    )
))</errorConditionFormula>
        <errorDisplayField>Impacted_Beneficiaries__c</errorDisplayField>
        <errorMessage>You cannot select &apos;All&apos; or &apos;TRE Only&apos; for Impacted Beneficiaries when the Onboarding Method is set to &apos;Explicit Only.&apos; Please choose a different option.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Prevent_Proposal_Stage_Change_On_Update</fullName>
        <active>true</active>
        <errorConditionFormula>AND( 
    Not(Isnew()),
               ISPICKVAL(StageName, &quot;Qualification&quot;),
  

            ISPICKVAL(PRIORVALUE(StageName), &quot;Proposal&quot;),
               
       
                    OR(
    $Profile.Name =&quot;Sales Rep&quot;,
    $Profile.Name =&quot;Sales Operations&quot;,
    $Profile.Name =&quot;Sales Head&quot;
    ))</errorConditionFormula>
        <errorDisplayField>StageName</errorDisplayField>
        <errorMessage>You cannot update the stage from Proposal to Qualification/Need Analysis !!</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PreventClosedWonWithoutActivatedContract</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
  ISCHANGED(StageName),
  ISPICKVAL(StageName, &apos;Closed won&apos;),
  NOT(ISPICKVAL(PRIORVALUE(StageName), &apos;Closed won&apos;)),
  NOT(bypassVR__c),
  NOT($User.ER_BypassVR__c),
  $Profile.Name = &apos;Sales Rep&apos;,
  NOT($Profile.Name = &apos;Sales Operations&apos;),
  NOT(ISPICKVAL($User.UserType, &apos;Guest&apos;)),
  ISBLANK(Contract.Id)
)</errorConditionFormula>
        <errorMessage>Opportunity cannot be marked as Closed Won unless the related Contract exists.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Require_Commercial_Origin_On_Closed_Won</fullName>
        <active>true</active>
        <errorConditionFormula>AND( 
    NOT($User.ER_BypassVR__c), 
    ISPICKVAL(StageName, &quot;Proposal&quot;), 
    ISBLANK(TEXT(Commercial_Origin__c)) 
)</errorConditionFormula>
        <errorMessage>Commercial Origin is required when the Opportunity is in Proposal Stage.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Require_Contract_Start_Date_On_Closed_Wo</fullName>
        <active>true</active>
        <errorConditionFormula>AND( 
    NOT($User.ER_BypassVR__c), 
    ISPICKVAL(StageName, &quot;Proposal&quot;), 
    ISBLANK(ER_Contract_Expected_Start_Date__c) 
)</errorConditionFormula>
        <errorDisplayField>ER_Contract_Expected_Start_Date__c</errorDisplayField>
        <errorMessage>Contract Expected Start Date is required when the Opportunity is in Proposal Stage.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Require_Impacted_Beneficiaries_For_OSS_H</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
				CONTAINS(Pricebook2.Name , &apos;Engagement&apos;),
    NOT($User.ER_BypassVR__c), 
    ISPICKVAL(Onboarding_Method__c, &quot;OSS&quot;) 
    || ISPICKVAL(Onboarding_Method__c, &quot;Hybrid&quot;),
    ISBLANK(TEXT(Impacted_Beneficiaries__c))
)</errorConditionFormula>
        <errorDisplayField>Impacted_Beneficiaries__c</errorDisplayField>
        <errorMessage>Impacted Beneficiaries is required when Onboarding Method is OSS or Hybrid.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Require_Lost_Reason_On_Closed_Lost</fullName>
        <active>true</active>
        <description>Lost reason must be filled when opportunity stage is closed lost.</description>
        <errorConditionFormula>AND(ISPICKVAL(StageName, &quot;Closed Lost&quot;),  ISBLANK (TEXT( ER_Lost_Reason__c)))</errorConditionFormula>
        <errorMessage>Lost Reason is required when the Opportunity is marked as Closed Lost.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRBE02_InvoicingDayOfWeek_Obligatory</fullName>
        <active>false</active>
        <errorConditionFormula>NOT($User.ER_BypassVR__c)
&amp;&amp; ISPICKVAL(ER_BU_Picklist__c, &quot;BENELUX&quot;)
&amp;&amp; ISPICKVAL( ER_InvoicingFrequency__c ,&quot;Weekly&quot;)
&amp;&amp; (ISBLANK(TEXT( ERBE_Invoicing_day_of_week__c )))</errorConditionFormula>
        <errorMessage>The field Invoicing Day Of Week must be filled in order to register the Opportunity</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRBE03_AcceptorProvider_Obligatory</fullName>
        <active>false</active>
        <errorConditionFormula>AND(
NOT($User.ER_BypassVR__c),
ISPICKVAL(ER_BU_Picklist__c , &apos;BENELUX&apos;),
ISPICKVAL(ER_Lost_Reason__c ,&quot;Device not compatible&quot;),
(ISBLANK(TEXT( ERBE_Acceptor_Provider__c ))
))</errorConditionFormula>
        <errorMessage>The field Acceptor Provider must be filled in order to register the Opportunity</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRBE04_Prevent_Selecting_Pricebook_BELU</fullName>
        <active>false</active>
        <description>11884 - Deactivating VR</description>
        <errorConditionFormula>NOT($User.ER_BypassVR__c)
&amp;&amp; $Setup.ER_Validation_Rules_Settings__c.VRBE04_Prevent_Selecting_Pricebook_BELU__c = false
            &amp;&amp; TEXT(ER_BU_Picklist__c) = &apos;BENELUX&apos;
            &amp;&amp; $RecordType.Name = &apos;Merchant Opportunity&apos;
&amp;&amp; ( ( LEFT(Account.ER_VAT_Number__c, 2) = &apos;BE&apos; &amp;&amp;
	( UPPER(Pricebook2.Name) != &apos;ERBE MERCHANT&apos; &amp;&amp; UPPER(Pricebook2.Name) != &apos;ERBE MERCHANT EKIVITA&apos; ) ) ||
	( LEFT(Account.ER_VAT_Number__c, 2) = &apos;LU&apos; &amp;&amp;
	( UPPER(Pricebook2.Name) != &apos;ERLU MERCHANT&apos; &amp;&amp; UPPER(Pricebook2.Name) != &apos;ERLU MERCHANT EKIVITA&apos; ) ) ||
	( LEFT(Account.ER_VAT_Number__c, 2) != &apos;BE&apos; &amp;&amp; LEFT(Account.ER_VAT_Number__c, 2) != &apos;LU&apos; &amp;&amp;
	( UPPER(Pricebook2.Name) != &apos;ERBE MERCHANT&apos; &amp;&amp; UPPER(Pricebook2.Name) != &apos;ERBE MERCHANT EKIVITA&apos; &amp;&amp;
	  UPPER(Pricebook2.Name) != &apos;ERLU MERCHANT&apos; &amp;&amp; UPPER(Pricebook2.Name) != &apos;ERLU MERCHANT EKIVITA&apos; ) ) )</errorConditionFormula>
        <errorMessage>Pricebook not appropriate according to Account VAT country</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRBE05_Employee_Engagement_Platform_Err</fullName>
        <active>false</active>
        <description>PBI14190 - Make the selection of the type mandatory for any Opportunity record associated
with the pricebook &quot;ERBE Merchant EKIVITA&quot; (if this pricebook is selected the type must be:
&quot;Employee Engagement Platform&quot;.</description>
        <errorConditionFormula>NOT($User.ER_BypassVR__c)
&amp;&amp; TEXT(ER_BU_Picklist__c) = &apos;BENELUX&apos;
&amp;&amp; $RecordType.Name = &apos;Merchant Opportunity&apos;
&amp;&amp; (UPPER(Pricebook2.Name) = &apos;ERBE MERCHANT EKIVITA&apos; &amp;&amp; NOT(ISPICKVAL(Type, &apos;Employee Engagement Platform&apos;)))</errorConditionFormula>
        <errorMessage>VRBE05: If PriceBook EKIVITA is selected, the Opportunity type should be Employee Engagement Platform.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRBE06_LeadSource_Obligatory</fullName>
        <active>false</active>
        <errorConditionFormula>NOT($User.ER_BypassVR__c)
&amp;&amp; ISPICKVAL(ER_BUPicklist__c , &apos;BENELUX&apos;)
&amp;&amp; ISBLANK(  TEXT( LeadSource ))
&amp;&amp; NOT(ISNEW() &amp;&amp;  ER_IsAmended__c)</errorConditionFormula>
        <errorMessage>The field Lead Source must be filled in order to register the Opportunity</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRBE07_MandatoryTermsConditions</fullName>
        <active>false</active>
        <description>Rule for mandatory Terms and Conditions.</description>
        <errorConditionFormula>NOT($User.ER_BypassVR__c)
&amp;&amp; ISPICKVAL(ER_BUPicklist__c, &quot;BENELUX&quot;)
&amp;&amp; NOT(ISPICKVAL( $User.UserType ,&quot;AutomatedProcess&quot;))
&amp;&amp; (ISBLANK(TEXT(ER_PaymentMethod__c))
				|| ISBLANK(TEXT(ER_PaymentTerms__c))
				|| ISBLANK(TEXT(ERBE_Invoicing_Support__c))
				|| ISBLANK(TEXT(ER_InvoicingFrequency__c))
				|| ISBLANK(TEXT(ER_ReimbursementTerm__c))
				|| ISBLANK(TEXT(ERBE_Reimbursement_Statement_Frequency__c))
				|| ISBLANK(TEXT(ERBE_Reimbursement_Statement_Support__c))
				|| (ISPICKVAL(ER_InvoicingFrequency__c, &quot;Weekly&quot;) &amp;&amp; ISBLANK(TEXT(ERBE_Invoicing_day_of_week__c)))
			)</errorConditionFormula>
        <errorMessage>VRBE07 - Terms and Conditions fields are mandatory.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRER01_Opportunity_ClosedWonBlockEdit</fullName>
        <active>true</active>
        <description>When stage is set to “Closed won”, the opportunity record cannot be edited.</description>
        <errorConditionFormula>AND(
NOT($User.ER_BypassVR__c),
ISPICKVAL( PRIORVALUE(StageName), &apos;Closed won&apos;),
NOT(ISCHANGED( ContractId )),
NOT( ISPICKVAL($User.UserType, &apos;Guest&apos;)),
NOT(ISCHANGED( LastModifiedDate )),
NOT(ISCHANGED( bypassVR__c)),
NOT (ISCHANGED( ER_Won_Reason__c)),
NOT($Profile.Name = &quot;Sales Head&quot;),
NOT($Profile.Name = &quot;Sales Operations&quot;) 
)</errorConditionFormula>
        <errorMessage>When stage is set to “Closed won”, the opportunity record cannot be edited.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRER02_ClosedWonWithoutContract</fullName>
        <active>false</active>
        <description>The linked contract must be active to close the opportunity as ‘Won’</description>
        <errorConditionFormula>AND(
                    NOT($User.ER_BypassVR__c),
                    NOT(ISPICKVAL($User.ER_Business_Unit__c , &apos;PL&apos;)),
                    ISPICKVAL( StageName, &apos;Closed won&apos;),
                    NOT(ISPICKVAL( PRIORVALUE(StageName), &apos;Closed won&apos;)),
                    NOT(ISPICKVAL(Contract.Status, &apos;Activated&apos;))
                    )</errorConditionFormula>
        <errorMessage>The linked contract must be active to close the opportunity as ‘Won’</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRER03_Credit_Limit_Mandatory</fullName>
        <active>false</active>
        <errorConditionFormula>NOT($User.ER_BypassVR__c)
&amp;&amp; NOT(ISPICKVAL(ER_BUPicklist__c,&apos;ES&apos;))
&amp;&amp; NOT(ISPICKVAL(ER_BUPicklist__c,&apos;FI&apos;))
&amp;&amp; $RecordType.Name = &apos;Client Opportunity&apos;
&amp;&amp; ISBLANK(TEXT(ER_Credit_Limit__c))
&amp;&amp; AND(NOT(ISBLANK(TEXT(ER_PaymentTerms__c)))
&amp;&amp; NOT(TEXT(ER_PaymentTerms__c)=&apos;Pre-paid&apos;))
&amp;&amp; NOT(ER_SmartER_Context__c)</errorConditionFormula>
        <errorMessage>The field Credit Limit must be filled.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRER04_No_Competitors_winners_on_Close</fullName>
        <active>true</active>
        <description>When an competitor opportunitu is closed lost, the number of winning competitors should be greater than 0</description>
        <errorConditionFormula>NOT($User.ER_BypassVR__c)
&amp;&amp; ER_Number_of_competitors_winners__c = 0
&amp;&amp; TEXT( ER_Lost_Reason__c) == $Label.LAB_SF_Opportunity_Lost_to_Competitor</errorConditionFormula>
        <errorMessage>If the Opportunity is Lost, please fill in Winning Competitor(s)</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRER05_Prevent_Change_Of_Type</fullName>
        <active>false</active>
        <description>Prevent the change of Type for amended opportunities</description>
        <errorConditionFormula>AND(
            NOT($User.ER_BypassVR__c),
            ER_IsAmended__c = true,
            ISCHANGED( Type)
            )</errorConditionFormula>
        <errorMessage>You cannot change the type of amended opportunities.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRER06_WonReason_Obligatory</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
NOT(ISPICKVAL( $User.UserType ,&quot;AutomatedProcess&quot;)),
NOT($User.ER_BypassVR__c),
ISPICKVAL( StageName ,&quot;Closed Won&quot;),
(ISBLANK(TEXT( ER_Won_Reason__c ))
))</errorConditionFormula>
        <errorMessage>The field Won Reason must be filled in order to register the Opportunity</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRER07_Framework_Opportunity_Decision</fullName>
        <active>true</active>
        <errorConditionFormula>NOT($User.ER_BypassVR__c)
&amp;&amp; Account.ER_Decision_maker__c = false
&amp;&amp;  TEXT(Type) = &apos;Framework agreement&apos;</errorConditionFormula>
        <errorMessage>Framework Opportunities can only be created on “Decision maker” accounts</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRER07_Prevent_Selecting_Std_Pricebook</fullName>
        <active>false</active>
        <description>This VR is to prevent selecting the standard pricebook</description>
        <errorConditionFormula>NOT($User.ER_BypassVR__c)
&amp;&amp; $Setup.ER_Validation_Rules_Settings__c.VRER07_Prevent_Selecting_Std_Pricebook__c = false
&amp;&amp; NOT(ER_SmartER_Context__c)
&amp;&amp; (Pricebook2.IsStandard || (ER_Business_Unit__c != TEXT(Pricebook2.ER_Business_Unit__c)))
&amp;&amp; NOT(ISBLANK(Pricebook2Id))</errorConditionFormula>
        <errorMessage>VRER07 - This Price Book cannot be used</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRER09_Prevent_Changing_Opp_Name</fullName>
        <active>false</active>
        <description>Prevent changing the Opportunity Name</description>
        <errorConditionFormula>NOT($User.ER_BypassVR__c)
&amp;&amp;  ISCHANGED( Name )</errorConditionFormula>
        <errorMessage>You cannot change the Opportunity Name</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRER10_EstimatedNumberOfBeneficiaries</fullName>
        <active>true</active>
        <description>Opportunity.Estimated_number_of_beneficiaries must be lower than the Account number of Employees.</description>
        <errorConditionFormula>NOT($User.ER_BypassVR__c)
&amp;&amp;
RecordType.DeveloperName = &quot;ER_Client_Opportunity_RT&quot;
&amp;&amp;
ER_Estimated_Number_Of_Beneficiaries__c &gt; Account.NumberOfEmployees
&amp;&amp;
NOT(ISPICKVAL(LeadSource, &apos;Websales&apos;))
&amp;&amp;
NOT(ISPICKVAL(LeadSource, &apos;Webform&apos;))</errorConditionFormula>
        <errorDisplayField>ER_Estimated_Number_Of_Beneficiaries__c</errorDisplayField>
        <errorMessage>Estimated Number Of Beneficiaries must be lower than the Account number of Employees.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRER11_PaymentMethodWithoutSEPA</fullName>
        <active>true</active>
        <description>Validation Rule for Spain</description>
        <errorConditionFormula>NOT($User.ER_BypassVR__c)
            &amp;&amp; ISPICKVAL(ER_BUPicklist__c, &apos;ES&apos;)
            &amp;&amp; ISPICKVAL(ER_PaymentMethod__c, &apos;Direct debit&apos;)
            &amp;&amp; ER_SEPA_Bank_Account__c = null</errorConditionFormula>
        <errorDisplayField>ER_SEPA_Bank_Account__c</errorDisplayField>
        <errorMessage>Please don&apos;t forget to add the Sepa Bank Account</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRER12_Pricebook_Type</fullName>
        <active>true</active>
        <description>Pricebook [Delicard] can only be used with Employee Engagement Platform</description>
        <errorConditionFormula>!$User.ER_BypassVR__c &amp;&amp;
Pricebook2.Name = &apos;ERFI Delicards&apos; &amp;&amp;
NOT(ISPICKVAL(Type, &apos;Employee Engagement Platform&apos;))</errorConditionFormula>
        <errorDisplayField>Pricebook2Id</errorDisplayField>
        <errorMessage>VRER12 - Pricebook [Delicard] can only be used with Type &quot;Employee Engagement Platform&quot;</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRER13_ClosedWonWithoutContract</fullName>
        <active>false</active>
        <description>The opportunity can be closed as &apos;Won&apos; if there is at least one related contract, regardless of its status</description>
        <errorConditionFormula>AND(
                    NOT($User.ER_BypassVR__c),
                    NOT(ISPICKVAL($User.ER_Business_Unit__c , &apos;PL&apos;)),
                    ISPICKVAL( StageName, &apos;Closed won&apos;),
                    NOT(ISPICKVAL( PRIORVALUE(StageName), &apos;Closed won&apos;)),
                    ISBLANK(Contract.Id),
				                $Profile.Name =&apos;Sales Rep&apos;
                    )</errorConditionFormula>
        <errorMessage>The opportunity can be closed as &apos;Won&apos; if there is at least one related contract</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRGR01_Payment_Method_mandatory</fullName>
        <active>false</active>
        <errorConditionFormula>NOT($User.ER_BypassVR__c) &amp;&amp;
            ISPICKVAL(ER_BUPicklist__c, &quot;GR&quot;) &amp;&amp;
            ISPICKVAL(ER_PaymentMethod__c,&quot;&quot;)</errorConditionFormula>
        <errorDisplayField>ER_PaymentMethod__c</errorDisplayField>
        <errorMessage>VRGR01 - Please fill in the Payment Method.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRGR02_Payment_Terms_mandatory</fullName>
        <active>false</active>
        <errorConditionFormula>NOT($User.ER_BypassVR__c) &amp;&amp;
            ISPICKVAL(ER_BUPicklist__c, &quot;GR&quot;) &amp;&amp;
            ISPICKVAL(ER_PaymentTerms__c,&quot;&quot;)</errorConditionFormula>
        <errorDisplayField>ER_PaymentTerms__c</errorDisplayField>
        <errorMessage>VRGR02 - Please fill in the Payment Terms.</errorMessage>
    </validationRules>
    <webLinks>
        <fullName>New_Zuora_Quote</fullName>
        <availability>online</availability>
        <description>Generate New Zuora Quote</description>
        <displayType>button</displayType>
        <height>600</height>
        <linkType>page</linkType>
        <masterLabel>New Zuora Quote</masterLabel>
        <openType>sidebar</openType>
        <page>zqu__QuoteOption</page>
        <protected>false</protected>
    </webLinks>
    <webLinks>
        <fullName>zqu__New_Quote_CPQX</fullName>
        <availability>online</availability>
        <description>New Quote (New)</description>
        <displayType>button</displayType>
        <encodingKey>UTF-8</encodingKey>
        <linkType>url</linkType>
        <masterLabel>New Quote (New)</masterLabel>
        <openType>replace</openType>
        <protected>false</protected>
        <url>{!URLFOR($Site.BaseRequestUrl+&apos;/apex/zqu__QuoteStudio&apos;, null)}?crmOpportunityId={!Opportunity.Id}&amp;retUrl=/{!Opportunity.Id}</url>
    </webLinks>
    <webLinks>
        <fullName>zqu__QuoteNew</fullName>
        <availability>online</availability>
        <description>Generate New Quote</description>
        <displayType>button</displayType>
        <height>700</height>
        <linkType>page</linkType>
        <masterLabel>New Quote</masterLabel>
        <openType>sidebar</openType>
        <page>zqu__QuoteOption</page>
        <protected>false</protected>
    </webLinks>
</CustomObject>
