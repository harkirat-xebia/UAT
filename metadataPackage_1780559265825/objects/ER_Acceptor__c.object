                    <fullName>not_synchronized</fullName>
                    <default>false</default>
                    <label>Not Synchronized</label>
                </value>
                <value>
                    <fullName>synchronized</fullName>
                    <default>false</default>
                    <label>Synchronized</label>
                </value>
                <value>
                    <fullName>3</fullName>
                    <default>false</default>
                    <label>3</label>
                </value>
                <value>
                    <fullName>pending_synchronization</fullName>
                    <default>false</default>
                    <label>Pending Synchronization</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
