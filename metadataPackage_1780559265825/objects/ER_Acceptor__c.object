&amp;&amp; ISPICKVAL(ER_Acceptor_Provider__c,&apos;Six Payment&apos;)
&amp;&amp; ISPICKVAL( ER_Acceptor_Model__c ,&apos;Yomani&apos;)
&amp;&amp; NOT(BEGINS( ER_TID_Authorization__c,&quot;314&quot;)) 
&amp;&amp; NOT(ISBLANK(ER_TID_Authorization__c))</errorConditionFormula>
        <errorMessage>Terminal ID of Six Payment, Yomani needs to start with 314</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRBE18_TID_sixpment_Yoximo_begins_wt_241</fullName>
        <active>true</active>
        <description>Terminal ID of Six Payment, Yomani needs to start with 241</description>
        <errorConditionFormula>NOT($User.ER_BypassVR__c)
&amp;&amp; (ER_Business_Unit__c =&apos;BENELUX&apos;)
&amp;&amp; ISPICKVAL( ER_Acceptor_Scheme__c ,&apos;C-TAP&apos;)
&amp;&amp; ISPICKVAL(ER_Acceptor_Provider__c,&apos;Six Payment&apos;)
&amp;&amp; ISPICKVAL( ER_Acceptor_Model__c ,&apos;YOXIMO&apos;)
&amp;&amp; NOT(BEGINS( ER_TID_Authorization__c,&quot;241&quot;)) 
&amp;&amp; NOT(ISBLANK(ER_TID_Authorization__c))</errorConditionFormula>
        <errorMessage>Terminal ID of Six Payment, Yoximo needs to start with 241</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRBE19_TID_sixpment_lan_begins_wt_252</fullName>
        <active>true</active>
        <description>Terminal ID of Six Payment, LAN500 needs to start with 252</description>
        <errorConditionFormula>NOT($User.ER_BypassVR__c)
&amp;&amp; (ER_Business_Unit__c =&apos;BENELUX&apos;)
&amp;&amp; ISPICKVAL( ER_Acceptor_Scheme__c ,&apos;C-TAP&apos;)
&amp;&amp; ISPICKVAL(ER_Acceptor_Provider__c,&apos;Six Payment&apos;)
&amp;&amp; ISPICKVAL( ER_Acceptor_Model__c ,&apos;LAN 500&apos;)
&amp;&amp; NOT(BEGINS( ER_TID_Authorization__c,&quot;252&quot;)) 
&amp;&amp; NOT(ISBLANK(ER_TID_Authorization__c))</errorConditionFormula>
        <errorMessage>Terminal ID of Six Payment, LAN500 needs to start with 252</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRBE20_TIDAuthorisation_Obligatory</fullName>
        <active>true</active>
        <errorConditionFormula>NOT($User.ER_BypassVR__c)
            &amp;&amp; NOT(ISCHANGED(TECH_AcceptorCreationViaLeadConversion__c)) 
            &amp;&amp; NOT(PRIORVALUE(TECH_AcceptorCreationViaLeadConversion__c ) = True)
            &amp;&amp; TECH_AcceptorCreationViaLeadConversion__c = False
            &amp;&amp; ISPICKVAL(ER_BUPicklist__c,&apos;BENELUX&apos;) 
            &amp;&amp; (ISPICKVAL(ER_Acceptor_Scheme__c,&apos;C-TAP&apos;) ||  ISPICKVAL(ER_Acceptor_Scheme__c,&apos;WEBAuth&apos;))
            &amp;&amp; RecordType.DeveloperName = &apos;ER_Merchant_Acceptor_RT&apos;
            &amp;&amp; ISBLANK(ER_TID_Authorization__c)</errorConditionFormula>
        <errorMessage>The field TID Authorization must be filled in order to register the Acceptor</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRBE21_AcceptorProvider_Obligatory</fullName>
        <active>true</active>
        <errorConditionFormula>NOT($User.ER_BypassVR__c)
            &amp;&amp; NOT(ISCHANGED(TECH_AcceptorCreationViaLeadConversion__c))
            &amp;&amp; NOT(PRIORVALUE(TECH_AcceptorCreationViaLeadConversion__c ) = True)
            &amp;&amp; TECH_AcceptorCreationViaLeadConversion__c = False
            &amp;&amp; ISPICKVAL(ER_BUPicklist__c ,&apos;BENELUX&apos;) 
            &amp;&amp; RecordType.DeveloperName = &apos;ER_Merchant_Acceptor_RT&apos;
            &amp;&amp; ISPICKVAL(ER_Acceptor_Scheme__c,&apos;C-TAP&apos;)
            &amp;&amp; ISBLANK(TEXT(ER_Acceptor_Provider__c))</errorConditionFormula>
        <errorMessage>The field Acceptor Provider must be filled in order to register the Acceptor</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRBE23_PreventUpdate</fullName>
        <active>true</active>
        <errorConditionFormula>NOT($User.ER_BypassVR__c)
&amp;&amp; (ER_Business_Unit__c =&apos;BENELUX&apos;)
&amp;&amp; NOT( ISNEW() )
&amp;&amp; ISPICKVAL(ER_Status__c, &apos;Activated&apos;) 
&amp;&amp; OR( $Profile.Name = &apos;Merchant Sales&apos;,
			$Profile.Name = &apos;Client Sales&apos;,
			$Profile.Name = &apos;Marketing&apos;
		)</errorConditionFormula>
        <errorMessage>VRBE23 - You are not able to modify an active acceptor.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRBE24_Acceptor_Scheme_required</fullName>
        <active>true</active>
        <description>The acceptor scheme field is required for BE &amp; LU</description>
        <errorConditionFormula>NOT($User.ER_BypassVR__c)
            &amp;&amp; NOT(ISCHANGED(TECH_AcceptorCreationViaLeadConversion__c))
            &amp;&amp; NOT(PRIORVALUE(TECH_AcceptorCreationViaLeadConversion__c ) = True)
            &amp;&amp; TECH_AcceptorCreationViaLeadConversion__c = False
            &amp;&amp;  ISPICKVAL(ER_BUPicklist__c , &apos;BENELUX&apos;) 
            &amp;&amp; (ISPICKVAL(ER_Acceptor_Scheme__c, &apos;&apos;) || 
                (NOT(ISNEW()) &amp;&amp; ISCHANGED(ER_Acceptor_Scheme__c))
            )</errorConditionFormula>
        <errorDisplayField>ER_Acceptor_Scheme__c</errorDisplayField>
        <errorMessage>VRBE24 - The Acceptor Scheme is a mandatory field and cannot be changed</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRBE25_Acceptor_Name_Length</fullName>
        <active>true</active>
        <errorConditionFormula>NOT($User.ER_BypassVR__c)
            &amp;&amp;  ISPICKVAL( ER_BUPicklist__c ,&quot;BENELUX&quot;) 
            &amp;&amp;  LEN( Name ) &gt; 22</errorConditionFormula>
        <errorDisplayField>Name</errorDisplayField>
        <errorMessage>The acceptor name should not exceed 22 characters</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRER01_Activate_Store_Start</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
NOT($User.ER_BypassVR__c),
ISPICKVAL(ER_Status__c,&apos;Active&apos;),
ISBLANK(ER_Start_Date__c)
)</errorConditionFormula>
        <errorDisplayField>ER_Start_Date__c</errorDisplayField>
        <errorMessage>Start Date is required when the Acceptor is Active</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRER02_Edenred_POS_Exclusivity</fullName>
        <active>true</active>
        <description>Acceptors with record type “Edenred POS” can be created only it is linked to a Digital Store</description>
        <errorConditionFormula>NOT($User.ER_BypassVR__c)
&amp;&amp; RecordType.DeveloperName = &apos;Edenred_POS&apos;
&amp;&amp;  ER_Store__r.ER_Digital_Store__c = false
&amp;&amp;  TEXT(ER_Status__c) != &apos;Inactive&apos;</errorConditionFormula>
        <errorMessage>Edenred POS can only be created on Stores set as Digital Store</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRER03_Edenred_POS_TerminalID_missing</fullName>
        <active>true</active>
        <description>Acceptors with record type “Edenred POS” cannot have another status than “Created” if “Terminal ID / Certificate” is empty</description>
        <errorConditionFormula>NOT($User.ER_BypassVR__c)
&amp;&amp; RecordType.DeveloperName = &apos;Edenred_POS&apos;
&amp;&amp; NOT(TEXT(ER_Status__c) = &apos;Created&apos;)
&amp;&amp; ISBLANK( ER_Terminal_ID_Certificate__c )</errorConditionFormula>
        <errorMessage>You must enter a Terminal ID / Certificate before modifying the acceptor status</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRER04_Edenred_POS_Status</fullName>
        <active>true</active>
        <description>Status of Acceptors with record type “Edenred POS” cannot go back to “Created” or “Demo”</description>
        <errorConditionFormula>NOT($User.ER_BypassVR__c)
&amp;&amp; RecordType.DeveloperName = &apos;Edenred_POS&apos;
&amp;&amp; ISCHANGED( ER_Status__c )
&amp;&amp; (
    ( NOT(TEXT(PRIORVALUE(ER_Status__c)) = &apos;Created&apos;) &amp;&amp; !ISBLANK(TEXT(PRIORVALUE(ER_Status__c)))
     &amp;&amp; TEXT(ER_Status__c) = &apos;Demo&apos; 
    ) 
    ||( !ISBLANK(TEXT(PRIORVALUE(ER_Status__c))) &amp;&amp; 
          TEXT(ER_Status__c) = &apos;Created&apos;  )
    )</errorConditionFormula>
        <errorMessage>You cannot go back to “Created” or “Demo” status</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRER05_Mid_Auth_Required</fullName>
        <active>true</active>
        <errorConditionFormula>NOT($User.ER_BypassVR__c)
&amp;&amp; RecordType.DeveloperName = &apos;ER_Merchant_Acceptor_RT&apos;
&amp;&amp; ISBLANK(ER_MID_Authorization__c) 
&amp;&amp; (
    ER_Business_Unit__c != &apos;BENELUX&apos; ||
    (ER_Business_Unit__c = &apos;BENELUX&apos; &amp;&amp; (NOT(ISPICKVAL(ER_Acceptor_Scheme__c, &quot;WEBAuth&quot;)) || NOT(ISPICKVAL(ER_Acceptor_Scheme__c, &quot;MasterCard&quot;)) || NOT(ISPICKVAL(ER_Acceptor_Scheme__c, &quot;C-TAP&quot;))) )
)</errorConditionFormula>
        <errorDisplayField>ER_MID_Authorization__c</errorDisplayField>
        <errorMessage>The MID Authorization is missing</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRER06_Check_Sub_MID_Clearing</fullName>
        <active>true</active>
        <description>This VR is used today only for ERPL
            - “Sub MID Clearing” should not be filled-in if “MID Clearing” is null
            - “Sub MID Clearing” should not be filled-in if “Sub MID Authorization” is null</description>
        <errorConditionFormula>NOT($User.ER_BypassVR__c)
            &amp;&amp; ER_Business_Unit__c = &apos;PL&apos;
            &amp;&amp; RecordType.DeveloperName = &apos;ER_Merchant_Acceptor_RT&apos;
            &amp;&amp; NOT(ISBLANK(ER_Sub_MID_Clearing__c))
            &amp;&amp; (ISBLANK(ER_SubMID_Authorization__c) || ISBLANK(ER_MID_Clearing__c))</errorConditionFormula>
        <errorMessage>VRER06 - Both Sub MID Authorization and MID Clearing must be filled-in!</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRER07_Check_Dates_Consistency</fullName>
        <active>true</active>
        <description>End date should always be greater than start date</description>
        <errorConditionFormula>NOT($User.ER_BypassVR__c)
&amp;&amp; RecordType.DeveloperName = &apos;ER_Merchant_Acceptor_RT&apos;
&amp;&amp; NOT(ISBLANK(ER_Start_Date__c))
&amp;&amp; NOT(ISBLANK(ER_End_Date__c))
&amp;&amp; ER_End_Date__c &lt; ER_Start_Date__c</errorConditionFormula>
        <errorMessage>VRER07 - The End Date can&apos;t be lower than Start Date</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRER25_Block_Update_Store_Sync</fullName>
        <active>true</active>
        <description>VRER08 - Account cannot be modified when the financial center is synchronized</description>
        <errorConditionFormula>NOT($User.ER_BypassVR__c)
            &amp;&amp; NOT(ISNEW())
            &amp;&amp; ISCHANGED(ER_Store__c)
            &amp;&amp; NOT(ISBLANK(ER_Creation_date_in_OS__c))</errorConditionFormula>
        <errorDisplayField>ER_Store__c</errorDisplayField>
        <errorMessage>VRER25 - The store cannot be modified when the acceptor is synchronized</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRER26_Block_Update_TID_Sync</fullName>
