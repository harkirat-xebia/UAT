        <errorConditionFormula>NOT($User.ER_BypassVR__c)
&amp;&amp; NOT(ISNEW())
&amp;&amp; ER_Business_Unit__c =&apos;BENELUX&apos;
&amp;&amp; ISCHANGED(ER_MID_Authorization__c)
&amp;&amp; NOT(ISBLANK(ER_Creation_date_in_OS__c))</errorConditionFormula>
        <errorDisplayField>ER_MID_Authorization__c</errorDisplayField>
        <errorMessage>VRER27 - The MID cannot be modified when the acceptor is synchronized</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRER28_Block_Update_TID</fullName>
        <active>true</active>
        <description>VRER28 - TID Authorization  cannot be modified</description>
        <errorConditionFormula>NOT($User.ER_BypassVR__c)
&amp;&amp; NOT(ISNEW())
&amp;&amp; ER_Business_Unit__c =&apos;BENELUX&apos;
&amp;&amp; ISPICKVAL(ER_Acceptor_Scheme__c, &apos;WEBAuth&apos;)
&amp;&amp; ISCHANGED(ER_TID_Authorization__c)</errorConditionFormula>
        <errorDisplayField>ER_TID_Authorization__c</errorDisplayField>
        <errorMessage>VRER28 - TID Authorization  cannot be modified</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRER29_Block_Update_MID</fullName>
        <active>true</active>
        <description>VRER29 - MID Authorization  cannot be modified</description>
        <errorConditionFormula>NOT($User.ER_BypassVR__c)
&amp;&amp; NOT(ISNEW())
&amp;&amp; ER_Business_Unit__c =&apos;BENELUX&apos;
&amp;&amp; (ISPICKVAL(ER_Acceptor_Scheme__c, &apos;WEBAuth&apos;) || ISPICKVAL(ER_Acceptor_Scheme__c, &apos;C-TAP&apos;))
&amp;&amp; ISCHANGED(ER_MID_Authorization__c)
&amp;&amp; TEXT($User.UserType) != &apos;AutomatedProcess&apos;</errorConditionFormula>
        <errorDisplayField>ER_MID_Authorization__c</errorDisplayField>
        <errorMessage>VRER29 - MID Authorization  cannot be modified</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRER30_Block_Update_MCC_Sync</fullName>
        <active>true</active>
        <description>VRER30-  ER_MCC_Authorization__c  cannot be modified when the financial center is synchronized</description>
        <errorConditionFormula>NOT($User.ER_BypassVR__c)
            &amp;&amp; NOT(ISNEW())
            &amp;&amp; ER_Business_Unit__c =&apos;BENELUX&apos;
            &amp;&amp; ISPICKVAL(ER_Acceptor_Scheme__c, &apos;MasterCard&apos;)
            &amp;&amp; ISCHANGED( ER_MCC_Authorization__c)
            &amp;&amp; NOT(ISBLANK(ER_Creation_date_in_OS__c))</errorConditionFormula>
        <errorDisplayField>ER_MCC_Authorization__c</errorDisplayField>
        <errorMessage>VRER30 - The  MCC Authorization cannot be modified when the acceptor is synchronized</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRER31_Block_Update_Sub_MID_Sync</fullName>
        <active>true</active>
        <description>VRER31-  Sub MID Authorization cannot be modified when the acceptor is synchronized</description>
        <errorConditionFormula>NOT($User.ER_BypassVR__c)
            &amp;&amp; NOT(ISNEW())
            &amp;&amp; ER_Business_Unit__c =&apos;BENELUX&apos;
            &amp;&amp; ISPICKVAL(ER_Acceptor_Scheme__c, &apos;MasterCard&apos;)
            &amp;&amp; ISCHANGED(ER_SubMID_Authorization__c)
            &amp;&amp; NOT(ISBLANK(ER_Creation_date_in_OS__c))</errorConditionFormula>
        <errorDisplayField>ER_SubMID_Authorization__c</errorDisplayField>
        <errorMessage>VRER31 - The  Sub MID Authorization cannot be modified when the acceptor is synchronized</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRER32_Block_Update_AID_Clearing</fullName>
        <active>true</active>
        <description>VRER32 - AID Clearing cannot be modified</description>
        <errorConditionFormula>NOT($User.ER_BypassVR__c)
&amp;&amp; NOT(ISNEW())
&amp;&amp; ER_Business_Unit__c =&apos;BENELUX&apos;
&amp;&amp; (ISPICKVAL(ER_Acceptor_Scheme__c, &apos;MasterCard&apos;) || ISPICKVAL(ER_Acceptor_Scheme__c, &apos;C-TAP&apos;))
&amp;&amp; ISCHANGED(ER_AID_Clearing__c)</errorConditionFormula>
        <errorDisplayField>ER_AID_Clearing__c</errorDisplayField>
        <errorMessage>VRER32 - AID Clearing cannot be modified</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRER33_Block_Update_MID_Clearing</fullName>
        <active>true</active>
        <description>VRER33 - MID Clearing  cannot be modified</description>
        <errorConditionFormula>NOT($User.ER_BypassVR__c)
&amp;&amp; NOT(ISNEW())
&amp;&amp; ER_Business_Unit__c =&apos;BENELUX&apos;
&amp;&amp; ISPICKVAL(ER_Acceptor_Scheme__c, &apos;C-TAP&apos;)
&amp;&amp; ISCHANGED(ER_MID_Clearing__c)</errorConditionFormula>
        <errorDisplayField>ER_MID_Clearing__c</errorDisplayField>
