    <validationRules>
        <fullName>VR_Start_Date_Mandatory</fullName>
        <active>true</active>
        <description>Start Date field is mandatory for acceptor sync</description>
        <errorConditionFormula>NOT($User.ER_BypassVR__c)
    &amp;&amp; ISBLANK(ER_Creation_date_in_OS__c )
    &amp;&amp; ER_Business_Unit__c =&apos;BENELUX&apos;
    &amp;&amp; ISBLANK(ER_Start_Date__c)</errorConditionFormula>
        <errorMessage>Start Date field is mandatory for account sync</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRBE01_Max_nr_of_characters_TID</fullName>
        <active>true</active>
        <description>8 characters max.</description>
        <errorConditionFormula>NOT($User.ER_BypassVR__c)
&amp;&amp; (ER_Business_Unit__c =&apos;BENELUX&apos;)
&amp;&amp; LEN(ER_TID_Authorization__c)  &lt;&gt; 8
&amp;&amp; NOT(ISBLANK(ER_TID_Authorization__c))
&amp;&amp; NOT(OR(ISPICKVAL(ER_Acceptor_Scheme__c, &quot;Web&quot;), 
   (ISPICKVAL(ER_Acceptor_Scheme__c, &quot;WEBAuth&quot;)),
   (ISPICKVAL(ER_Acceptor_Scheme__c, &quot;MasterCard&quot;))
   ))</errorConditionFormula>
        <errorMessage>The TID needs to have 8 characters</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRBE02_TID_Atosworldline_XENGO_Notcomp</fullName>
        <active>true</active>
        <description>TID Atosworldline XENGO with compatible</description>
        <errorConditionFormula>NOT($User.ER_BypassVR__c)
&amp;&amp; (ER_Business_Unit__c =&apos;BENELUX&apos;)
&amp;&amp; ISPICKVAL( ER_Acceptor_Scheme__c ,&apos;C-TAP&apos;)
&amp;&amp; ISPICKVAL( ER_Acceptor_Provider__c ,&apos;Atos-Worldline&apos;)
&amp;&amp; ISPICKVAL( ER_Acceptor_Model__c ,&apos;XENGO&apos;)
&amp;&amp; NOT(ISBLANK( ER_TID_Authorization__c))</errorConditionFormula>
        <errorMessage>Xengo is not compatible with electronic cheques</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRBE03_TID_Atosworldline_begins_wt_01or5</fullName>
        <active>true</active>
        <description>Terminal ID of Atos Worldline needs to start with 01 or 5</description>
        <errorConditionFormula>NOT($User.ER_BypassVR__c)
&amp;&amp; (ER_Business_Unit__c =&apos;BENELUX&apos;)
&amp;&amp; ISPICKVAL( ER_Acceptor_Scheme__c ,&apos;C-TAP&apos;)
&amp;&amp; (ISPICKVAL(ER_Acceptor_Provider__c,&apos;Atos-Worldline&apos;) || ISPICKVAL(ER_Acceptor_Provider__c,&apos;Atos-Worldline - No invoice&apos;))
&amp;&amp; NOT(BEGINS( ER_TID_Authorization__c,&quot;01&quot;)
||BEGINS(ER_TID_Authorization__c,&quot;5&quot;) )</errorConditionFormula>
        <errorMessage>Terminal ID of Atos Worldline needs to start with 01 or 5</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRBE04_TID_CCV_E265_Notcompatible</fullName>
        <active>true</active>
        <description>CCV, E265 not compatible</description>
        <errorConditionFormula>NOT($User.ER_BypassVR__c)
&amp;&amp; (ER_Business_Unit__c =&apos;BENELUX&apos;)
&amp;&amp; ISPICKVAL( ER_Acceptor_Scheme__c ,&apos;C-TAP&apos;)
&amp;&amp; ISPICKVAL( ER_Acceptor_Provider__c ,&apos;CCV&apos;) 
&amp;&amp; ISPICKVAL( ER_Acceptor_Model__c ,&apos;E 265&apos;)
&amp;&amp; NOT(ISBLANK( ER_TID_Authorization__c))</errorConditionFormula>
        <errorMessage>E 265 is not compatible with electronic cheques</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRBE05_TID_CCV_begins_with_3or000</fullName>
        <active>true</active>
        <description>CCV begins with 3 or 000</description>
        <errorConditionFormula>NOT($User.ER_BypassVR__c)
&amp;&amp; ISPICKVAL(ER_BUPicklist__c, &apos;BENELUX&apos;)
&amp;&amp; ISPICKVAL(ER_Acceptor_Scheme__c ,&apos;C-TAP&apos;)
&amp;&amp; ISPICKVAL(ER_Acceptor_Provider__c,&apos;CCV&apos;)
&amp;&amp; NOT(BEGINS(ER_TID_Authorization__c,&apos;3&apos;))
&amp;&amp; NOT(BEGINS(ER_TID_Authorization__c,&apos;87&apos;))</errorConditionFormula>
        <errorMessage>Operator Provider CCV needs to start with 3 or 87</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRBE06_TID_Chess_begins_with_10or11</fullName>
        <active>true</active>
        <description>Terminal ID of Chess needs to start with 10 or 11</description>
        <errorConditionFormula>NOT($User.ER_BypassVR__c)
&amp;&amp; (ER_Business_Unit__c =&apos;BENELUX&apos;)
&amp;&amp; ISPICKVAL( ER_Acceptor_Scheme__c ,&apos;C-TAP&apos;)
&amp;&amp; ISPICKVAL(ER_Acceptor_Provider__c,&apos;Chess&apos;) 
&amp;&amp; NOT( (BEGINS(ER_TID_Authorization__c,&quot;10&quot;) || BEGINS(ER_TID_Authorization__c,&quot;11&quot;)))
&amp;&amp; NOT(ISBLANK(ER_TID_Authorization__c))</errorConditionFormula>
        <errorMessage>Terminal ID of Chess needs to start with 10 or 11</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRBE07_TID_EasyPayments_begins_with_two</fullName>
        <active>true</active>
        <description>Terminal ID of EasyPayments needs to start with 2</description>
        <errorConditionFormula>NOT($User.ER_BypassVR__c)
&amp;&amp; (ER_Business_Unit__c =&apos;BENELUX&apos;)
&amp;&amp; ISPICKVAL( ER_Acceptor_Scheme__c ,&apos;C-TAP&apos;)
&amp;&amp; ISPICKVAL(ER_Acceptor_Provider__c,&apos;Easy Payments&apos;)
&amp;&amp; NOT(BEGINS( ER_TID_Authorization__c,&quot;2&quot;))
&amp;&amp; NOT(ISBLANK(ER_TID_Authorization__c))</errorConditionFormula>
        <errorMessage>Terminal ID of Easy Payments needs to start with 2</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRBE08_TID_HypercomBScards_Notcompatible</fullName>
        <active>true</active>
        <description>Hypercom/B+S Cards not compatible with electronic cheques.</description>
        <errorConditionFormula>NOT($User.ER_BypassVR__c)
&amp;&amp; (ER_Business_Unit__c =&apos;BENELUX&apos;)
&amp;&amp; ISPICKVAL( ER_Acceptor_Scheme__c ,&apos;C-TAP&apos;)
&amp;&amp; ISPICKVAL( ER_Acceptor_Provider__c ,&apos;Hypercom/B+S Cards&apos;)</errorConditionFormula>
        <errorMessage>Hypercom/B+S Cards is not compatible with electronic cheques</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRBE09_TID_Ingenicopymntservice_6or12</fullName>
        <active>true</active>
        <description>Ingenico payment services need to start with 6 or 12</description>
        <errorConditionFormula>NOT($User.ER_BypassVR__c)
&amp;&amp; (ER_Business_Unit__c =&apos;BENELUX&apos;)
&amp;&amp; ISPICKVAL( ER_Acceptor_Scheme__c ,&apos;C-TAP&apos;)
&amp;&amp; ISPICKVAL(ER_Acceptor_Provider__c,&apos;Ingenico Payment Services&apos;)  
&amp;&amp; NOT(BEGINS( ER_TID_Authorization__c,&quot;6&quot;)
 || BEGINS(ER_TID_Authorization__c,&quot;12&quot;) )
&amp;&amp; NOT(ISBLANK(ER_TID_Authorization__c))</errorConditionFormula>
        <errorMessage>Terminal ID of Ingenico Payment Services needs to start with 6 or 12</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRBE10_TID_Keywr_INGENTICO_notcompatible</fullName>
        <active>true</active>
        <description>Terminal provider Keyware with model ingenico is not compatible</description>
        <errorConditionFormula>NOT($User.ER_BypassVR__c)
&amp;&amp; (ER_Business_Unit__c =&apos;BENELUX&apos;)
&amp;&amp; ISPICKVAL( ER_Acceptor_Scheme__c ,&apos;C-TAP&apos;)
&amp;&amp; ISPICKVAL(ER_Acceptor_Provider__c,&apos;Keyware&apos;)
&amp;&amp; ( ISPICKVAL( ER_Acceptor_Model__c ,&apos;INGENICO ICT 220&apos;) || ISPICKVAL( ER_Acceptor_Model__c ,&apos;INGENICO ICT 250&apos;))</errorConditionFormula>
        <errorMessage>Keyware Ingenico ICT 220, 250 is not compatible with electoric cheques</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRBE11_TID_Keywr_begins_with_01or2or3</fullName>
        <active>true</active>
        <description>TID Keyware needs to start with zeroone or three or two</description>
        <errorConditionFormula>NOT($User.ER_BypassVR__c)
&amp;&amp; (ER_Business_Unit__c =&apos;BENELUX&apos;)
&amp;&amp; ISPICKVAL( ER_Acceptor_Scheme__c ,&apos;C-TAP&apos;)
&amp;&amp; ISPICKVAL(ER_Acceptor_Provider__c,&apos;Keyware&apos;) 
&amp;&amp; NOT(  BEGINS(ER_TID_Authorization__c,&quot;3&quot;)
||BEGINS(ER_TID_Authorization__c,&quot;01&quot;) 
||BEGINS(ER_TID_Authorization__c,&quot;2&quot;) )</errorConditionFormula>
        <errorMessage>Operator Provider Keyware needs to start with 01 or 2 or 3</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRBE12_TID_Loyaltek_begins_with_20or23</fullName>
        <active>true</active>
        <description>Terminal ID of Loyaltek needs to start with 20 or 23</description>
        <errorConditionFormula>NOT($User.ER_BypassVR__c)
&amp;&amp; (ER_Business_Unit__c =&apos;BENELUX&apos;)
&amp;&amp; ISPICKVAL( ER_Acceptor_Scheme__c ,&apos;C-TAP&apos;)
&amp;&amp; ISPICKVAL(ER_Acceptor_Provider__c,&apos;Loyaltek&apos;)
&amp;&amp; NOT( ( BEGINS(ER_TID_Authorization__c,&quot;20&quot;) || BEGINS(ER_TID_Authorization__c,&quot;23&quot;) ))
&amp;&amp; NOT(ISBLANK(ER_TID_Authorization__c))</errorConditionFormula>
        <errorMessage>Terminal ID of Loyaltek needs to start with 20 or 23</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRBE13_TID_SIXCARREFOUR_begins_with_two</fullName>
        <active>true</active>
        <description>Terminal ID of SIX-Carrefour needs to start with 80</description>
        <errorConditionFormula>NOT($User.ER_BypassVR__c)
&amp;&amp; (ER_Business_Unit__c =&apos;BENELUX&apos;)
&amp;&amp; ISPICKVAL( ER_Acceptor_Scheme__c ,&apos;C-TAP&apos;)
&amp;&amp; ISPICKVAL(ER_Acceptor_Provider__c,&apos;Six Payment - Carrefour&apos;) 
&amp;&amp; NOT(BEGINS( ER_TID_Authorization__c,&quot;80&quot;))
&amp;&amp; NOT(ISBLANK(ER_TID_Authorization__c))</errorConditionFormula>
        <errorMessage>Terminal ID of SIX-Carrefour needs to start with 80</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRBE14_TID_Terminalproviders_Notcomp</fullName>
        <active>true</active>
        <description>Payleven, Bevo, Sum up and Adyen are not compatible with electronic cheques.</description>
        <errorConditionFormula>NOT($User.ER_BypassVR__c)
&amp;&amp; (ER_Business_Unit__c =&apos;BENELUX&apos;)
&amp;&amp; ISPICKVAL( ER_Acceptor_Scheme__c ,&apos;C-TAP&apos;)
&amp;&amp; ( ISPICKVAL( ER_Acceptor_Provider__c ,&apos;Payleven&apos;)
|| ISPICKVAL( ER_Acceptor_Provider__c ,&apos;Bevo&apos;)
|| ISPICKVAL( ER_Acceptor_Provider__c ,&apos;SUM UP&apos;)
|| ISPICKVAL( ER_Acceptor_Provider__c ,&apos;Adyen&apos;))</errorConditionFormula>
        <errorMessage>Payleven, Bevo, Sum up and Adyen are not compatible with electronic cheques.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRBE15_TID_sepay_begins_with_onezero</fullName>
        <active>true</active>
        <description>Terminal ID of Sepay starts with one zero</description>
        <errorConditionFormula>NOT($User.ER_BypassVR__c)
&amp;&amp; (ER_Business_Unit__c =&apos;BENELUX&apos;)
&amp;&amp; ISPICKVAL( ER_Acceptor_Scheme__c ,&apos;C-TAP&apos;)
&amp;&amp; ISPICKVAL(ER_Acceptor_Provider__c,&apos;Sepay&apos;)
&amp;&amp; NOT(BEGINS( ER_TID_Authorization__c,&quot;10&quot;))</errorConditionFormula>
        <errorMessage>Terminal ID of Sepay begins with 10</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRBE16_TID_sixpmentBNP_begins_wt_22</fullName>
        <active>true</active>
        <description>Terminal ID of Six Payment-BNP needs to start with 22</description>
        <errorConditionFormula>NOT($User.ER_BypassVR__c)
&amp;&amp; (ER_Business_Unit__c =&apos;BENELUX&apos;)
&amp;&amp; ISPICKVAL( ER_Acceptor_Scheme__c ,&apos;C-TAP&apos;)
&amp;&amp; ISPICKVAL(ER_Acceptor_Provider__c,&apos;Six Payment - BNP&apos;)
&amp;&amp; NOT(BEGINS( ER_TID_Authorization__c,&quot;22&quot;))
&amp;&amp; NOT(ISBLANK(ER_TID_Authorization__c))</errorConditionFormula>
        <errorMessage>Please replace 23XXXXXX by 22XXXXXX</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRBE17_TID_sixpment_Yomani_begins_wt_314</fullName>
        <active>true</active>
        <description>Terminal ID of Six Payment, Yomani needs to start with 314</description>
        <errorConditionFormula>NOT($User.ER_BypassVR__c)
&amp;&amp; (ER_Business_Unit__c =&apos;BENELUX&apos;)
