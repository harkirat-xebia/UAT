    </validationRules>
    <validationRules>
        <fullName>VRER34_Block_Update_AID_Authorization</fullName>
        <active>true</active>
        <description>VRER34 - AID Authorization  cannot be modified</description>
        <errorConditionFormula>NOT($User.ER_BypassVR__c)
&amp;&amp; NOT(ISNEW())
&amp;&amp; ER_Business_Unit__c =&apos;BENELUX&apos;
&amp;&amp; ISPICKVAL(ER_Acceptor_Scheme__c, &apos;C-TAP&apos;)
&amp;&amp; ISCHANGED(ER_AID_Authorization__c)</errorConditionFormula>
        <errorDisplayField>ER_AID_Authorization__c</errorDisplayField>
