    <listViews>
        <fullName>All</fullName>
        <filterScope>Everything</filterScope>
        <label>All</label>
    </listViews>
    <validationRules>
        <fullName>VRER01_DeliverCenterOnlyClientFCenter</fullName>
        <active>true</active>
        <description>Delivery Site can only be created on Client Financial Center</description>
        <errorConditionFormula>AND( 
NOT($User.ER_BypassVR__c), 
TEXT(ER_Financial_Center__r.ER_Type__c) = &quot;Merchant&quot; 
)</errorConditionFormula>
        <errorMessage>Delivery Site can only be created on Client Financial Center</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRER02_Block_Update_Parent_Sync</fullName>
        <active>true</active>
        <description>The parent cannot be modified when the Delivery Site is synchronized</description>
        <errorConditionFormula>NOT($User.ER_BypassVR__c)
&amp;&amp; NOT(ISNEW())
&amp;&amp; (ISCHANGED(ER_Account_Name__c) || ISCHANGED(ER_Financial_Center__c))
&amp;&amp; NOT(ISBLANK( ER_Creation_date_in_OS__c ))</errorConditionFormula>
        <errorMessage>VRER02 - The parent cannot be modified when the Delivery Site is synchronized</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRER03_Address_mandatory</fullName>
        <active>true</active>
        <description>The address is mandatory for a Delivery Site</description>
        <errorConditionFormula>NOT($User.ER_BypassVR__c)
&amp;&amp; (ISBLANK (ER_Street__c) || ISBLANK (ER_Zip_Code__c) || ISBLANK (ER_City__c) ||  ISBLANK (ER_Country__c))</errorConditionFormula>
        <errorMessage>Please fill all the address informations.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRES01_Block_Creation</fullName>
        <active>true</active>
        <description>Block the creation of delivery sites for spain.</description>
        <errorConditionFormula>NOT($User.ER_BypassVR__c)
&amp;&amp; ISNEW()
&amp;&amp; ISPICKVAL(ER_BUPicklist__c, &apos;ES&apos;)</errorConditionFormula>
        <errorMessage>You do not have the permission to create Delivery Sites in OneForce.</errorMessage>
    </validationRules>
</CustomObject>
