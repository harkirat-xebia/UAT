    <validationRules>
        <fullName>VRER01_Translation_Always_Populated</fullName>
        <active>true</active>
        <description>Either text, long text, text area should always be filled in.</description>
        <errorConditionFormula>NOT($User.ER_BypassVR__c)
            &amp;&amp; ISBLANK(Text__c)
            &amp;&amp; ISBLANK(Long_Text_Area__c)
            &amp;&amp; ISBLANK(Text_Area__c)</errorConditionFormula>
        <errorMessage>Please fill in a translated value in either Text, Text Area or Long Text fields.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRER02_Object_Lookup_Mandatory</fullName>
        <active>true</active>
        <description>One of the related object lookups should be populated</description>
        <errorConditionFormula>NOT($User.ER_BypassVR__c)
                &amp;&amp; ISBLANK(Text__c)
                &amp;&amp; ISBLANK(Long_Text_Area__c)
                &amp;&amp; ISBLANK(Text_Area__c)</errorConditionFormula>
        <errorMessage>Please fill in a the object should be translated</errorMessage>
    </validationRules>
</CustomObject>
