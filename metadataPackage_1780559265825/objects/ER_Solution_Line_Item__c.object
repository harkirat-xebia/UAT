    <validationRules>
        <fullName>VRER01_Status_Change_Undefined</fullName>
        <active>true</active>
        <description>Validation Rule to prevent users from changing the status to Undefined</description>
        <errorConditionFormula>NOT($User.ER_BypassVR__c)
            &amp;&amp; ISCHANGED(ER_Status__c)
            &amp;&amp; TEXT(ER_Status__c) = $Label.LAB_SF_SolutionLineItem_Undefined</errorConditionFormula>
        <errorDisplayField>ER_Status__c</errorDisplayField>
        <errorMessage>You cannot select the Status Undefined. Please choose either Active or Inactive.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRER02_Block_Update_Account_Sync</fullName>
        <active>true</active>
        <errorConditionFormula>NOT($User.ER_BypassVR__c)
&amp;&amp; NOT(ISNEW())
&amp;&amp; ISCHANGED(ER_Account__c )
&amp;&amp; NOT(ISBLANK(ER_Creation_date_in_OS__c))</errorConditionFormula>
        <errorDisplayField>ER_Account__c</errorDisplayField>
        <errorMessage>VRER02 - The account name cannot be modified when the solution line item is synchronized</errorMessage>
    </validationRules>
</CustomObject>
