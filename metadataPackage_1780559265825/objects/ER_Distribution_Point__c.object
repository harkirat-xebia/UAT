    <allowInChatterGroups>false</allowInChatterGroups>
    <compactLayoutAssignment>ER_Distribution_Point_Compact_Layout</compactLayoutAssignment>
    <deploymentStatus>Deployed</deploymentStatus>
    <enableActivities>true</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>true</enableHistory>
    <enableLicensing>false</enableLicensing>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <externalSharingModel>ControlledByParent</externalSharingModel>
    <label>Distribution Point</label>
    <nameField>
        <label>Distribution Point Name</label>
        <trackHistory>true</trackHistory>
        <type>Text</type>
    </nameField>
    <pluralLabel>Distribution Points</pluralLabel>
    <searchLayouts></searchLayouts>
    <sharingModel>ControlledByParent</sharingModel>
    <visibility>Public</visibility>
    <compactLayouts>
        <fullName>ER_Distribution_Point_Compact_Layout</fullName>
        <fields>Name</fields>
        <fields>ER_Delivery_Site__c</fields>
        <fields>ER_Sync_result__c</fields>
        <fields>ER_Card_Operational_System_ID__c</fields>
        <label>ER Distribution Point Compact Layout</label>
    </compactLayouts>
    <fields>
        <fullName>ER_BUPicklist__c</fullName>
        <defaultValue>$User.ER_BUText__c</defaultValue>
        <label>Business Unit</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetName>ER_Business_Unit</valueSetName>
        </valueSet>
    </fields>
    <fields>
        <fullName>ER_Card_Operational_System_ID__c</fullName>
        <caseSensitive>false</caseSensitive>
        <externalId>true</externalId>
        <label>Card Operational System ID</label>
        <length>255</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>true</unique>
    </fields>
    <fields>
        <fullName>ER_City__c</fullName>
        <externalId>false</externalId>
        <label>City</label>
        <length>80</length>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>ER_Contact__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <label>Contact</label>
        <lookupFilter>
            <active>true</active>
            <filterItems>
                <field>Contact.ER_Status__c</field>
                <operation>equals</operation>
                <value>Active</value>
            </filterItems>
            <isOptional>false</isOptional>
        </lookupFilter>
        <referenceTo>Contact</referenceTo>
        <relationshipLabel>Distribution Points</relationshipLabel>
        <relationshipName>Distribution_Points</relationshipName>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>ER_Country__c</fullName>
        <externalId>false</externalId>
        <label>Country</label>
        <length>80</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>ER_Country_Code__c</fullName>
        <defaultValue>$User.ER_BUText__c</defaultValue>
        <label>Country Code</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetName>ER_Country_Code</valueSetName>
        </valueSet>
    </fields>
    <fields>
        <fullName>ER_Creation_date_in_OS__c</fullName>
        <label>Creation date in OS</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>DateTime</type>
    </fields>
    <fields>
        <fullName>ER_Delivery_Site__c</fullName>
        <label>Delivery Site</label>
        <referenceTo>ER_Delivery_Site__c</referenceTo>
        <relationshipLabel>Distribution Points</relationshipLabel>
        <relationshipName>Distribution_Points</relationshipName>
        <relationshipOrder>0</relationshipOrder>
        <reparentableMasterDetail>true</reparentableMasterDetail>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>MasterDetail</type>
        <writeRequiresMasterRead>false</writeRequiresMasterRead>
    </fields>
    <fields>
        <fullName>ER_Last_date_of_Sync__c</fullName>
        <label>Last Date of Sync</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>DateTime</type>
    </fields>
    <fields>
        <fullName>ER_MDMId__c</fullName>
        <caseSensitive>true</caseSensitive>
        <externalId>true</externalId>
        <label>MDM ID</label>
        <length>255</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>true</unique>
    </fields>
    <fields>
        <fullName>ER_Paper_Operational_System_ID__c</fullName>
        <caseSensitive>false</caseSensitive>
        <externalId>true</externalId>
        <label>Paper Operational System ID</label>
        <length>255</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>true</unique>
    </fields>
    <fields>
        <fullName>ER_Street__c</fullName>
        <label>Street</label>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>TextArea</type>
    </fields>
    <fields>
        <fullName>ER_Sync_Code__c</fullName>
        <externalId>false</externalId>
        <label>Synchronization Code</label>
        <length>255</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>ER_Sync_result__c</fullName>
        <label>Sync Result</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetName>ER_Sync_result</valueSetName>
        </valueSet>
    </fields>
    <fields>
        <fullName>ER_WS_result_Text__c</fullName>
        <externalId>false</externalId>
        <label>Sync Error</label>
        <length>255</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>ER_Zip_Code__c</fullName>
        <externalId>false</externalId>
        <label>Zip Code</label>
        <length>40</length>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <listViews>
        <fullName>All</fullName>
        <filterScope>Everything</filterScope>
        <label>All</label>
    </listViews>
    <validationRules>
        <fullName>VRER01_Block_Update_deliverysite_Sync</fullName>
        <active>true</active>
        <description>The delivery site cannot be modified when the distribution point is synchronized</description>
        <errorConditionFormula>NOT($User.ER_BypassVR__c)
&amp;&amp; NOT(ISNEW())
&amp;&amp; ISCHANGED(ER_Delivery_Site__c)
&amp;&amp; NOT(ISBLANK(ER_Creation_date_in_OS__c))</errorConditionFormula>
        <errorDisplayField>ER_Delivery_Site__c</errorDisplayField>
        <errorMessage>VRER01 - The delivery site cannot be modified when the distribution point is synchronized</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRER02_Address_mandatory</fullName>
        <active>true</active>
        <description>The address is mandatory for a Distribution Point</description>
        <errorConditionFormula>NOT($User.ER_BypassVR__c)
&amp;&amp; (ISBLANK (ER_Street__c) || ISBLANK (ER_Zip_Code__c) || ISBLANK (ER_City__c) || ISBLANK (ER_Country__c))</errorConditionFormula>
        <errorMessage>Please fill all the address informations.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRES01_Block_Creation</fullName>
        <active>true</active>
        <description>Block the creation of distrbution point for spain.</description>
        <errorConditionFormula>NOT($User.ER_BypassVR__c)
&amp;&amp; ISNEW()
&amp;&amp; ISPICKVAL(ER_BUPicklist__c, &apos;ES&apos;)</errorConditionFormula>
        <errorMessage>You do not have the permission to create Distribution points in OneForce.</errorMessage>
    </validationRules>
</CustomObject>
