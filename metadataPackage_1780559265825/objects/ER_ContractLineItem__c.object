        <externalId>false</externalId>
        <formula>Opportunity_Product__r.ER_Estimated_Value__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Estimated Value</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Face_Value__c</fullName>
        <externalId>false</externalId>
        <formula>IF(
ISBLANK( Opportunity_Product__c),
 ER_Product2__r.ER_Solution2__r.Face_Value__c ,
Opportunity_Product__r.ER_Face_Value__c
)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Face Value</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Fee_Type__c</fullName>
        <externalId>false</externalId>
        <formula>IF(
OR(
Parent_Product__c = &quot;License Fees&quot;,
Parent_Product__c = &quot;Implementation Fees&quot;
),
Parent_Product__c,
NULL
)</formula>
        <label>Fee Type</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Issued_Volume__c</fullName>
        <externalId>false</externalId>
        <formula>TEXT( Opportunity_Product__r.ER_Estimated_Value__c )</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Issued Volume</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Load_per_Year__c</fullName>
        <externalId>false</externalId>
        <formula>IF(
ISBLANK( Opportunity_Product__c),
  ER_Product2__r.ER_Solution2__r.Load_Per_Year__c ,
Opportunity_Product__r.ER_Load_Per_Year__c

)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Load per Year</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Nb_of_Beneficiaries__c</fullName>
        <externalId>false</externalId>
        <formula>IF(
ISBLANK( Opportunity_Product__c),
 ER_Product2__r.ER_Solution2__r.No_Of_Beneficiaries__c    ,
Opportunity_Product__r.ER_Nb_Beneficiaries__c
)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Nb of Beneficiaries</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Opportunity_Product__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <label>Opportunity Product</label>
        <referenceTo>OpportunityLineItem</referenceTo>
        <relationshipLabel>Contract Line Items</relationshipLabel>
        <relationshipName>Contract_Line_Items</relationshipName>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Parent_Product__c</fullName>
        <externalId>false</externalId>
        <formula>Opportunity_Product__r.Parent_Product__c</formula>
        <label>Parent Product</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Product_Type__c</fullName>
        <externalId>false</externalId>
        <formula>IF(
    Solution_Group__c = &quot;Savings&quot;,
    IF(
        BEGINS(LOWER(Parent_Product__c), &quot;premium&quot;),
        &quot;Premium&quot;,
        IF(
            CONTAINS(LOWER(Parent_Product__c), &quot;freemium&quot;),
            &quot;Freemium&quot;,
            NULL
        )
    ),
    NULL
)</formula>
        <label>Product Type</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Solution_Group__c</fullName>
        <externalId>false</externalId>
        <formula>TEXT(ER_Product2__r.Solution_Group__c)</formula>
        <label>Solution Group</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Total_Price__c</fullName>
        <formula>Opportunity_Product__r.Total_Amount__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Total Amount</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <validationRules>
        <fullName>VRER01_BlockUpdate</fullName>
        <active>false</active>
        <description>Allow modification of creation date in OS only.</description>
        <errorConditionFormula>AND(
NOT($User.ER_BypassVR__c),
NOT(ISNEW()),
NOT( ISCHANGED(ER_Last_date_of_Sync__c ))
)</errorConditionFormula>
        <errorMessage>You cannot update this record.</errorMessage>
    </validationRules>
</CustomObject>
