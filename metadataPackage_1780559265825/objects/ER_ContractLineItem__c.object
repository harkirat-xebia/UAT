  ER_Product2__r.ER_Solution2__r.Days_per_Month__c ,
Opportunity_Product__r.ER_Days_Per_Month__c

)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
