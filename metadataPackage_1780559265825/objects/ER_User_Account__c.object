    <allowInChatterGroups>false</allowInChatterGroups>
    <compactLayoutAssignment>ER_User_Account_CL</compactLayoutAssignment>
    <deploymentStatus>Deployed</deploymentStatus>
    <description>This custom object will be used to store Smarter User Accounts</description>
    <enableActivities>true</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>true</enableHistory>
    <enableLicensing>false</enableLicensing>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <externalSharingModel>ControlledByParent</externalSharingModel>
    <label>User Account</label>
    <nameField>
        <displayFormat>UA-{000000000}</displayFormat>
        <label>Name</label>
        <trackHistory>false</trackHistory>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>User Account</pluralLabel>
    <searchLayouts></searchLayouts>
    <sharingModel>ControlledByParent</sharingModel>
    <visibility>Public</visibility>
    <compactLayouts>
        <fullName>ER_User_Account_CL</fullName>
        <fields>Name</fields>
        <fields>Status__c</fields>
        <fields>ER_User_Identity_Id__c</fields>
        <fields>EdenredPlus__c</fields>
        <fields>ER_BUPicklist__c</fields>
        <label>User Account CL</label>
    </compactLayouts>
    <fields>
        <fullName>EdenredPlus__c</fullName>
        <label>User Edenred +</label>
        <lookupFilter>
            <active>true</active>
            <filterItems>
                <field>Account.IsPersonAccount</field>
                <operation>equals</operation>
                <value>True</value>
            </filterItems>
            <filterItems>
                <field>Account.RecordTypeId</field>
                <operation>equals</operation>
                <value>Edenred+</value>
            </filterItems>
            <isOptional>false</isOptional>
        </lookupFilter>
        <referenceTo>Account</referenceTo>
        <relationshipLabel>User Account</relationshipLabel>
        <relationshipName>User_Account</relationshipName>
        <relationshipOrder>0</relationshipOrder>
        <reparentableMasterDetail>true</reparentableMasterDetail>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>MasterDetail</type>
        <writeRequiresMasterRead>true</writeRequiresMasterRead>
    </fields>
    <fields>
        <fullName>ER_BUPicklist__c</fullName>
        <externalId>false</externalId>
        <formula>TEXT(EdenredPlus__r.ER_BUPicklist__c)</formula>
        <label>Business Unit</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>ER_User_Identity_Id__c</fullName>
        <caseSensitive>true</caseSensitive>
        <description>This filed will host the backend user entity Id</description>
        <externalId>true</externalId>
        <label>User Identity Id</label>
        <length>255</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>true</unique>
    </fields>
    <fields>
        <fullName>Status__c</fullName>
        <label>Status</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>true</sorted>
                <value>
                    <fullName>Active</fullName>
                    <default>false</default>
                    <label>Active</label>
                </value>
                <value>
                    <fullName>Deleted</fullName>
                    <default>false</default>
                    <label>Deleted</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
</CustomObject>
