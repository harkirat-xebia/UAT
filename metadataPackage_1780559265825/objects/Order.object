    <validationRules>
        <fullName>VRER01_Order_Read_Only</fullName>
        <active>true</active>
        <description>This VR is used to prevent editing read only orders (Orders loaded by integration user)</description>
        <errorConditionFormula>NOT($User.ER_BypassVR__c)
&amp;&amp; $Setup.ER_Validation_Rules_Settings__c.VRER01_Order_Read_Only__c = False
&amp;&amp; NOT(ISNEW())
&amp;&amp; CreatedBy.Profile.Name = &apos;ER Integration&apos;</errorConditionFormula>
        <errorMessage>VRER01 - This record is a read only record</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRER02_Status_Cancelled_Error</fullName>
        <active>true</active>
        <errorConditionFormula>NOT($User.ER_BypassVR__c)
&amp;&amp; (ISPICKVAL(Status, &apos;Activated&apos;) &amp;&amp; (ISPICKVAL(PRIORVALUE(Status), &apos;Cancelled&apos;))
|| (ISPICKVAL(Status, &apos;Draft&apos;) &amp;&amp; (ISPICKVAL(PRIORVALUE(Status), &apos;Cancelled&apos;))))</errorConditionFormula>
        <errorMessage>VRER02 - The status cannot be changed once cancelled</errorMessage>
    </validationRules>
</CustomObject>
