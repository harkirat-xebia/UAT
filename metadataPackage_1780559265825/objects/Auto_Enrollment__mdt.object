        <fullName>Long_Value__c</fullName>
        <description>When Value field is not sufficient to store a long metadata</description>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Long Value</label>
        <length>32768</length>
        <type>LongTextArea</type>
        <visibleLines>3</visibleLines>
    </fields>
    <fields>
        <fullName>Picklist_Labels__c</fullName>
        <description>Picklist Labels (that are stored in the record) in csv format.
Please pay attention that the order must match the one in the Picklist values field in order to do the right translation.
Example:
if &quot;Picklist values&quot; is &quot;Purchasing Manager,Administrator,Assistant,Other&quot;,
then &quot;Picklist labels&quot; must be &quot;Acheteur,Administrateur,Assistant,Autre&quot; (in french)</description>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Picklist Labels</label>
        <length>1000</length>
        <type>LongTextArea</type>
        <visibleLines>2</visibleLines>
    </fields>
    <fields>
        <fullName>Picklist_Values__c</fullName>
        <description>Picklist values (that are stored in the record) in csv format.
Please pay attention that the order must match the one in the Picklist labels field in order to do the right translation.
Example:
if &quot;Picklist values&quot; is &quot;Purchasing Manager,Administrator,Assistant,Other&quot;,
then &quot;Picklist labels&quot; must be &quot;Acheteur,Administrateur,Assistant,Autre&quot; (in french)</description>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Picklist Values</label>
        <length>1000</length>
        <type>LongTextArea</type>
        <visibleLines>2</visibleLines>
    </fields>
