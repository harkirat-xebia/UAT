    <validationRules>
        <fullName>VRBE07_ContactMandatory</fullName>
        <active>true</active>
        <description>Contact should be mandatory for BENELUX</description>
        <errorConditionFormula>NOT($User.ER_BypassVR__c) &amp;&amp;
ER_Business_Unit__c =&apos;BENELUX&apos;&amp;&amp;
((NOT(ISBLANK(ER_Creation_Date_In_OS__c)) )
|| (NOT(ISBLANK( ER_Financial_Center__r.ER_Creation_date_in_OS__c ) ))) &amp;&amp; 
ISBLANK(ER_Contact__c)</errorConditionFormula>
        <errorDisplayField>ER_Contact__c</errorDisplayField>
        <errorMessage>Contact is mandatory</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRBE09_FranchiseTypeSubSegmentMandatory</fullName>
        <active>true</active>
        <description>Franchise type and Sub-segment should be mandatory for BENELUX</description>
        <errorConditionFormula>RecordType.DeveloperName = &quot;ER_Merchant_Store&quot; &amp;&amp;
            NOT($User.ER_BypassVR__c) &amp;&amp;
            NOT(ISCHANGED(TECH_StoreCreationViaLeadConversion__c))&amp;&amp;
            NOT(PRIORVALUE(TECH_StoreCreationViaLeadConversion__c) = True)&amp;&amp;
            TECH_StoreCreationViaLeadConversion__c = False &amp;&amp;
            ISPICKVAL(ER_BUPicklist__c,&apos;BENELUX&apos;) &amp;&amp;(ISBLANK(TEXT(ER_Franchise_type__c)) ||
            ISBLANK(TEXT(ERBE_Sub_Segment__c)))</errorConditionFormula>
        <errorMessage>Franchise type and Sub-segment are mandatory</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRER01_Store_When_EShopFalse_NeedAddress</fullName>
        <active>true</active>
        <description>The address information must be filled for stores that are not E-shops (E-shop=False)</description>
        <errorConditionFormula>AND( 
NOT($User.ER_BypassVR__c),
NOT(ER_E_Shop__c),
ISBLANK (ER_Street__c)
)</errorConditionFormula>
        <errorDisplayField>ER_Street__c</errorDisplayField>
        <errorMessage>The address information must be filled for stores that are not E-shops</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRER02_Store_When_EShopTrue_NeedWebsite</fullName>
        <active>true</active>
        <description>The website information must be filled for E-shops</description>
        <errorConditionFormula>AND( 
NOT($User.ER_BypassVR__c), 
ER_E_Shop__c=true,
ISBLANK(ER_Website_URL__c)
)</errorConditionFormula>
        <errorDisplayField>ER_Website_URL__c</errorDisplayField>
        <errorMessage>The website information must be filled for E-shops</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRER03_Store_When_AMTrue_NeedAName</fullName>
        <active>true</active>
        <description>When Association member is set to true, Association Name has to be filled</description>
        <errorConditionFormula>AND( 
NOT($User.ER_BypassVR__c), 
ER_Association_member__c,
ISBLANK(ER_Association_name__c)
)</errorConditionFormula>
        <errorDisplayField>ER_Association_name__c</errorDisplayField>
        <errorMessage>When Association member is set to true, Association Name has to be filled</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRER04_StoreOnlyMerchantFinancialCenter</fullName>
        <active>true</active>
        <description>Store can only be created on Merchant Financial Center</description>
        <errorConditionFormula>AND( 
NOT($User.ER_BypassVR__c),
TEXT(ER_Financial_Center__r.ER_Type__c) = &quot;Client&quot;
)</errorConditionFormula>
        <errorMessage>Store can only be created on Merchant Financial Center</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRER05_Store_Digital_Store_Status</fullName>
        <active>true</active>
        <errorConditionFormula>NOT($User.ER_BypassVR__c)
&amp;&amp; ER_Digital_Store__c = true
&amp;&amp;(
(TEXT(ER_Digital_Store_Status__c) = &apos;Created&apos;
&amp;&amp; CreatedById = &apos;&apos;
)
||
(
NOT(ISPICKVAL(PRIORVALUE(ER_Digital_Store_Status__c),&quot;Created&quot;))
&amp;&amp; NOT(ISPICKVAL(PRIORVALUE(ER_Digital_Store_Status__c),&quot;&quot;))
&amp;&amp; TEXT(ER_Digital_Store_Status__c) = &apos;Created&apos;
&amp;&amp; CreatedById != &apos;&apos;)
)</errorConditionFormula>
        <errorMessage>Created status cannot be selected manually.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRER05_Store_Mandatory_For_Closure</fullName>
        <active>true</active>
        <errorConditionFormula>AND(NOT($User.ER_BypassVR__c ),AND(ISPICKVAL(ER_Status__c, &apos;Inactive&apos;), OR(ISPICKVAL(ER_Closure_Reason__c,&apos;&apos;), ISBLANK(ER_Closure_Date__c))))</errorConditionFormula>
        <errorMessage>Closure Reason and Closure Date is mandatory when a Store is set as Inactive</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRER06_Check_Website_Format</fullName>
        <active>false</active>
        <description>This VR checks the website url format</description>
        <errorConditionFormula>ER_Business_Unit__c = &apos;BE&apos;  &amp;&amp; NOT($User.ER_BypassVR__c)
&amp;&amp; NOT(ISBLANK(ER_Website_URL__c))
&amp;&amp; NOT(REGEX(ER_Website_URL__c,&apos;^((https|http|ftp)://)?([A-Za-z0-9]\\.|[A-Za-z0-9][A-Za-z0-9-]{0,61}[A-Za-z0-9]\\.){1,3}[A-Za-z]{2,6}&apos;))</errorConditionFormula>
        <errorMessage>VRER06 - Invalid website url format.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRER06_FC_SAME_ACCOUNT</fullName>
        <active>true</active>
        <description>a Store can be linked only to the Financial Center related to its merchant.</description>
        <errorConditionFormula>AND(
				 NOT($User.ER_BypassVR__c),
				 NOT(ISBLANK(ER_Merchant__c)),
                 NOT(RecordType.DeveloperName = &apos;Store_Aggregator&apos;),
				 ER_Merchant__r.Id &lt;&gt; ER_Financial_Center__r.ER_Account_Name__c
)</errorConditionFormula>
        <errorMessage>A Store can be linked only to the Financial Center related to its merchant.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRER08_Block_Update_FinancialCenter_Sync</fullName>
        <active>true</active>
        <description>Prevent the update of field financial center when the store is synced</description>
        <errorConditionFormula>NOT($User.ER_BypassVR__c)
&amp;&amp; NOT(ISNEW())
&amp;&amp; ISCHANGED(ER_Financial_Center__c)
&amp;&amp; NOT(ISBLANK(ER_Creation_Date_In_OS__c))
&amp;&amp; NOT(ER_Business_Unit__c = &apos;BENELUX&apos;)</errorConditionFormula>
        <errorDisplayField>ER_Financial_Center__c</errorDisplayField>
        <errorMessage>VRER08 - The financial center cannot be modified when the store is synchronized</errorMessage>
    </validationRules>
</CustomObject>
