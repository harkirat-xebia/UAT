        <columns>ER_Contact__c</columns>
        <columns>ER_Type__c</columns>
        <columns>ER_Bank_Account__c</columns>
        <columns>ER_City__c</columns>
        <columns>ER_Country__c</columns>
        <filterScope>Everything</filterScope>
        <filters>
            <field>ER_Type__c</field>
            <operation>equals</operation>
            <value>Merchant</value>
        </filters>
        <label>Merchant Financial Centers</label>
    </listViews>
    <validationRules>
        <fullName>VRBE01_BankAccountMandatory</fullName>
        <active>true</active>
        <description>VRBE01 - The Bank Account is mandatory when the account is already synchronized</description>
        <errorConditionFormula>NOT($User.ER_BypassVR__c)
            &amp;&amp; ISPICKVAL(ER_BUPicklist__c ,&apos;BENELUX&apos;)
            &amp;&amp; NOT(ISNEW())
            &amp;&amp; ISBLANK(ER_Bank_Account__c)
            &amp;&amp; NOT(ISBLANK(ER_Account_Name__r.ER_Creation_date_in_OS__c ))</errorConditionFormula>
        <errorDisplayField>ER_Bank_Account__c</errorDisplayField>
        <errorMessage>VRBE01 - The Bank Account is mandatory when the account is already synchronized</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRER01_FinancialC_Mandatory_Fields</fullName>
        <active>true</active>
        <description>At least one of those fields need to be checked : Invoicing Site ? or &quot;Payment Site ?&quot;</description>
        <errorConditionFormula>AND( 
NOT($User.ER_BypassVR__c),
NOT(OR(ER_Invoicing_Site__c = true,  ER_Payment_Site__c = true))
)</errorConditionFormula>
        <errorMessage>At least one of those fields need to be checked : &quot;Invoicing Site ?&quot; or &quot;Payment Site ?&quot;</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRER02_FC_CANNOT_FINANCIAL_PAYMENT</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
NOT($User.ER_BypassVR__c),
ER_Business_Unit__c == &apos;ES&apos;,
ER_Invoicing_Site__c,
ER_Payment_Site__c
)</errorConditionFormula>
        <errorMessage>A Financial center cannot be defined as both Invoicing site and Payment site.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRER03_Invoicing_Site_Company_Reg_Check</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
NOT($User.ER_BypassVR__c),
ER_Business_Unit__c == &apos;ES&apos;,
ER_Invoicing_Site__c,
ISBLANK( ER_Account_Name__r.ER_Registration_Number__c)
)</errorConditionFormula>
        <errorMessage>Enter a valid Company Registration Number on the Account before selecting “Invoicing Site&quot;</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRER05_FC_Block_Type_Update</fullName>
        <active>true</active>
        <errorConditionFormula>NOT($User.ER_BypassVR__c)
            &amp;&amp; ISCHANGED(ER_Type__c)</errorConditionFormula>
        <errorDisplayField>ER_Type__c</errorDisplayField>
        <errorMessage>You can&apos;t update this field.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRER07_Block_Update_Account_Sync</fullName>
        <active>true</active>
        <description>VRER07 - Account cannot be modified when the financial center is synchronized</description>
        <errorConditionFormula>NOT($User.ER_BypassVR__c)
            &amp;&amp; NOT(ISNEW())
            &amp;&amp; ISCHANGED(ER_Account_Name__c )
            &amp;&amp; NOT(ISBLANK(ER_Creation_date_in_OS__c))</errorConditionFormula>
        <errorDisplayField>ER_Account_Name__c</errorDisplayField>
        <errorMessage>VRER07 - The account name cannot be modified when the store is synchronized</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRER08_Check_OVT_Fields_e_invoicing</fullName>
        <active>true</active>
        <description>VR for Finland to check if the OVT fields are filled in case of E-invoicing</description>
        <errorConditionFormula>NOT($User.ER_BypassVR__c)
            &amp;&amp; NOT( ER_SmartER_Context__c )
            &amp;&amp; ISPICKVAL(ER_BUPicklist__c ,&apos;FI&apos;)
            &amp;&amp; NOT( ISPICKVAL($User.UserType , &apos;AutomatedProcess&apos;))
            &amp;&amp; ISPICKVAL(ER_Preferred_Invoicing_Method__c , &apos;E-invoice&apos;)
            &amp;&amp; ER_SmartER_Original_Lead_Id__c == null
            &amp;&amp; (ERFI_OVT_Operator__c == null || ERFI_OVT_Code__c == null)</errorConditionFormula>
        <errorMessage>Both the fields OVT Code and OVT Operator have to be filled when the preferred method is e-invoicing.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRFI01_MandatoryFields</fullName>
        <active>true</active>
        <errorConditionFormula>NOT($User.ER_BypassVR__c)&amp;&amp;
ISPICKVAL(ER_BUPicklist__c ,&apos;FI&apos;)&amp;&amp;
ISPICKVAL(ER_Preferred_Invoicing_Method__c, &apos;&apos;)</errorConditionFormula>
        <errorDisplayField>ER_Preferred_Invoicing_Method__c</errorDisplayField>
        <errorMessage>VRFI01 - Preferred Invoicing Method is mandatory</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRFI02_PrefInvMandatory</fullName>
        <active>true</active>
        <description>VRFI02 - Preferred Invoicing Method mandatory when FC synchronized</description>
        <errorConditionFormula>NOT($User.ER_BypassVR__c)&amp;&amp;
    ISPICKVAL(ER_BUPicklist__c ,&apos;FI&apos;)&amp;&amp;
    NOT(ISNEW())&amp;&amp;
    ISPICKVAL(ER_Preferred_Invoicing_Method__c, &apos;&apos;)&amp;&amp;
    NOT(ISBLANK(ER_Account_Name__r.ER_Creation_date_in_OS__c ))</errorConditionFormula>
        <errorDisplayField>ER_Preferred_Invoicing_Method__c</errorDisplayField>
        <errorMessage>VRFI02 - Preferred Invoicing Method is mandatory when FC is synchronized</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRGR01_Block_Deletion_Invoicing_method</fullName>
        <active>true</active>
        <description>Block the deletion of invoicing method for the sync account</description>
        <errorConditionFormula>NOT($User.ER_BypassVR__c)
&amp;&amp; NOT(ISNEW())
&amp;&amp; ISPICKVAL(ER_BUPicklist__c, &quot;GR&quot;)
&amp;&amp; ISCHANGED(ER_Preferred_Invoicing_Method__c)
&amp;&amp; ISPICKVAL(ER_Preferred_Invoicing_Method__c ,&apos;&apos;)
&amp;&amp; NOT(ISBLANK(ER_Account_Name__r.ER_Creation_date_in_OS__c))</errorConditionFormula>
        <errorDisplayField>ER_Preferred_Invoicing_Method__c</errorDisplayField>
        <errorMessage>VRGR01 - The Preferred invoice method is mandatory for the Greek synchronized Financial Center</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRPL01_Check_Country_Code</fullName>
        <active>true</active>
        <description>The country code is a mandatory data for sync with SAXO and Zuora</description>
        <errorConditionFormula>NOT($User.ER_BypassVR__c)
&amp;&amp; ER_Business_Unit__c = &apos;PL&apos;
&amp;&amp; ISPICKVAL(ER_Country_Code__c, &apos;&apos;)</errorConditionFormula>
        <errorDisplayField>ER_Country_Code__c</errorDisplayField>
