        <columns>ER_Bank_Account__c</columns>
        <columns>ER_City__c</columns>
        <columns>CREATEDBY_USER</columns>
        <columns>CREATED_DATE</columns>
        <filterScope>Everything</filterScope>
        <label>All</label>
    </listViews>
    <listViews>
        <fullName>ERGR_Client_Financial_Center</fullName>
        <columns>NAME</columns>
        <columns>ER_Account_Name__c</columns>
        <columns>ER_Contact__c</columns>
        <columns>ER_Type__c</columns>
        <columns>ER_Bank_Account__c</columns>
        <columns>ER_City__c</columns>
        <columns>ER_Country__c</columns>
        <filterScope>Everything</filterScope>
        <filters>
            <field>ER_Type__c</field>
            <operation>equals</operation>
            <value>Client</value>
        </filters>
        <label>Client Financial Center</label>
    </listViews>
    <listViews>
        <fullName>ERGR_Merchant_Financial_Centers</fullName>
        <columns>NAME</columns>
