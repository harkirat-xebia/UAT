    <listViews>
        <fullName>All</fullName>
        <columns>NAME</columns>
        <columns>ER_User__c</columns>
        <columns>ER_Account__c</columns>
        <columns>ER_Status__c</columns>
        <columns>ER_Role__c</columns>
        <columns>ER_Priority__c</columns>
        <filterScope>Everything</filterScope>
        <label>All</label>
    </listViews>
    <validationRules>
        <fullName>VRGR01_ONLY_POSITIVE_NUMBER</fullName>
        <active>true</active>
        <description>Allow</description>
        <errorConditionFormula>AND( 
NOT(REGEX(TEXT(ER_Priority__c), &quot;^\\d+$&quot;)), 
NOT( ER_Priority__c =0))</errorConditionFormula>
        <errorMessage>Only positive numbers are allowed !</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRGR02_MANDATORY_FILEDS</fullName>
        <active>true</active>
        <description>COUL-4109 : Make fields mandatory : User, Priority, Role.</description>
        <errorConditionFormula>NOT($User.ER_BypassVR__c)
&amp;&amp; ISPICKVAL( ER_Account__r.ER_BUPicklist__c , &apos;GR&apos;)
&amp;&amp; (
      ISBLANK(ER_User__c)
    || ISBLANK(ER_Priority__c)
    || ISBLANK(TEXT(ER_Role__c))

)</errorConditionFormula>
        <errorMessage>User, priority and role fields are mandatory</errorMessage>
    </validationRules>
</CustomObject>
