        <externalId>false</externalId>
        <formula>IF(
BEGINS(ER_Solution__r.ProductCode, &quot;ERHU&quot;),  
IF(OR(BEGINS(ProductCode, &quot;SRV_PART&quot;),CONTAINS(ProductCode, &quot;Bonus&quot;)), &quot;Bonus_Card&quot;, &quot;Gift@Schooling Card Hungary&quot;) ,
ER_Solution2__r.ProductCode)</formula>
