    <validationRules>
        <fullName>VRER01_Check_Discount_Parent_Product</fullName>
        <active>true</active>
        <description>A discount product should always have a service or a range as parent product.</description>
        <errorConditionFormula>AND(
	NOT($User.ER_BypassVR__c),
	RecordType.Name= &apos;Discount&apos;, 
	OR((ER_Solution__r.RecordType.Name= &apos;Solution&apos;), 
	ER_Solution__r.RecordType.Name= &apos;Discount&apos;, 
		ISBLANK(ER_Solution__c))
)</errorConditionFormula>
        <errorDisplayField>ER_Solution__c</errorDisplayField>
        <errorMessage>VRER01 - Discount product can only have service or range as product object.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRER02_Change_ProductCode_Discount</fullName>
        <active>true</active>
        <description>The product of Discount Record type shall never have a product code different from its parent product (Service or Range)</description>
        <errorConditionFormula>NOT($User.ER_BypassVR__c)
&amp;&amp; NOT(ISNEW())
&amp;&amp; RecordType.DeveloperName= &apos;Discount&apos;
&amp;&amp; ProductCode != ER_Solution__r.ProductCode</errorConditionFormula>
        <errorDisplayField>ProductCode</errorDisplayField>
        <errorMessage>VRER02 - A Discount shall never have a product code different from its parent product (Service or Range)</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRER03_What_and_QOM_Mandatory</fullName>
        <active>true</active>
        <description>If Service Range Type = “Fix Range” or “Variable range volume pricing”, then the 2 fields “What” and “Quantity Unit of Measure” are mandatory.</description>
        <errorConditionFormula>AND(
    NOT($User.ER_BypassVR__c),
    OR(ISPICKVAL(ER_Service_Range_Type__c, &apos;Range with Fix Price&apos;),
							ISPICKVAL(ER_Service_Range_Type__c, &apos;Range with Variable price Volume pricing&apos;)),
				OR(ISBLANK(TEXT(ER_What__c)),
				ISBLANK(TEXT(QuantityUnitOfMeasure)))
)</errorConditionFormula>
        <errorMessage>VRER03 - If Service Range Type = “Fix Range” or “Variable range volume pricing”, then “What” and “Quantity Unit of Measure” are mandatory.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRER04_Cant_associate_Discount_And_Range</fullName>
        <active>true</active>
        <description>We cannot associate a discount and a ranges under the same service</description>
        <errorConditionFormula>NOT($User.ER_BypassVR__c)
&amp;&amp; (ISPICKVAL(ER_Type__c, &quot;Discount&quot;) || RecordType.Name = &apos;Discount&apos;)
&amp;&amp; ER_Solution__r.ER_Service_Number_of_Ranges__c &gt; 0</errorConditionFormula>
        <errorMessage>VRER04 - We detected that this service has some active ranges, the discount should be applied on ranges instead of the service</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRER05_Cant_Be_Applied_On_Variable_Range</fullName>
        <active>false</active>
        <description>A discount can&apos;t be applied on varaible ranges</description>
        <errorConditionFormula>NOT($User.ER_BypassVR__c)
&amp;&amp; (ISPICKVAL(ER_Type__c, &quot;Discount&quot;) || RecordType.Name = &apos;Discount&apos;)
&amp;&amp; ISPICKVAL(ER_Solution__r.ER_Solution__r.ER_Service_Range_Type__c, &apos;Range with Variable price Volume pricing&apos;)</errorConditionFormula>
        <errorMessage>VRER05 - A discount can be applied only on fix ranges</errorMessage>
    </validationRules>
    <webLinks>
        <fullName>zqu__Mark_for_Delete</fullName>
        <availability>online</availability>
        <displayType>button</displayType>
        <linkType>javascript</linkType>
        <masterLabel>Mark for Delete</masterLabel>
        <openType>onClickJavaScript</openType>
        <protected>false</protected>
        <url>{!REQUIRESCRIPT(&quot;/soap/ajax/33.0/connection.js&quot;)}
            {!REQUIRESCRIPT(&quot;/soap/ajax/33.0/apex.js&quot;)}

            var namespaceRecords=sforce.connection.query(&quot;SELECT Name, NamespacePrefix FROM ApexClass where Name = &apos;ProductListViewSyncController&apos;&quot;);
            var thisNamespace = namespaceRecords.records.NamespacePrefix;
            var newRecords = [];

            var p = new sforce.SObject(&quot;Product2&quot;);
            p.Id =&quot;{!Product2.Id}&quot;;
            if (thisNamespace != undefined &amp;&amp; thisNamespace != &apos;&apos;)
            p[thisNamespace + &apos;__Deleted__c&apos;]= true;
            else
            p[&apos;Deleted__c&apos;] = true;

            newRecords.push(p);
            var result = sforce.connection.update(newRecords);
            if (result[0].success == &apos;true&apos;)
                alert(&apos;Object successfully marked for deletion.&apos;);
            else
                alert(result);
            window.location.reload();</url>
    </webLinks>
    <webLinks>
        <fullName>zqu__sync_to_zuora</fullName>
        <availability>online</availability>
        <displayType>button</displayType>
        <encodingKey>UTF-8</encodingKey>
        <height>600</height>
        <linkType>url</linkType>
        <masterLabel>Sync to Zuora</masterLabel>
        <openType>sidebar</openType>
        <protected>false</protected>
        <url>/apex/zqu__ProductListViewSync?syncObjectId={!Product2.Id}&amp;stype=Product2</url>
    </webLinks>
    <webLinks>
        <fullName>zqu__validate</fullName>
        <availability>online</availability>
        <displayType>button</displayType>
        <encodingKey>UTF-8</encodingKey>
        <height>600</height>
        <linkType>url</linkType>
        <masterLabel>Validate</masterLabel>
        <openType>sidebar</openType>
        <protected>false</protected>
        <url>/apex/zqu__CatalogStatus?Id={!Product2.Id}</url>
    </webLinks>
</CustomObject>
