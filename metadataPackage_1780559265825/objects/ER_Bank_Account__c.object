    <validationRules>
        <fullName>VRBE01_FC_Mandatory</fullName>
        <active>true</active>
        <description>FC should be mandatory on Bank Account creation - for Benelux</description>
        <errorConditionFormula>NOT($User.ER_BypassVR__c)
&amp;&amp; TEXT($User.UserType) != &apos;AutomatedProcess&apos;
&amp;&amp; ER_Business_Unit__c = &apos;BENELUX&apos;
&amp;&amp; ISBLANK(ER_Financial_Center__c)</errorConditionFormula>
        <errorMessage>Financial Center is mandatory on Bank Account creation</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRER01_BankAccount_IBANFormat</fullName>
        <active>false</active>
        <errorConditionFormula>AND( 
NOT($User.ER_BypassVR__c),
NOT(REGEX(ER_IBAN__c, &quot;[A-Z]{2}[0-9]{2}[A-Z]{4}[0-9]{14}&quot;))
)</errorConditionFormula>
        <errorDisplayField>ER_IBAN__c</errorDisplayField>
        <errorMessage>IBAN Format is not correct</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRER02_BankAccount_Valid_IBAN_NR</fullName>
        <active>true</active>
        <description>Rule that enforces the merchant to fill in a valid iban nr.</description>
        <errorConditionFormula>AND(
NOT($User.ER_BypassVR__c),
OR(ER_Business_Unit__c =&apos;BENELUX&apos;,ER_Business_Unit__c =&apos;ES&apos;,ER_Business_Unit__c =&apos;PL&apos;),
            OR( 
