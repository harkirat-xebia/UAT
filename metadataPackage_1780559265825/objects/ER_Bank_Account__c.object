    <validationRules>
        <fullName>VRER03_Block_Financial_center_Sync</fullName>
        <active>true</active>
        <description>VRER03 - The financial center cannot be modified when the bank account is synchronized</description>
        <errorConditionFormula>NOT($User.ER_BypassVR__c)
&amp;&amp; NOT(ISNEW())
&amp;&amp; ISCHANGED(ER_Financial_Center__c)
&amp;&amp; NOT(ISBLANK(ER_Creation_date_in_OS__c))</errorConditionFormula>
        <errorMessage>VRER03 - The financial center cannot be modified when the bank account is synchronized</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRFI01_IBAN_Format</fullName>
        <active>true</active>
        <description>This validation rule ensure that the format of the IBAN iscorrectly captured by User, and follow the finnish format. This rule can be bypassed by a User by checking the field &apos;BypassVR&apos; on its account.</description>
        <errorConditionFormula>AND(
            NOT($User.ER_BypassVR__c),
            ISPICKVAL( ER_BUPicklist__c, &apos;FI&apos;),
            NOT(LEN(ER_IBAN__c) = 0),
            NOT(
            OR( 
            AND(LEN( ER_IBAN__c ) &lt;=  34,  NOT(BEGINS(ER_IBAN__c, &apos;FI&apos;) )) , 
            REGEX( ER_IBAN__c , &quot;FI[0-9]{16}&quot;) )
            )
            )</errorConditionFormula>
        <errorDisplayField>ER_IBAN__c</errorDisplayField>
        <errorMessage>The format of Finnish IBAN starts with ‘FI’ and is followed by 16 digits. If the bank account is not from Finland, the IBAN can contain max 34 alphanumeric characters</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRFI03_BIC_Format</fullName>
        <active>true</active>
        <description>This validation rule ensure that the format of the BIC is correctly captured by User, and follow the finnish format. This rule can be bypassed by a User by checking the field &apos;BypassVR&apos; on its account.</description>
        <errorConditionFormula>NOT($User.ER_BypassVR__c) &amp;&amp;
            ISPICKVAL( ER_BUPicklist__c, &apos;FI&apos;) &amp;&amp;
            NOT(LEN(ER_BIC__c) = 0) &amp;&amp;
            LEN(ER_BIC__c) &lt;&gt; 8 &amp;&amp; 
            LEN(ER_BIC__c) &lt;&gt; 11</errorConditionFormula>
        <errorDisplayField>ER_BIC__c</errorDisplayField>
        <errorMessage>The format of the BIC must be 8 or 11 characters long</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRGR01_Mandatory_Fields</fullName>
        <active>true</active>
        <description>Affi Accounting information required for Won</description>
        <errorConditionFormula>AND(ER_Business_Unit__c =&apos;GR&apos;,
            OR(ISBLANK(ER_IBAN__c),
            ISBLANK(ER_BIC__c),
            ISBLANK(ER_Bank_Account_Owner__c)))</errorConditionFormula>
        <errorMessage>VRGR01 - IBAN, Bank Account Owner, BIC are mandatory.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRGR02_BankAccount_Valid_IBAN_NR</fullName>
        <active>true</active>
        <description>To validate IBAN NR</description>
        <errorConditionFormula>AND(
            NOT($User.ER_BypassVR__c),
            ER_Business_Unit__c =&apos;GR&apos;,
            OR(
            LEN( ER_IBAN__c ) &lt;&gt; CASE(LEFT(SUBSTITUTE(ER_IBAN__c , &quot; &quot;,&quot;&quot;),2),&quot;AL&quot;,28,&quot;AD&quot;,24,&quot;AT&quot;,20,&quot;AZ&quot;,28,&quot;BE&quot;,16,&quot;BH&quot;,22,&quot;BA&quot;,20,&quot;BR&quot;,29,&quot;BG&quot;,22,&quot;CR&quot;,21,&quot;HR&quot;,21,&quot;CY&quot;,28,&quot;CZ&quot;,24,&quot;DK&quot;,18,&quot;DO&quot;,28,&quot;EE&quot;,20,&quot;FO&quot;,18,&quot;FI&quot;,18,&quot;FR&quot;,27,&quot;GE&quot;,22,&quot;DE&quot;,22,&quot;GI&quot;,23,&quot;GR&quot;,27,&quot;GL&quot;,18,&quot;GT&quot;,28,&quot;HU&quot;,28,&quot;I&quot;,26,&quot;IE&quot;,22,&quot;IL&quot;,23,&quot;IT&quot;,27,&quot;KZ&quot;,20,&quot;KW&quot;,30,&quot;LV&quot;,21,&quot;LB&quot;,28,&quot;LI&quot;,21,&quot;LT&quot;,20,&quot;LU&quot;,20,&quot;MK&quot;,19,&quot;MT&quot;,31,&quot;MR&quot;,27,&quot;MU&quot;,30,&quot;MC&quot;,27,&quot;MD&quot;,24,&quot;ME&quot;,22,&quot;NL&quot;,18,&quot;NO&quot;,15,&quot;PK&quot;,24,&quot;PS&quot;,29,&quot;PL&quot;,28,&quot;PT&quot;,25,&quot;RO&quot;,24,&quot;SM&quot;,27,&quot;SA&quot;,24,&quot;RS&quot;,22,&quot;SK&quot;,24,&quot;SI&quot;,19,&quot;ES&quot;,24,&quot;SE&quot;,24,&quot;CH&quot;,21,&quot;TN&quot;,24,&quot;TR&quot;,26,&quot;AE&quot;,23,&quot;GB&quot;,22,&quot;VG&quot;,24,8)
            ,
            NOT(
            OR(
            ISBLANK( ER_IBAN__c ),
            REGEX( ER_IBAN__c ,&quot;[A-Z,0-9]{1,}&quot;)
            )
            )
            ,
            MOD(
            VALUE(
            SUBSTITUTE((SUBSTITUTE((SUBSTITUTE((SUBSTITUTE((SUBSTITUTE((SUBSTITUTE((SUBSTITUTE((SUBSTITUTE((SUBSTITUTE((SUBSTITUTE((SUBSTITUTE((SUBSTITUTE((SUBSTITUTE((SUBSTITUTE((SUBSTITUTE((SUBSTITUTE((SUBSTITUTE((SUBSTITUTE((SUBSTITUTE((SUBSTITUTE((SUBSTITUTE((SUBSTITUTE((SUBSTITUTE((SUBSTITUTE((SUBSTITUTE((
            SUBSTITUTE(
            RPAD( MID( SUBSTITUTE(ER_IBAN__c, &quot; &quot;, &quot;&quot;),5,LEN(SUBSTITUTE(ER_IBAN__c, &quot; &quot;, &quot;&quot;)) ) ,LEN(SUBSTITUTE(ER_IBAN__c, &quot; &quot;, &quot;&quot;)), MID(SUBSTITUTE(ER_IBAN__c, &quot; &quot;, &quot;&quot;),1,4) ),&quot;A&quot;,&quot;10&quot;))
            ,&quot;B&quot;,&quot;11&quot;)),&quot;C&quot;,&quot;12&quot;)),&quot;D&quot;,&quot;13&quot;)),&quot;E&quot;,&quot;14&quot;)),&quot;F&quot;,&quot;15&quot;)),&quot;G&quot;,&quot;16&quot;)),&quot;H&quot;,&quot;17&quot;)),&quot;I&quot;,&quot;18&quot;)),&quot;J&quot;,&quot;19&quot;)),&quot;K&quot;,&quot;20&quot;)),&quot;L&quot;,&quot;21&quot;)),&quot;M&quot;,&quot;22&quot;)),&quot;N&quot;,&quot;23&quot;)),&quot;O&quot;,&quot;24&quot;)),&quot;P&quot;,&quot;25&quot;)),&quot;Q&quot;,&quot;26&quot;)),&quot;R&quot;,&quot;27&quot;)),&quot;S&quot;,&quot;28&quot;)),&quot;T&quot;,&quot;29&quot;)),&quot;U&quot;,&quot;30&quot;)),&quot;V&quot;,&quot;31&quot;)),&quot;W&quot;,&quot;32&quot;)),&quot;X&quot;,&quot;33&quot;)),&quot;Y&quot;,&quot;34&quot;)),&quot;Z&quot;,&quot;35&quot;))
            ,97)&lt;&gt;1, AND(
            NOT(ISBLANK(ER_IBAN__c)),
            OR(NOT(LEN(ER_IBAN__c)=27),
            NOT(BEGINS(ER_IBAN__c,&quot;GR&quot;)))
            )))</errorConditionFormula>
        <errorDisplayField>ER_IBAN__c</errorDisplayField>
        <errorMessage>VRGR02 - The IBAN format is not correct.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRHU06_IBAN_Hungarian_Format</fullName>
        <active>true</active>
        <description>This validation rule will control the IBAN format to ensure it fit Hungarian format, as following : 

00000000-00000000-00000000 (8 digits - dash separator - 8 digits - dash separator / 8 digits)</description>
        <errorConditionFormula>AND( 
NOT($User.ER_BypassVR__c),
ISPICKVAL(ER_BUPicklist__c, &apos;HU&apos;),  
NOT( 
OR( 
LEN( ER_IBAN__c ) = 0 , 
REGEX( ER_IBAN__c , &quot;[0-9]{8}-[0-9]{8}-[0-9]{8}&quot;)
)))</errorConditionFormula>
        <errorDisplayField>ER_IBAN__c</errorDisplayField>
        <errorMessage>The format of the IBAN must be equal to Hungarian format, as following : 

00000000-00000000-00000000 (8 digits / dash separator / 8 digits / dash separator / 8 digits)</errorMessage>
    </validationRules>
</CustomObject>
