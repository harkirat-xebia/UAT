    <validationRules>
        <fullName>Require_Promo_End_Date_or_Duration</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
NOT($User.ER_BypassVR__c), ISBLANK(Promo_End_Date__c),
ISBLANK(Promo_Duration_in_Days__c)
)</errorConditionFormula>
        <errorMessage>Either Promo End Date or Promo Duration in Days must be populated.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRER01_ParentAffiliation_Contract</fullName>
        <active>true</active>
        <description>TSK:14447 A code with the affiliation type &quot;parent&quot; can only be associated to a framework contract</description>
        <errorConditionFormula>NOT($User.ER_BypassVR__c)
&amp;&amp; $RecordType.DeveloperName = &apos;ER_Affiliation_Code&apos;
&amp;&amp; ER_Contract__r.ER_Contract_Type__c = &apos;Framework agreement&apos;
&amp;&amp; NOT(ISPICKVAL(ER_Affiliation_Type__c, &apos;Parent&apos;))</errorConditionFormula>
        <errorMessage>VRER01: A code with the affiliation type &quot;parent&quot; can only be associated to a framework contract.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRER02_Check_Non_Activated_Contract</fullName>
        <active>true</active>
        <description>TSK:14447 A non activated contract, cannot be associated to an affiliation code (regardless of the &quot;activation&quot; code status).</description>
        <errorConditionFormula>NOT($User.ER_BypassVR__c)
&amp;&amp; $RecordType.DeveloperName = &apos;ER_Affiliation_Code&apos;
&amp;&amp; NOT(ISPICKVAL(ER_Contract__r.Status, &apos;Activated&apos;))
&amp;&amp; NOT(ISCHANGED(ER_Status__c))</errorConditionFormula>
        <errorMessage>VRER02 - A non activated contract cannot be associated to an affiliation code.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRER03_Operational_Contact_Check</fullName>
        <active>true</active>
        <description>An &quot;operational&quot; contract cannot be associated to an affiliation code.</description>
        <errorConditionFormula>NOT($User.ER_BypassVR__c)
&amp;&amp; $RecordType.DeveloperName = &apos;ER_Affiliation_Code&apos;
&amp;&amp; ER_Contract__r.ER_Contract_Type__c = &apos;Operational&apos;</errorConditionFormula>
        <errorMessage>VRER03 - An operational contract cannot be associated to an affiliation code.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRER04_Status_Check</fullName>
        <active>true</active>
        <description>An affiliation code status cannot move from expired to activated, or activated to draft.</description>
        <errorConditionFormula>NOT($User.ER_BypassVR__c)
&amp;&amp; ISCHANGED(ER_Status__c)
&amp;&amp; $RecordType.DeveloperName = &apos;ER_Affiliation_Code&apos;
&amp;&amp; ( (ISPICKVAL(ER_Status__c,&apos;Activated&apos;) &amp;&amp; (ISPICKVAL(PRIORVALUE(ER_Status__c), &apos;Expired&apos;)))
				|| (ISPICKVAL(ER_Status__c, &apos;Draft&apos;) &amp;&amp; (ISPICKVAL(PRIORVALUE(ER_Status__c), &apos;Activated&apos;)))
			)</errorConditionFormula>
        <errorMessage>VRER04 - An affiliation code status cannot move from expired to activated, or activated to draft.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRER05_Cannot_Edit_Activated</fullName>
        <active>true</active>
        <description>Once activated, an affiliation code cannot be modified, edited and deleted.</description>
        <errorConditionFormula>NOT($User.ER_BypassVR__c)
&amp;&amp; $RecordType.DeveloperName = &apos;ER_Affiliation_Code&apos;
&amp;&amp; ISPICKVAL(ER_Status__c, &apos;Activated&apos;)
&amp;&amp; NOT(ISCHANGED(ER_Status__c))
&amp;&amp; NOT(ISNEW())</errorConditionFormula>
        <errorMessage>VRER05 - Once activated, an affiliation code cannot be modified, edited and deleted.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRER06_Affiliation_Type_Check</fullName>
        <active>true</active>
        <description>Affiliation code type &quot;Federation&quot; can only be linked to a referral contract type and reciprocally
Affiliation code type &quot;Franchisee&quot; can only be linked to a referral contract type and reciprocally</description>
        <errorConditionFormula>NOT($User.ER_BypassVR__c)
	&amp;&amp; $RecordType.DeveloperName = &apos;ER_Affiliation_Code&apos;
	&amp;&amp; ER_Contract__r.ER_Contract_Type__c = &apos;Referral agreement&apos;
	&amp;&amp; NOT((ISPICKVAL(ER_Affiliation_Type__c, &apos;Federation&apos;)) 
								|| (ISPICKVAL(ER_Affiliation_Type__c, &apos;Franchiser&apos;)))</errorConditionFormula>
        <errorMessage>VRER06 - Affiliation code type &quot;Federation&quot; and &quot;Franchiser&quot; can only be linked to a referral contract type and reciprocally</errorMessage>
    </validationRules>
</CustomObject>
