    <fields>
        <fullName>ER_Service_Reference__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <label>Service Reference</label>
        <lookupFilter>
            <active>true</active>
            <filterItems>
                <field>Product2.ER_Type__c</field>
                <operation>equals</operation>
                <value>Service</value>
            </filterItems>
            <filterItems>
                <field>Product2.IsActive</field>
                <operation>equals</operation>
                <value>True</value>
            </filterItems>
            <isOptional>false</isOptional>
        </lookupFilter>
        <referenceTo>Product2</referenceTo>
        <relationshipLabel>Bulk Contract Amendment</relationshipLabel>
        <relationshipName>Bulk_Contract_Amendment</relationshipName>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>ER_Tech_ContractId__c</fullName>
        <externalId>false</externalId>
        <inlineHelpText>Field used to store the contract Id for matching/duplicate rules use !</inlineHelpText>
        <label>Tech ContractId</label>
        <length>18</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>ER_Tech_Service_Reference__c</fullName>
        <externalId>false</externalId>
        <inlineHelpText>Field used to store the service id for matching/duplicate rules use !</inlineHelpText>
        <label>Tech Service Reference</label>
        <length>18</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>ER_Tech_Start_Date__c</fullName>
        <externalId>false</externalId>
        <inlineHelpText>Field used to copy the contract start date for a matching/duplicate rule use!</inlineHelpText>
        <label>Tech Date</label>
        <length>20</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>ER_Type__c</fullName>
        <label>Type</label>
        <required>true</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>UpdatePricing</fullName>
                    <default>false</default>
                    <label>UpdatePricing</label>
                </value>
                <value>
                    <fullName>UpdateT&amp;C</fullName>
                    <default>false</default>
                    <label>UpdateT&amp;C</label>
                </value>
                <value>
                    <fullName>Add Service</fullName>
                    <default>false</default>
                    <label>Add Service</label>
                </value>
                <value>
                    <fullName>Remove Service</fullName>
                    <default>false</default>
                    <label>Remove Service</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Error__c</fullName>
        <label>Error</label>
        <length>131072</length>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>LongTextArea</type>
        <visibleLines>3</visibleLines>
    </fields>
    <listViews>
        <fullName>All</fullName>
        <columns>NAME</columns>
        <columns>ER_BUPicklist__c</columns>
        <columns>ER_Contract__c</columns>
        <columns>ER_Type__c</columns>
        <columns>ER_Service_Reference__c</columns>
        <columns>ER_New_Price__c</columns>
        <columns>ER_Contract_Start_Date__c</columns>
        <filterScope>Everything</filterScope>
        <label>All</label>
    </listViews>
    <listViews>
        <fullName>All_failed_changes</fullName>
        <booleanFilter>(1 OR 2) AND 3</booleanFilter>
        <columns>ER_Contract__c</columns>
        <columns>ER_Type__c</columns>
        <columns>ER_Contract_Start_Date__c</columns>
        <columns>ER_Amended_Contract__c</columns>
        <columns>ER_Amended_Contract_status__c</columns>
        <columns>ER_Amended_Contract_Sync_Message__c</columns>
        <columns>Error__c</columns>
        <filterScope>Everything</filterScope>
        <filters>
            <field>ER_Amended_Contract__c</field>
            <operation>equals</operation>
        </filters>
        <filters>
            <field>ER_Amended_Contract_status__c</field>
            <operation>equals</operation>
            <value>Draft</value>
        </filters>
        <filters>
            <field>ER_Contract_Start_Date__c</field>
            <operation>lessOrEqual</operation>
            <value>TODAY</value>
        </filters>
        <label>All failed changes</label>
    </listViews>
    <listViews>
        <fullName>All_upcoming_changes</fullName>
        <columns>ER_Contract__c</columns>
        <columns>ER_Type__c</columns>
        <columns>ER_Contract_Start_Date__c</columns>
        <columns>ER_Service_Reference__c</columns>
        <columns>ER_New_Price__c</columns>
        <columns>ER_Payment_Term__c</columns>
        <columns>ER_Payment_Method__c</columns>
        <columns>ER_Invoicing_Frequency__c</columns>
        <filterScope>Mine</filterScope>
        <label>All upcoming changes</label>
    </listViews>
    <validationRules>
        <fullName>VRER01_Missing_Price</fullName>
        <active>true</active>
        <errorConditionFormula>NOT($User.ER_BypassVR__c)
&amp;&amp; ISBLANK(ER_New_Price__c)
&amp;&amp; (ISPICKVAL(ER_Type__c, &apos;UpdatePricing&apos;) 
				|| ISPICKVAL(ER_Type__c, &apos;Add Service&apos;))</errorConditionFormula>
        <errorMessage>The new price must be specified for the types : UpdatePricing and  Add Service.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRER02_Contract_Start_Date</fullName>
        <active>true</active>
        <errorConditionFormula>NOT($User.ER_BypassVR__c)
&amp;&amp; ER_Contract_Start_Date__c &lt;= TODAY()</errorConditionFormula>
        <errorMessage>You cannot schedule actions in the past, the contract start date must be superior to today&apos;s date.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRER03_ServiceMandatory</fullName>
        <active>true</active>
        <errorConditionFormula>NOT($User.ER_BypassVR__c)
&amp;&amp; ISBLANK(ER_Service_Reference__c )
&amp;&amp; (ISPICKVAL(ER_Type__c, &apos;UpdatePricing&apos;) 
				|| ISPICKVAL(ER_Type__c, &apos;Add Service&apos;) 
				|| ISPICKVAL(ER_Type__c, &apos;Remove Service&apos;))</errorConditionFormula>
        <errorMessage>Service Reference must be filled for the operation with the types : UpdatePricing, Add Service and Remove Service</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRER04_UncompatibleTypeWithFCUpdate</fullName>
        <active>true</active>
        <errorConditionFormula>NOT($User.ER_BypassVR__c)
&amp;&amp; !ISPICKVAL(ER_Type__c, &apos;UpdateT&amp;C&apos;)
&amp;&amp; (!ISBLANK(Text(ER_Payment_Method__c))
|| !ISBLANK(Text(ER_Invoicing_Frequency__c ))
|| !ISBLANK(Text(ER_Payment_Term__c )))</errorConditionFormula>
        <errorMessage>You cannot Update T&amp;C with the selected type for the operation.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRER05_CannotUpdateMultipleTC_At_Once</fullName>
        <active>true</active>
        <errorConditionFormula>NOT($User.ER_BypassVR__c)
&amp;&amp; ISPICKVAL(ER_Type__c, &apos;UpdateT&amp;C&apos;)
&amp;&amp; ( (!ISBLANK(Text(ER_Payment_Method__c)) &amp;&amp; !ISBLANK(Text(ER_Invoicing_Frequency__c )) ) 
|| (!ISBLANK(Text(ER_Invoicing_Frequency__c )) &amp;&amp; !ISBLANK(Text(ER_Payment_Term__c )) )
|| (!ISBLANK(Text(ER_Payment_Term__c )) &amp;&amp;  !ISBLANK(Text(ER_Payment_Method__c)) ))</errorConditionFormula>
        <errorMessage>You cannot Update two T&amp;C fields with the same operation, Please fill only 1 field at a time.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRER06_IncompatibleOperationWithUpdateTC</fullName>
        <active>true</active>
        <errorConditionFormula>NOT($User.ER_BypassVR__c)
&amp;&amp; ISPICKVAL(ER_Type__c, &apos;UpdateT&amp;C&apos;)
&amp;&amp; (!ISBLANK(ER_New_Price__c)
  || !ISBLANK(ER_Service_Reference__c))</errorConditionFormula>
        <errorMessage>You cannot fill the Service Reference or the New price with the UpdateT&amp;C type.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRER06_MissingInfo_UpdateTC</fullName>
        <active>true</active>
        <errorConditionFormula>NOT($User.ER_BypassVR__c)
&amp;&amp; ISPICKVAL(ER_Type__c, &apos;UpdateT&amp;C&apos;)
&amp;&amp; ISBLANK(Text(ER_Payment_Method__c)) 
&amp;&amp; ISBLANK(Text(ER_Payment_Term__c ))
&amp;&amp; ISBLANK(Text(ER_Payment_Method__c ))</errorConditionFormula>
        <errorMessage>Please Fill one of the following fields : &quot;New Invoicing Frequency&quot;, &quot;New Payment Method&quot; or &quot;New Payment Term&quot;</errorMessage>
    </validationRules>
</CustomObject>
