    <validationRules>
        <fullName>ASS_VR01_ONLY_COMPETITOR_ASSETS_ALLOWED</fullName>
        <active>true</active>
        <description>ALK - Only a competitor asset can be added to a competitor</description>
        <errorConditionFormula>NOT($User.ER_BypassVR__c)
&amp;&amp; RecordType.DeveloperName != &apos;ER_Competitor_solution&apos;
&amp;&amp; ER_Competitor__r.RecordType.DeveloperName = &apos;ER_Competitor&apos;</errorConditionFormula>
        <errorMessage>Only a competitor asset can be added to a competitor</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRER_Competitor_Asset</fullName>
        <active>true</active>
        <description>The IsCompetitor checkbox should be checked for Competitor assets only</description>
        <errorConditionFormula>NOT($User.ER_BypassVR__c)
&amp;&amp; ((RecordType.DeveloperName = &apos;ER_Competitor_solution&apos; &amp;&amp; IsCompetitorProduct = False)
				|| (RecordType.DeveloperName &lt;&gt; &apos;ER_Competitor_solution&apos; &amp;&amp; IsCompetitorProduct = true))</errorConditionFormula>
        <errorMessage>Competitor Solution shall be checked for competitor only.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VRER001_AssetlName_AccountLookup</fullName>
        <active>true</active>
        <description>User is not able to modify Business Account or Asset Number assigned to Asset.</description>
        <errorConditionFormula>NOT($User.ER_BypassVR__c)
            &amp;&amp; $Setup.ER_Validation_Rules_Settings__c.VRER001_AssetlName_AccountLookup__c = false
            &amp;&amp; (ISCHANGED(AccountId) || ISCHANGED(Name))</errorConditionFormula>
        <errorMessage>You are not able to modify</errorMessage>
    </validationRules>
</CustomObject>
