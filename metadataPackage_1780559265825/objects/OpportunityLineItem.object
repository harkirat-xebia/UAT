    <compactLayoutAssignment>Opportunity_Line_Items</compactLayoutAssignment>
    <enableFeeds>false</enableFeeds>
    <compactLayouts>
        <fullName>Opportunity_Line_Items</fullName>
        <fields>Name</fields>
        <fields>Solution__c</fields>
        <fields>ER_Estimated_Value__c</fields>
        <fields>Total_Amount__c</fields>
        <label>Opportunity Line Items</label>
    </compactLayouts>
    <fields>
        <fullName>Account_Type__c</fullName>
        <externalId>false</externalId>
        <formula>TEXT(Opportunity.Account.Account_Type__c)</formula>
        <label>Account Type</label>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Description</fullName>
        <complianceGroup>PII;GDPR</complianceGroup>
    </fields>
    <fields>
        <fullName>Discount</fullName>
    </fields>
    <fields>
        <fullName>ER_BUPicklist__c</fullName>
        <defaultValue>$User.ER_BUText__c</defaultValue>
        <label>Business Unit</label>
        <required>false</required>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetName>ER_Business_Unit</valueSetName>
        </valueSet>
    </fields>
    <fields>
        <fullName>ER_Card_Operational_System_ID__c</fullName>
        <externalId>false</externalId>
        <label>Card Operational System ID</label>
        <length>255</length>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>ER_Creation_date_in_OS__c</fullName>
        <label>Creation date in OS</label>
        <required>false</required>
        <type>DateTime</type>
    </fields>
    <fields>
        <fullName>ER_Cumulative_with_Promotions__c</fullName>
        <defaultValue>false</defaultValue>
        <label>Cumulative with Promotions</label>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>ER_Days_Per_Month__c</fullName>
        <complianceGroup>GDPR</complianceGroup>
        <externalId>false</externalId>
        <label>Days per Month</label>
        <precision>3</precision>
        <required>false</required>
        <scale>0</scale>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>ER_Duration__c</fullName>
        <externalId>false</externalId>
        <label>Duration (days)</label>
        <precision>4</precision>
        <required>false</required>
        <scale>0</scale>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>ER_Edenred_Margin_TUR__c</fullName>
        <label>Edenred Margin/TUR</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <type>Percent</type>
    </fields>
    <fields>
        <fullName>ER_Estimated_Value__c</fullName>
        <complianceGroup>GDPR</complianceGroup>
        <formula>IF(
    CONTAINS(LOWER(CreatedBy.Alias), &quot;guest&quot;),
    IF(
        Parent_Product__c = &quot;Order Fee&quot;,
        ER_Face_Value__c * ER_Nb_Beneficiaries__c * ER_Load_Per_Year__c * ER_Days_Per_Month__c,
        NULL
    ),
    ER_Face_Value__c * ER_Nb_Beneficiaries__c * ER_Load_Per_Year__c * ER_Days_Per_Month__c
)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Estimated Value</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>ER_Face_Value__c</fullName>
        <complianceGroup>GDPR</complianceGroup>
        <label>Face Value</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>ER_Free_To_Set_Margin__c</fullName>
        <defaultValue>false</defaultValue>
        <label>Free To Set Margin</label>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>ER_Line_Type__c</fullName>
        <label>Line Type</label>
        <required>false</required>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetName>ER_Line_Type</valueSetName>
        </valueSet>
    </fields>
    <fields>
        <fullName>ER_Load_Per_Year__c</fullName>
        <complianceGroup>GDPR</complianceGroup>
        <externalId>false</externalId>
        <label>Load per Year</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>ER_Max__c</fullName>
        <externalId>false</externalId>
        <label>Max</label>
        <precision>15</precision>
        <required>false</required>
        <scale>0</scale>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>ER_Min__c</fullName>
        <externalId>false</externalId>
        <label>Min</label>
        <precision>15</precision>
        <required>false</required>
        <scale>0</scale>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>ER_Minimum_Fee__c</fullName>
        <externalId>false</externalId>
        <label>Minimum Fee</label>
        <precision>18</precision>
        <required>false</required>
        <scale>8</scale>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>ER_MPV__c</fullName>
        <defaultValue>false</defaultValue>
        <label>MPV</label>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>ER_Nb_Beneficiaries__c</fullName>
        <complianceGroup>GDPR</complianceGroup>
        <externalId>false</externalId>
        <label>Nb Beneficiaries</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>ER_NeedApproval__c</fullName>
        <defaultValue>false</defaultValue>
        <label>Need Approval ?</label>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>ER_Offer_validity_end_date__c</fullName>
        <label>Validity end date</label>
        <required>false</required>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>ER_Percentage__c</fullName>
        <label>Percentage</label>
        <precision>11</precision>
        <required>false</required>
        <scale>6</scale>
        <type>Percent</type>
    </fields>
    <fields>
        <fullName>ER_Price_End_Date__c</fullName>
        <label>Price End Date</label>
        <required>false</required>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>ER_Price_Start_Date__c</fullName>
        <label>Price Start Date</label>
        <required>false</required>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>ER_Quantity_Unit_of_Measure__c</fullName>
        <externalId>false</externalId>
        <formula>IF(PricebookEntry.Product2.RecordType.Name = &apos;Range&apos;,
TEXT(PricebookEntry.Product2.ER_Solution__r.QuantityUnitOfMeasure),
TEXT(PricebookEntry.Product2.QuantityUnitOfMeasure)
)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Quantity Unit of Measure</label>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>ER_User_Margin__c</fullName>
        <label>User Margin</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <type>Percent</type>
    </fields>
    <fields>
        <fullName>ER_What__c</fullName>
        <label>What</label>
        <required>false</required>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Card</fullName>
                    <default>false</default>
                    <label>Card</label>
                </value>
                <value>
                    <fullName>Delivery</fullName>
                    <default>false</default>
                    <label>Delivery</label>
                </value>
                <value>
                    <fullName>Volume</fullName>
                    <default>false</default>
                    <label>Volume</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Facial_Value__c</fullName>
        <complianceGroup>GDPR</complianceGroup>
        <externalId>false</externalId>
        <label>Facial Value</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Has_Auto_Discount__c</fullName>
        <defaultValue>false</defaultValue>
        <label>Has Auto Discount</label>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Lead_Source__c</fullName>
        <externalId>false</externalId>
        <formula>TEXT( Opportunity.LeadSource )</formula>
        <label>Lead Source</label>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>ListPrice</fullName>
    </fields>
    <fields>
        <fullName>Name</fullName>
    </fields>
    <fields>
        <fullName>OpportunityId</fullName>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Parent_Product__c</fullName>
        <externalId>false</externalId>
        <formula>PricebookEntry.Product2.ER_Solution__r.Name</formula>
        <label>Parent Product</label>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Product2Id</fullName>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>ProductCode</fullName>
    </fields>
    <fields>
        <fullName>Quantity</fullName>
    </fields>
    <fields>
        <fullName>Reduction_Fee__c</fullName>
        <externalId>false</externalId>
        <label>Reduction Fee</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>ServiceDate</fullName>
    </fields>
    <fields>
        <fullName>Solution__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <label>Solution</label>
        <referenceTo>Product2</referenceTo>
        <relationshipLabel>Opportunity Product</relationshipLabel>
        <relationshipName>Opportunity_Product</relationshipName>
        <required>false</required>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Subtotal</fullName>
        <complianceGroup>GDPR</complianceGroup>
    </fields>
    <fields>
        <fullName>Total_Amount__c</fullName>
        <label>Total Amount</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>TotalPrice</fullName>
    </fields>
    <fields>
        <fullName>UnitPrice</fullName>
    </fields>
    <validationRules>
        <fullName>Validate_Quantity_For_Savings_PerUnit</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
            ISPICKVAL(Product2.Solution_Group__c, &quot;Savings&quot;),
            ISPICKVAL(Product2.QuantityUnitOfMeasure, &quot;Per Unit&quot;),
            OR(
                ISBLANK(Quantity),
                Quantity = 0
            )
        )</errorConditionFormula>
        <errorMessage>For Savings products with Per Unit measure, Quantity cannot be 0 or blank. Please populate the Number of Beneficiaries.</errorMessage>
    </validationRules>
</CustomObject>
