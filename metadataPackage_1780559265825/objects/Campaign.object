    <fields>
        <fullName>purecloud__Adjusted_End_Date_Time__c</fullName>
        <deprecated>false</deprecated>
        <description>An end date and time of a campaign in user&apos;s local timezone adjusted based on the end date in the selected timezone.</description>
        <label>Adjusted End Date Time</label>
        <required>false</required>
        <type>DateTime</type>
    </fields>
    <fields>
        <fullName>purecloud__Adjusted_Start_Date_Time__c</fullName>
        <deprecated>false</deprecated>
        <description>A start date and time of a campaign in user&apos;s local timezone adjusted based on the start date in the selected timezone.</description>
        <label>Adjusted Start Date Time</label>
        <required>false</required>
        <type>DateTime</type>
    </fields>
    <fields>
        <fullName>purecloud__Failed_Attempts_to_Reconcile_Results__c</fullName>
        <defaultValue>0</defaultValue>
        <deprecated>false</deprecated>
        <externalId>false</externalId>
        <label>Failed Attempts to Reconcile Results</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>purecloud__PureCloud_Campaign_ID__c</fullName>
        <deprecated>false</deprecated>
        <externalId>false</externalId>
        <label>Genesys Cloud Campaign ID</label>
        <length>255</length>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>purecloud__PureCloud_Campaign_Priority__c</fullName>
        <deprecated>false</deprecated>
        <label>Genesys Cloud Campaign Priority</label>
        <required>false</required>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>5</fullName>
                    <default>true</default>
                    <label>5</label>
                </value>
                <value>
                    <fullName>4</fullName>
                    <default>false</default>
                    <label>4</label>
                </value>
                <value>
                    <fullName>3</fullName>
                    <default>false</default>
                    <label>3</label>
                </value>
                <value>
                    <fullName>2</fullName>
                    <default>false</default>
                    <label>2</label>
                </value>
                <value>
                    <fullName>1</fullName>
                    <default>false</default>
                    <label>1</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>purecloud__PureCloud_Campaign_Schedule__c</fullName>
        <deleteConstraint>Restrict</deleteConstraint>
        <deprecated>false</deprecated>
        <label>Genesys Cloud Campaign Schedule</label>
        <referenceTo>purecloud__PureCloud_Campaign_Schedule__c</referenceTo>
        <relationshipLabel>Campaigns</relationshipLabel>
        <relationshipName>Campaigns</relationshipName>
        <required>false</required>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>purecloud__PureCloud_Campaign_Setting__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <deprecated>false</deprecated>
        <label>Genesys Cloud Campaign Setting</label>
        <referenceTo>purecloud__PureCloud_Campaign_Setting__c</referenceTo>
        <relationshipLabel>Campaigns</relationshipLabel>
        <relationshipName>Campaigns</relationshipName>
        <required>false</required>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>purecloud__PureCloud_Campaign_Status__c</fullName>
        <deprecated>false</deprecated>
        <externalId>false</externalId>
        <formula>IF(ISBLANK(purecloud__PureCloud_Campaign_Setting__c), &quot;&quot;, IF(purecloud__Adjusted_End_Date_Time__c &lt; Now(), &quot;Not Running&quot;, IF(purecloud__Adjusted_Start_Date_Time__c &gt; Now(), &quot;Scheduled&quot;, &quot;Running&quot;)))</formula>
        <label>Genesys Cloud Campaign Status</label>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>purecloud__PureCloud_Contact_List_ID__c</fullName>
        <deprecated>false</deprecated>
        <externalId>false</externalId>
        <label>Genesys Cloud Contact List ID</label>
        <length>255</length>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>purecloud__Reconciled_Contact_Results__c</fullName>
        <defaultValue>false</defaultValue>
        <deprecated>false</deprecated>
        <label>Reconciled Contact Results</label>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>purecloud__Time_Zone__c</fullName>
        <deprecated>false</deprecated>
        <label>Time Zone</label>
        <required>false</required>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetName>purecloud__Time_Zones</valueSetName>
        </valueSet>
    </fields>
    <fields>
        <fullName>StartDate</fullName>
    </fields>
    <fields>
        <fullName>Status</fullName>
        <type>Picklist</type>
    </fields>
    <fields>
        <fullName>Type</fullName>
        <type>Picklist</type>
    </fields>
    <listViews>
        <fullName>AllActiveCampaigns</fullName>
        <columns>CAMPAIGN.NAME</columns>
        <columns>CAMPAIGN.START_DATE</columns>
        <columns>CAMPAIGN.END_DATE</columns>
        <columns>CAMPAIGN.CAMPAIGN_TYPE</columns>
        <columns>CAMPAIGN.STATUS</columns>
        <columns>CORE.USERS.FIRST_NAME</columns>
        <columns>CORE.USERS.LAST_NAME</columns>
        <filterScope>Everything</filterScope>
        <filters>
            <field>CAMPAIGN.ACTIVE</field>
            <operation>equals</operation>
            <value>1</value>
        </filters>
        <label>All Active Campaigns</label>
    </listViews>
    <listViews>
        <fullName>MyActiveCampaigns</fullName>
        <columns>CAMPAIGN.NAME</columns>
        <columns>CAMPAIGN.START_DATE</columns>
        <columns>CAMPAIGN.END_DATE</columns>
        <columns>CAMPAIGN.CAMPAIGN_TYPE</columns>
        <columns>CAMPAIGN.STATUS</columns>
        <filterScope>Mine</filterScope>
        <filters>
            <field>CAMPAIGN.ACTIVE</field>
            <operation>equals</operation>
            <value>1</value>
        </filters>
        <label>My Active Campaigns</label>
    </listViews>
    <listViews>
        <fullName>Org_Campaign_Hierarchy</fullName>
        <columns>CAMPAIGN.NAME</columns>
        <columns>CAMPAIGN.CAMPAIGN_TYPE</columns>
        <columns>CAMPAIGN.ACTIVE</columns>
        <columns>CAMPAIGN.STATUS</columns>
        <columns>CAMPAIGN.START_DATE</columns>
        <columns>CAMPAIGN.END_DATE</columns>
        <filterScope>Everything</filterScope>
        <label>Org_Campaign_Hierarchy</label>
    </listViews>
    <listViews>
        <fullName>purecloud__PureCloud_Campaigns_Ended_Yesterday</fullName>
        <columns>CAMPAIGN.NAME</columns>
        <columns>CAMPAIGN.START_DATE</columns>
        <columns>CAMPAIGN.END_DATE</columns>
        <columns>CAMPAIGN.BUDGETED_COST</columns>
        <columns>CAMPAIGN.ACTUAL_COST</columns>
        <columns>CAMPAIGN.CAMPAIGN_TYPE</columns>
        <columns>CAMPAIGN.STATUS</columns>
        <columns>purecloud__PureCloud_Campaign_Status__c</columns>
        <columns>purecloud__PureCloud_Campaign_Setting__c</columns>
        <filterScope>Everything</filterScope>
        <filters>
            <field>purecloud__Adjusted_End_Date_Time__c</field>
            <operation>equals</operation>
            <value>YESTERDAY</value>
        </filters>
        <filters>
            <field>purecloud__PureCloud_Campaign_Setting__c</field>
            <operation>notEqual</operation>
            <value>null</value>
        </filters>
        <label>Genesys Cloud Campaigns Ended Yesterday</label>
    </listViews>
    <listViews>
        <fullName>purecloud__PureCloud_Campaigns_Ending_Today</fullName>
        <columns>CAMPAIGN.NAME</columns>
        <columns>CAMPAIGN.START_DATE</columns>
        <columns>CAMPAIGN.END_DATE</columns>
        <columns>CAMPAIGN.BUDGETED_COST</columns>
        <columns>CAMPAIGN.ACTUAL_COST</columns>
        <columns>CAMPAIGN.CAMPAIGN_TYPE</columns>
        <columns>CAMPAIGN.STATUS</columns>
        <columns>purecloud__PureCloud_Campaign_Status__c</columns>
        <columns>purecloud__PureCloud_Campaign_Setting__c</columns>
        <filterScope>Everything</filterScope>
        <filters>
            <field>purecloud__Adjusted_End_Date_Time__c</field>
            <operation>equals</operation>
            <value>TODAY</value>
        </filters>
        <filters>
            <field>purecloud__PureCloud_Campaign_Setting__c</field>
            <operation>notEqual</operation>
            <value>null</value>
        </filters>
        <label>Genesys Cloud Campaigns Ending Today</label>
    </listViews>
    <listViews>
        <fullName>purecloud__PureCloud_Campaigns_Running</fullName>
        <columns>CAMPAIGN.NAME</columns>
        <columns>CAMPAIGN.START_DATE</columns>
        <columns>CAMPAIGN.END_DATE</columns>
        <columns>CAMPAIGN.BUDGETED_COST</columns>
        <columns>CAMPAIGN.ACTUAL_COST</columns>
        <columns>CAMPAIGN.CAMPAIGN_TYPE</columns>
        <columns>CAMPAIGN.STATUS</columns>
        <columns>purecloud__PureCloud_Campaign_Status__c</columns>
        <columns>purecloud__PureCloud_Campaign_Setting__c</columns>
        <filterScope>Everything</filterScope>
        <filters>
            <field>purecloud__PureCloud_Campaign_Status__c</field>
            <operation>equals</operation>
            <value>Running</value>
        </filters>
        <filters>
            <field>purecloud__PureCloud_Campaign_Setting__c</field>
            <operation>notEqual</operation>
            <value>null</value>
        </filters>
        <label>Genesys Cloud Campaigns Running</label>
    </listViews>
    <validationRules>
        <fullName>purecloud__PC_EndDate_Required</fullName>
        <active>true</active>
        <description>An end date is required for PureCloud Campaigns</description>
        <errorConditionFormula>AND(NOT(ISBLANK(purecloud__PureCloud_Campaign_Setting__c)), ISBLANK(EndDate))</errorConditionFormula>
        <errorDisplayField>EndDate</errorDisplayField>
        <errorMessage>An end date is required for PureCloud Campaigns</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>purecloud__PC_StartDate_Required</fullName>
        <active>true</active>
        <description>A start date is required for PureCloud Campaigns</description>
        <errorConditionFormula>AND(NOT(ISBLANK(purecloud__PureCloud_Campaign_Setting__c)), ISBLANK(StartDate))</errorConditionFormula>
        <errorDisplayField>StartDate</errorDisplayField>
        <errorMessage>A start date is required for PureCloud Campaigns. Select today&apos;s date to start a PureCloud campaign immediately.</errorMessage>
    </validationRules>
