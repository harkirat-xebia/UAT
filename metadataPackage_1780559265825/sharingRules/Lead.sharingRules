    <sharingCriteriaRules>
        <fullName>Marketing_Automation_Lead_Sharing_Rule</fullName>
        <accessLevel>Edit</accessLevel>
        <label>Marketing Automation Lead Sharing Rule</label>
        <sharedTo>
            <group>Marketing_Automation_Integration_Group</group>
        </sharedTo>
        <criteriaItems>
            <field>LastName</field>
            <operation>notEqual</operation>
            <value></value>
        </criteriaItems>
        <includeRecordsOwnedByAll>true</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
