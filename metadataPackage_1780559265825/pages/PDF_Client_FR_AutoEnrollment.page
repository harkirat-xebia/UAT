<apex:page controller="PDF_Contract_Controller"
    renderAs="pdf"
    applyBodyTag="false"
    showHeader="false"
    standardStylesheets="false"
    cache="true"
    language="FR">
<!-- Wrapper (inline styles only) -->
<div style="font-family:Arial, Helvetica, sans-serif; font-size:11px; color:#000;">

  <!-- Title (no <h1>) -->
   <div style="display: flex; align-items: center; justify-content: space-between; width: 100%;">
    <div style="flex: 0 0 auto;">
      <a href="http://www.edenred.be">
        <apex:image url="{!URLFOR($Resource.EdenredLogo)}" width="100" alt="Edenred"/>
      </a>
    </div>
    
    <div style="flex: 1; text-align: center; font-size:16px; font-weight:bold;">
      CONTRAT DE VENTE - {!IF(businessUnit = 'BE', 'Belgique', 'Luxembourg')}
    </div>
  </div>

  <!-- ======================= 1. BETWEEN ======================= -->
  <div style="font-weight:bold; color:#C00000; font-size:14px; margin:8px 0 4px 0;">1.&nbsp;&nbsp;ENTRE</div>

  <table cellpadding="0" cellspacing="0" style="width:100%; border-collapse:collapse;">
    <tr>
      <td style="border:0.5pt solid #000; padding:4px 5px; width:22%; font-weight:bold;">Les “ Parties ”</td>
      <td style="border:0.5pt solid #000; padding:4px 5px; width:39%; font-weight:bold;">{!IF(businessUnit = 'BE', 'Edenred Belgique SA', 'Edenred Luxembourg S.A.')}</td>
      <td style="border:0.5pt solid #000; padding:4px 5px; width:39%; font-weight:bold; ">
        <apex:outputText value="{!accName}"/>
      </td>
    </tr>
    <tr>
      <td style="border:0.5pt solid #000; padding:4px 5px;">Siège social</td>
      <td style="border:0.5pt solid #000; padding:4px 5px;">{!IF(businessUnit = 'BE', 'Boulevard du Souverain 165 b9 - 1160 BRUXELLES', '6D, Route de Trèves- L-2633 SENNINGERBERG')}</td>
      <td style="border:0.5pt solid #000; padding:4px 5px; ">
        <apex:outputText value="{!billingStreet}"/><apex:outputText value="{!IF(NOT(ISBLANK(billingStreet)), ', ', '')}"/><apex:outputText value="{!billingPostalCode}"/> <apex:outputText value="{!billingCity}"/>
      </td>
    </tr>
    <tr>
      <td style="border:0.5pt solid #000; padding:4px 5px;">Numéro TVA</td>
      <td style="border:0.5pt solid #000; padding:4px 5px;">{!IF(businessUnit = 'BE', "BE 0407 034 269", 'LU15477706')}</td>
      <td style="border:0.5pt solid #000; padding:4px 5px; ">
        <apex:outputText value="{!vatNumber}"/>
      </td>
    </tr>
    <tr>
      <td style="border:0.5pt solid #000; padding:4px 5px;">{!IF(businessUnit = 'BE', "Numéro d'entreprise", 'Numéro Matricule')}</td>
      <td style="border:0.5pt solid #000; padding:4px 5px;">{!IF(businessUnit = 'BE', "1992 2212 549", 'B42434')}</td>
      <td style="border:0.5pt solid #000; padding:4px 5px; ">
        <apex:outputText value="{!enterpriseNumber}"/>
      </td>
    </tr>
    <tr>
      <td style="border:0.5pt solid #000; padding:4px 5px;"> Représentée par </td>
      <td style="border:0.5pt solid #000; padding:4px 5px;">Bart Verbeeck, Directeur Sales BeLux</td>
      <td style="border:0.5pt solid #000; padding:4px 5px; ">
        <span style="font-size:10px;"><apex:outputText value="{!main_fullName}"/></span><br/>
      </td>
    </tr>
    <tr>
      <td style="border:0.5pt solid #000; padding:4px 5px; text-align:center; font-style:italic;">&nbsp;</td>
      <td style="border:0.5pt solid #000; padding:4px 5px; text-align:center; font-style:italic;">« Edenred » ou « Partie »</td>
      <td style="border:0.5pt solid #000; padding:4px 5px; text-align:center; font-style:italic;">« Client » ou « Partie »</td>
    </tr>
  </table>

  <!-- ======================= 2. SERVICES & PRICE ======================= -->
  <div style="font-weight:bold; color:#C00000; font-size:14px; margin:12px 0 4px 0;">2.&nbsp;&nbsp;SERVICES &amp; PRIX</div>

  <!-- Layout A: merged left labels, delivery tiers under Card, place of delivery within same block -->
  <table cellpadding="0" cellspacing="0" style="width:100%; border-collapse:collapse;">
    <tr>
      <td rowspan="5" style="border:0.5pt solid #000; padding:4px 5px; width:16%; text-align:center; vertical-align:middle; font-weight:bold;">
        Carte Edenred
      </td>

      <!-- Price card + replacement in same row -->
      <td style="border:0.5pt solid #000; padding:4px 5px; width:21%; font-weight:bold;">Prix d’achat de la carte : </td>
      <td style="border:0.5pt solid #000; padding:4px 5px; width:21%;">
        <apex:outputText value="{!cardCost}"/> €/ carte
      </td>
      <td style="border:0.5pt solid #000; padding:4px 5px; width:21%; font-weight:bold;">Prix de la carte de remplacement :</td>
      <td style="border:0.5pt solid #000; padding:4px 5px; width:21%; ">
        <apex:outputText value="{!cardReplacement}"/> €/ carte
      </td>
    </tr>

    <apex:outputPanel layout="none" rendered="{!NOT(ISBLANK(deliveries))}">
      <tr>
        <td rowspan="4" style="border:0.5pt solid #000; padding:4px 5px; vertical-align:top; font-weight:bold;">Frais de livraison :</td>

        <!-- First row of repeat -->
        <apex:repeat value="{!deliveries}" var="d" first="0" rows="1">
          <td style="border:0.5pt solid #000; padding:4px 5px;">
            <apex:outputText value="{!d.Name}"/>
          </td>
          <td colspan="2" style="border:0.5pt solid #000; padding:4px 5px;">
            <apex:outputText value="{!d.Price}"/> €/
            <apex:outputText value="{!IF(NOT(ISBLANK(d.CardLoadingCost)), d.CardLoadingCost, 'livraison')}"/>
          </td>
        </apex:repeat>
      </tr>
      <apex:repeat value="{!deliveries}" var="d" first="1">
            <tr>
              <td style="border:0.5pt solid #000; padding:4px 5px;">
                <apex:outputText value="{!d.Name}"/>
              </td>
              <td colspan="2" style="border:0.5pt solid #000; padding:4px 5px;">
                <apex:outputText value="{!d.Price}"/> €/
                <apex:outputText value="{!IF(NOT(ISBLANK(d.CardLoadingCost)), d.CardLoadingCost, 'livraison')}"/>
              </td>
            </tr>
        </apex:repeat>
    </apex:outputPanel>


    <!-- ===== Fallback (3 static rows) if deliveries is null or empty ===== -->
    <apex:outputPanel layout="none" rendered="{!deliveries == null || deliveries.size == 0}">
      <tr>
        <td rowspan="3" style="border:0.5pt solid #000; padding:4px 5px; vertical-align:top; font-weight:bold;">Frais de livraison : </td>
        <td style="border:0.5pt solid #000; padding:4px 5px;">1 à 3 cartes ( par courrier postal )</td>
        <td colspan="2" style="border:0.5pt solid #000; padding:4px 5px;">€/ carte</td>
      </tr>
      <tr>
        <td style="border:0.5pt solid #000; padding:4px 5px;">3 à 15 cartes ( par courrier postal )</td>
        <td colspan="2" style="border:0.5pt solid #000; padding:4px 5px;">€/ livraison</td>
      </tr>
      <tr>
        <td style="border:0.5pt solid #000; padding:4px 5px;">+ de 15 cartes ( par coursier )</td>
        <td colspan="2" style="border:0.5pt solid #000; padding:4px 5px;">€/ livraison</td>
      </tr>
    </apex:outputPanel>

    <!-- ===== Place of delivery row ===== -->
    <tr>
      <td style="border:0.5pt solid #000; padding:4px 5px; font-weight:bold;">Endroit de livraison :</td>
      <td colspan="3" style="border:0.5pt solid #000; padding:4px 5px;">
        <apex:outputText value="{!shippingStreet}"/>, 
        <apex:outputText value="{!shippingPostalCode}"/>,  
        <apex:outputText value="{!shippingCity}"/>
      </td>
    </tr>

    <!-- Edenred Meal -->
    <apex:outputPanel layout="none" rendered="{!rates != null && rates.size != 0}">
      <apex:repeat value="{!rates}" var="r">
        <tr>
          <td rowspan="2" style="border:0.5pt solid #000; padding:4px 5px; text-align:center; vertical-align:middle; font-weight:bold;"><apex:outputText value="{!r.SolutionName}"/></td>
          <td style="border:0.5pt solid #000; padding:4px 5px;font-weight:bold;">Nombre d’Utilisateurs :</td>
          <td style="border:0.5pt solid #000; padding:4px 5px; "><apex:outputText value="{!r.NbOfBenef}"/></td>
          <td style="border:0.5pt solid #000; padding:4px 5px;font-weight:bold;">Valeur nominale :</td>
          <td style="border:0.5pt solid #000; padding:4px 5px; "><apex:outputText value="{!r.FaceValue}"/></td>
        </tr>
        <tr>
          <td style="border:0.5pt solid #000; padding:4px 5px;font-weight:bold;">Frais de service :</td>
          <td colspan="3" style="border:0.5pt solid #000; padding:4px 5px;"><span style="">&nbsp;<apex:outputText value="{!IF( NOT(ISBLANK(r.Percentage)),r.Percentage & ' %',r.Price & ' €')}"/>&nbsp;</span> de la valeur nominale de la commande</td>
        </tr>
      </apex:repeat>
    </apex:outputPanel>
  </table>

  <apex:outputPanel layout="none" rendered="{!promoCode != 'Standard'}">
    <div style="margin-top:6px;page-break-inside: avoid;">
      <div><span style="font-weight:bold;">Code promotionnel: </span><span style=""><apex:outputText value="{!promoCode}"/></span></div>
      <div><span style="font-weight:bold;">Conditions Générales de l’offre:</span><span style=""><apex:outputText value="{!promoDescription}"/></span></div>
    </div>
  </apex:outputPanel>

  <!-- ======================= 3. CUSTOMER INFORMATION ======================= -->
  <div style="font-weight:bold; color:#C00000; font-size:14px; margin:12px 0 4px 0;">3.&nbsp;&nbsp;INFORMATIONS CLIENT</div>

  <table cellpadding="0" cellspacing="0" style="width:100%; border-collapse:collapse;page-break-inside: avoid;">
    <tr>
      <td style="border:0.5pt solid #000; padding:4px 5px;font-weight:bold;">{!IF(businessUnit = 'BE', "Numéro d'entreprise", 'Numéro Matricule')}</td>
      <td colspan="2" style="border:0.5pt solid #000; padding:4px 5px;"><apex:outputText value="{!enterpriseNumber}"/></td>
      <td style="border:0.5pt solid #000; padding:4px 5px;font-weight:bold;">Dénomination Sociale</td>
      <td style="border:0.5pt solid #000; padding:4px 5px;"><apex:outputText value="{!accName}"/></td>
    </tr>
    <tr>
      <td style="border:0.5pt solid #000; padding:4px 5px;font-weight:bold;">Forme juridique</td>
      <td style="border:0.5pt solid #000; padding:4px 5px;"><apex:outputText value="{!legalForm}"/></td>
      <td style="border:0.5pt solid #000; padding:4px 5px;font-weight:bold;">Assujetti à la TVA: &nbsp;&nbsp;
        <apex:image url="{!URLFOR($Resource.CheckBoxCheched)}"
        rendered="{!isSubjectToVAT}" width="15" height="15"/>

        <apex:image url="{!URLFOR($Resource.CheckBoxUnCheched)}"
        rendered="{!NOT(isSubjectToVAT)}" width="15" height="15"/>
      </td>
      <td style="border:0.5pt solid #000; padding:4px 5px;font-weight:bold;">Groupe</td>
      <td style="border:0.5pt solid #000; padding:4px 5px;"><apex:outputText value="{!relName}"/></td>
    </tr>
    <tr>
      <td style="border:0.5pt solid #000; padding:4px 5px;font-weight:bold;">Siège social</td>
      <td colspan="4" style="border:0.5pt solid #000; padding:4px 5px;">
        <apex:outputText value="{!billingStreet}"/>
      </td>
    </tr>
    <tr><td style="border:0.5pt solid #000; padding:4px 5px;font-weight:bold;">Code postal</td><td colspan="4" style="border:0.5pt solid #000; padding:4px 5px;"><apex:outputText value="{!billingPostalCode}"/></td></tr>
    <tr><td style="border:0.5pt solid #000; padding:4px 5px;font-weight:bold;">Localité</td><td colspan="4" style="border:0.5pt solid #000; padding:4px 5px;"><apex:outputText value="{!billingCity}"/></td></tr>
    <tr><td style="border:0.5pt solid #000; padding:4px 5px;font-weight:bold;">Pays</td><td colspan="4" style="border:0.5pt solid #000; padding:4px 5px;"><apex:outputText value="{!billingCountry}"/></td></tr>
  </table>

  <table cellpadding="0" cellspacing="0" style="width:100%; border-collapse:collapse; margin:12px 0 0 0;">
    <tr>
      <td style="border:0.5pt solid #000; padding:4px 5px;font-weight:bold;">Votre secrétariat social se charge-t-il de vos commandes de Edenred Repas?</td>
      <td style="border:0.5pt solid #000; padding:4px 5px;">
        Oui&nbsp;
        <apex:image url="{!URLFOR($Resource.CheckBoxCheched)}"
          rendered="{!socialSecretaryOrders='Yes'}"
          width="15px" height="15px"/>

        <apex:image url="{!URLFOR($Resource.CheckBoxUnCheched)}"
          rendered="{!socialSecretaryOrders!='Yes'}"
          width="15px" height="15px"/>
      </td>

      <td style="border:0.5pt solid #000; padding:4px 5px;">
        Non&nbsp;
        <apex:image url="{!URLFOR($Resource.CheckBoxCheched)}"
          rendered="{!socialSecretaryOrders='No'}"
          width="15px" height="15px"/>

        <apex:image url="{!URLFOR($Resource.CheckBoxUnCheched)}"
          rendered="{!socialSecretaryOrders!='No'}"
          width="15px" height="15px"/>
      </td>
    </tr>
    <tr>
      <td style="border:0.5pt solid #000; padding:4px 5px;font-weight:bold;">Nombre total de travailleurs</td>
      <td colspan="2" style="border:0.5pt solid #000; padding:4px 5px;"><apex:outputText value="{!numberEmployees}"/></td>
    </tr>
  </table>

  <!-- ======================= 4–7. CONTACTS ======================= -->

  <!-- 4 -->
  <div style="font-weight:bold; color:#C00000; font-size:14px; margin:12px 0 4px 0;">4.&nbsp;&nbsp;RESPONSABLE DES RELATIONS - Primary contact</div>
  <table cellpadding="0" cellspacing="0" style="width:100%; border-collapse:collapse;page-break-inside: avoid;">
    <tr>
      <td style="border:0.5pt solid #000; padding:4px 5px; width:12%;font-weight:bold;">Civilité</td>
      <td style="border:0.5pt solid #000; padding:4px 5px; width:16%; "><apex:outputText value="{!main_salutation}"/></td>
      <td style="border:0.5pt solid #000; padding:4px 5px; width:12%;font-weight:bold;">Nom</td>
      <td colspan="2" style="border:0.5pt solid #000; padding:4px 5px; width:24%; "><apex:outputText value="{!main_lastName}"/></td>
      <td style="border:0.5pt solid #000; padding:4px 5px; width:12%;font-weight:bold;">Prénom</td>
      <td style="border:0.5pt solid #000; padding:4px 5px; width:24%; "><apex:outputText value="{!main_firstName}"/></td>
    </tr>
    <tr>
      <td style="border:0.5pt solid #000; padding:4px 5px;font-weight:bold;">Téléphone</td>
      <td colspan="3" style="border:0.5pt solid #000; padding:4px 5px; "><apex:outputText value="{!main_phone}"/></td>
      <td style="border:0.5pt solid #000; padding:4px 5px;font-weight:bold;">GSM</td>
      <td colspan="2" style="border:0.5pt solid #000; padding:4px 5px; "><apex:outputText value="{!main_mobilePhone}"/></td>
    </tr>
    <tr>
      <td style="border:0.5pt solid #000; padding:4px 5px;font-weight:bold;">E-mail</td>
      <td colspan="3" style="border:0.5pt solid #000; padding:4px 5px; "><apex:outputText value="{!main_email}"/></td>
      <td colspan="2" style="border:0.5pt solid #000; padding:4px 5px;font-weight:bold;">Langue</td>
      <td style="border:0.5pt solid #000; padding:4px 5px; "><apex:outputText value="{!main_language}"/></td>
    </tr>
  </table>

  <!-- 5 -->
  <div style="font-weight:bold; color:#C00000; font-size:14px; margin:12px 0 4px 0;">5.&nbsp;&nbsp;RESPONSABLE DE LA FACTURATION</div>
  <table cellpadding="0" cellspacing="0" style="width:100%; border-collapse:collapse;page-break-inside: avoid;">
    <tr>
      <td style="border:0.5pt solid #000; padding:4px 5px; width:12%;font-weight:bold;">Civilité</td>
      <td style="border:0.5pt solid #000; padding:4px 5px; width:16%; "><apex:outputText value="{!invoice_salutation}"/></td>
      <td style="border:0.5pt solid #000; padding:4px 5px; width:12%;font-weight:bold;">Nom</td>
      <td colspan="2" style="border:0.5pt solid #000; padding:4px 5px; width:24%; "><apex:outputText value="{!invoice_lastName}"/></td>
      <td style="border:0.5pt solid #000; padding:4px 5px; width:12%;font-weight:bold;">Prénom</td>
      <td style="border:0.5pt solid #000; padding:4px 5px; width:24%; "><apex:outputText value="{!invoice_firstName}"/></td>
    </tr>
    <tr>
      <td style="border:0.5pt solid #000; padding:4px 5px;font-weight:bold;">Téléphone</td>
      <td colspan="3" style="border:0.5pt solid #000; padding:4px 5px; "><apex:outputText value="{!invoice_phone}"/></td>
      <td style="border:0.5pt solid #000; padding:4px 5px;font-weight:bold;">GSM</td>
      <td colspan="2" style="border:0.5pt solid #000; padding:4px 5px; "><apex:outputText value="{!invoice_mobilePhone}"/></td>
    </tr>
    <tr>
      <td style="border:0.5pt solid #000; padding:4px 5px;font-weight:bold;">E-mail</td>
      <td colspan="3" style="border:0.5pt solid #000; padding:4px 5px; "><apex:outputText value="{!invoice_email}"/></td>
      <td colspan="2" style="border:0.5pt solid #000; padding:4px 5px;font-weight:bold;">Langue</td>
      <td style="border:0.5pt solid #000; padding:4px 5px; "><apex:outputText value="{!main_language}"/></td>
    </tr>
  </table>

  <!-- 6 -->
  <div style="font-weight:bold; color:#C00000; font-size:14px; margin:12px 0 4px 0;">6.&nbsp;&nbsp;RESPONSABLE DES COMMANDES</div>
  <table cellpadding="0" cellspacing="0" style="width:100%; border-collapse:collapse;page-break-inside: avoid;">
    <tr>
      <td style="border:0.5pt solid #000; padding:4px 5px; width:12%;font-weight:bold;">Civilité</td>
      <td style="border:0.5pt solid #000; padding:4px 5px; width:16%; "><apex:outputText value="{!order_salutation}"/></td>
      <td style="border:0.5pt solid #000; padding:4px 5px; width:12%;font-weight:bold;">Nom</td>
      <td colspan="2" style="border:0.5pt solid #000; padding:4px 5px; width:24%; "><apex:outputText value="{!order_lastName}"/></td>
      <td style="border:0.5pt solid #000; padding:4px 5px; width:12%;font-weight:bold;">Prénom</td>
      <td style="border:0.5pt solid #000; padding:4px 5px; width:24%; "><apex:outputText value="{!order_firstName}"/></td>
    </tr>
    <tr>
      <td style="border:0.5pt solid #000; padding:4px 5px;font-weight:bold;">Téléphone</td>
      <td colspan="3" style="border:0.5pt solid #000; padding:4px 5px; "><apex:outputText value="{!order_phone}"/></td>
      <td style="border:0.5pt solid #000; padding:4px 5px;font-weight:bold;">GSM</td>
      <td colspan="2" style="border:0.5pt solid #000; padding:4px 5px; "><apex:outputText value="{!order_mobilePhone}"/></td>
    </tr>
    <tr>
      <td style="border:0.5pt solid #000; padding:4px 5px;font-weight:bold;">E-mail</td>
      <td colspan="3" style="border:0.5pt solid #000; padding:4px 5px; "><apex:outputText value="{!order_email}"/></td>
      <td colspan="2" style="border:0.5pt solid #000; padding:4px 5px;font-weight:bold;">Langue</td>
      <td style="border:0.5pt solid #000; padding:4px 5px; "><apex:outputText value="{!order_language}"/></td>
    </tr>
  </table>

  <!-- 7 -->
   <div style="page-break-inside: avoid;">
    <div style="font-weight:bold; color:#C00000; font-size:14px; margin:12px 0 4px 0;">7.&nbsp;&nbsp;RESPONSABLE DE LA RECEPTION DES LIVRAISONS DES CARTES</div>
    <table cellpadding="0" cellspacing="0" style="width:100%; border-collapse:collapse;page-break-inside: avoid;">
        <tr>
        <td style="border:0.5pt solid #000; padding:4px 5px; width:12%;font-weight:bold;">Civilité</td>
        <td style="border:0.5pt solid #000; padding:4px 5px; width:16%; "><apex:outputText value="{!delivery_salutation}"/></td>
        <td style="border:0.5pt solid #000; padding:4px 5px; width:12%;font-weight:bold;">Nom</td>
        <td colspan="2" style="border:0.5pt solid #000; padding:4px 5px; width:24%; "><apex:outputText value="{!delivery_lastName}"/></td>
        <td style="border:0.5pt solid #000; padding:4px 5px; width:12%;font-weight:bold;">Prénom</td>
        <td style="border:0.5pt solid #000; padding:4px 5px; width:24%; "><apex:outputText value="{!delivery_firstName}"/></td>
        </tr>
        <tr>
        <td style="border:0.5pt solid #000; padding:4px 5px;font-weight:bold;">Téléphone</td>
        <td colspan="3" style="border:0.5pt solid #000; padding:4px 5px; "><apex:outputText value="{!delivery_phone}"/></td>
        <td style="border:0.5pt solid #000; padding:4px 5px;font-weight:bold;">GSM</td>
        <td colspan="2" style="border:0.5pt solid #000; padding:4px 5px; "><apex:outputText value="{!delivery_mobilePhone}"/></td>
        </tr>
        <tr>
        <td style="border:0.5pt solid #000; padding:4px 5px;font-weight:bold;">E-mail</td>
        <td colspan="3" style="border:0.5pt solid #000; padding:4px 5px; "><apex:outputText value="{!delivery_email}"/></td>
        <td colspan="2" style="border:0.5pt solid #000; padding:4px 5px;font-weight:bold;">Langue</td>
        <td style="border:0.5pt solid #000; padding:4px 5px; "><apex:outputText value="{!delivery_language}"/></td>
        </tr>
        <tr>
        <td style="border:0.5pt solid #000; padding:4px 5px;font-weight:bold;">Adresse</td>
        <td colspan="7" style="border:0.5pt solid #000; padding:4px 5px; "><apex:outputText value="{!shippingStreet}"/>, <apex:outputText value="{!shippingPostalCode}"/>, <apex:outputText value="{!shippingCity}"/></td>
        </tr>
        <tr>
        <td style="border:0.5pt solid #000; padding:4px 5px;font-weight:bold;">Commune</td>
        <td colspan="3" style="border:0.5pt solid #000; padding:4px 5px; "><apex:outputText value="{!shippingCity}"/></td>
        <td colspan="2" style="border:0.5pt solid #000; padding:4px 5px;font-weight:bold;">Code Postal</td>
        <td style="border:0.5pt solid #000; padding:4px 5px; "><apex:outputText value="{!shippingPostalCode}"/></td>
        </tr>
    </table>
   </div>

  <!-- ======================= 8. FINANCIAL & DURATION ======================= -->
  <div style="font-weight:bold; color:#C00000; font-size:14px; margin:12px 0 4px 0;">8.&nbsp;&nbsp;CONDITIONS FINANCIERES &amp; DUREE DU CONTRAT</div>
  <table cellpadding="0" cellspacing="0" style="width:100%; border-collapse:collapse;page-break-inside: avoid;">
    <tr><td style="border:0.5pt solid #000; padding:4px 5px; width:40%;font-weight:bold;">Date de prise d'effet</td><td style="border:0.5pt solid #000; padding:4px 5px;"><apex:outputText value="{!contractstartDate}"/></td></tr>
    <tr><td style="border:0.5pt solid #000; padding:4px 5px; width:40%;font-weight:bold;">Durée du contrat </td><td style="border:0.5pt solid #000; padding:4px 5px;">2 ans (standard)</td></tr>
    <tr><td style="border:0.5pt solid #000; padding:4px 5px;font-weight:bold;">Conditions de paiement</td><td style="border:0.5pt solid #000; padding:4px 5px;">Paiement anticipé</td></tr>
  </table>

  <!-- ======================= 9. ATTACHMENTS ======================= -->
  <div style="font-weight:bold; color:#C00000; font-size:14px; margin:12px 0 4px 0;">9.&nbsp;&nbsp;ANNEXES 1</div>
  <table cellpadding="0" cellspacing="0" style="width:100%; border-collapse:collapse;">
    <tr>
      <td style="border:0.5pt solid #000; padding:4px 5px; font-weight:bold;">Appendix 1</td>
      <td style="border:0.5pt solid #000; padding:4px 5px;">Conditions Générales</td>
    </tr> 
  </table>

  <!-- ======================= 10. SIGNATURE ======================= -->
  <div style="font-weight:bold; color:#C00000; font-size:14px; margin:12px 0 4px 0;">10.&nbsp;&nbsp;SIGNATURE</div>

  <div style="padding:3px 5px;">Fait et signé par</div>
  <table cellpadding="0" cellspacing="0" style="width:100%; border-collapse:collapse;page-break-inside: avoid;">
    <tr>
      <td style="border:0.5pt solid #000; font-weight:bold; padding:8px 5px;">Pour Edenred</td>
      <td style="border:0.5pt solid #000; font-weight:bold; padding:8px 5px;">Pour le Client</td>
    </tr>
    <tr>
      <td style="border:0.5pt solid #000; padding:8px 5px; vertical-align:top;">
        <div style="margin-bottom:4px;"><span style="font-weight:bold;">Nom: </span> Bart Verbeeck</div>
        <div style="margin-bottom:8px;"><span style="font-weight:bold;">Titre:</span> Directeur des ventes Edenred</div>
      </td>
      <td style="border:0.5pt solid #000; padding:8px 5px; vertical-align:top;">
        <div style="margin-bottom:4px;"><span style="font-weight:bold;">Nom: </span><apex:outputText value="{!main_fullName}"/></div>
        <div style="margin-bottom:8px;"><span style="font-weight:bold;">Titre: </span><apex:outputText value="{!main_businessRole}"/></div>
      </td>
    </tr>
  </table>

  <div style="margin-top:8px; text-align:right; ">
    Le présent contrat a été contracté sur la plateforme le
    &nbsp;<apex:outputText value="{!dateAcceptedGeneralConditions}"/> à
    &nbsp;<apex:outputText value="{!timeAcceptedGeneralConditions}"/>.
  </div>

</div>
<apex:outputPanel>
    <div style="page-break-before:always;"></div>
    <apex:outputText value="{!appendixHtml}" escape="false"/>
</apex:outputPanel>
</apex:page>